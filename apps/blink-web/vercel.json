{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm --filter @beaconu/types build && pnpm --filter @beaconu/utils build && pnpm --filter @beaconu/validation build && pnpm --filter @beaconu/blink-web build",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/beaconu

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-jwt-secret-must-be-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-must-be-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Meet (counselling sessions) — service account with access to a
# shared calendar. Auto-generates Meet links for online sessions.
GOOGLE_MEET_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_MEET_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_MEET_CALENDAR_ID=your-shared-calendar-id@group.calendar.google.com

# Razorpay
RAZORPAY_KEY_ID=your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=beaconu-uploads
AWS_REGION=ap-south-1

# App
PORT=4000
NODE_ENV=development

# ─── Student referral deep links (Phase 4) ───────────────────────────────────
# Base for share links built by buildAppReferralUrl (falls back to WEB_URL).
# Must be the SAME host that serves /.well-known/assetlinks.json and
# /.well-known/apple-app-site-association, or App/Universal Links won't verify.
APP_SHARE_URL=https://beaconu.com
WEB_URL=https://beaconu.com

# Android App Links — Play Console > Setup > App integrity > App signing.
# Include BOTH the Play App Signing and upload certificate fingerprints
# (comma-separated), or links break for some installs.
ANDROID_PACKAGE_NAME=com.beaconu.app
ANDROID_SHA256_FINGERPRINTS=AA:BB:CC:...,DD:EE:FF:...

# iOS Universal Links — Apple Developer > Membership (Team ID) + app bundle id.
IOS_TEAM_ID=ABCDE12345
IOS_BUNDLE_ID=com.beaconu.app

# Store links for the /r/<code> web fallback page (apps/web). Server-side only,
# so NOT NEXT_PUBLIC_ — that would inline them at build time and force a
# rebuild to change a URL.
# App Store id comes from App Store Connect > App Information > Apple ID.
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.beaconu.app
APP_STORE_URL=https://apps.apple.com/app/id0000000000

# Reversible encryption for student bank account numbers (super admin must read
# them back to make manual payouts). AES-256-GCM; 32 bytes as 64 hex chars.
# Generate with: openssl rand -hex 32
# Rotating this makes existing stored account numbers undecryptable.
ENCRYPTION_KEY=

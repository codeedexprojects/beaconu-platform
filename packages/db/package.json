{
  "name": "@beaconu/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },

  "files": ["dist", "generated", "prisma"],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist generated",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "generate": "prisma generate --schema=./prisma/schema",
    "migrate": "prisma migrate deploy --schema=./prisma/schema",
    "migrate:dev": "prisma migrate dev --schema=./prisma/schema",
    "seed": "tsx src/seed.ts",
    "studio": "prisma studio --schema=./prisma/schema",
    "push": "prisma db push --schema=./prisma/schema"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^16.5.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.14",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}

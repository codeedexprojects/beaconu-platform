// ============================================================
// MODULE 2 — INSTITUTIONAL HIERARCHY
// ============================================================

model UniversityType {
  id        String   @id @default(dbgenerated("('UVT-'::text || (nextval('university_type_seq'::regclass))::text)"))
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  universities University[]

  @@map("university_types")
}

model University {
  id                String   @id @default(dbgenerated("('UNV-'::text || (nextval('university_seq'::regclass))::text)"))
  universityTypeId  String   @map("university_type_id")
  name              String   @db.VarChar(255)
  slug              String   @unique @db.VarChar(100)
  state             String?  @db.VarChar(100)
  city              String?  @db.VarChar(100)
  accreditation     String?  @db.VarChar(255)
  governanceDetails String?  @map("governance_details") @db.Text
  logoUrl           String?  @map("logo_url") @db.Text
  status            String   @default("active") @db.VarChar(20)
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  universityType UniversityType @relation(fields: [universityTypeId], references: [id])
  colleges       College[]

  @@index([universityTypeId], name: "idx_universities_type")
  @@index([state], name: "idx_universities_state")
  @@index([status], name: "idx_universities_status")
  @@index([slug], name: "idx_universities_slug")
  @@map("universities")
}

model InstitutionGroup {
  id                 String   @id @default(dbgenerated("('ING-'::text || (nextval('institution_group_seq'::regclass))::text)"))
  name               String   @db.VarChar(255)
  slug               String   @unique @db.VarChar(100)
  description        String?  @db.Text
  logoUrl            String?  @map("logo_url") @db.Text
  groupCode          String   @unique @map("group_code") @db.VarChar(30)
  createdByCollegeId String   @map("created_by_college_id")
  createdByStaffId   String?  @map("created_by_staff_id")
  status             String   @default("active") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  createdByCollege College                  @relation(fields: [createdByCollegeId], references: [id])
  createdByStaff   StaffMember?             @relation(fields: [createdByStaffId], references: [id])
  members          InstitutionGroupMember[]

  @@index([slug], name: "idx_ig_slug")
  @@index([groupCode], name: "idx_ig_group_code")
  @@index([status], name: "idx_ig_status")
  @@index([createdByCollegeId], name: "idx_ig_created_by_college")
  @@map("institution_groups")
}

model InstitutionGroupMember {
  id        String   @id @default(dbgenerated("('IGM-'::text || (nextval('institution_group_member_seq'::regclass))::text)"))
  groupId   String   @map("group_id")
  collegeId String   @unique @map("college_id")
  role      String   @default("member") @db.VarChar(20)
  joinedVia String   @default("code") @map("joined_via") @db.VarChar(20)
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz

  // Relations
  group   InstitutionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  college College          @relation(fields: [collegeId], references: [id])

  @@index([groupId], name: "idx_igm_group")
  @@index([collegeId], name: "idx_igm_college")
  @@index([role], name: "idx_igm_role")
  @@map("institution_group_members")
}

model College {
  id              String   @id @default(dbgenerated("('CLG-'::text || (nextval('college_seq'::regclass))::text)"))
  universityId    String   @map("university_id")
  name            String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(100)
  code            String   @unique @db.VarChar(20)
  domain          String?  @db.VarChar(255)
  logoUrl         String?  @map("logo_url") @db.Text
  coverImageUrl   String?  @map("cover_image_url") @db.Text
  state           String?  @db.VarChar(100)
  city            String?  @db.VarChar(100)
  district        String?  @db.VarChar(100)
  address         String?  @db.Text
  pinCode         String?  @map("pin_code") @db.VarChar(10)
  status          String   @default("active") @db.VarChar(20)
  requestedGroupCode String? @map("requested_group_code") @db.VarChar(30)
  profileSections Json     @default("{}") @map("profile_sections")
  settings        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  university                University                 @relation(fields: [universityId], references: [id])
  campuses                  Campus[]
  courses                   Course[]
  gallery                   CollegeGallery[]
  reviews                   CollegeReview[]
  collegeRoles              CollegeRole[]
  staffMembers              StaffMember[]
  blinkUsers                BlinkUser[]
  admissionCycles           AdmissionCycle[]
  applications              Application[]
  enrollments               Enrollment[]
  assessmentSections        AssessmentSection[]
  assessmentTemplates       AssessmentTemplate[]
  assessmentSlots           AssessmentSlot[]
  questionTypes             QuestionType[]
  questions                 Question[]
  interviewSlots            InterviewSlot[]
  offerLetters              OfferLetter[]
  feeStructures             FeeStructure[]
  studentFeeLedger          StudentFeeLedger[]
  transactions              Transaction[]
  paymentReceipts           PaymentReceipt[]
  refunds                   Refund[]
  scholarshipConfigs        ScholarshipConfig[]
  collegePaymentAccounts    CollegePaymentAccount[]
  documentTemplates         DocumentTemplate[]
  documentRequests          DocumentRequest[]
  issuedDocuments           IssuedDocument[]
  hostels                   Hostel[]
  commuteRoutes             CommuteRoute[]
  newsAlerts                NewsAlert[]
  articles                  Article[]
  referralCodes             ReferralCode[]
  serviceChargeConfigs      ServiceChargeConfig[]
  mediaKits                 MediaKit[]
  campusVisits              CampusVisit[]
  announcements             Announcement[]
  supportTickets            SupportTicket[]
  antiRaggingComplaints     AntiRaggingComplaint[]
  courseSwitchRequests      CourseSwitchRequest[]
  admissionFormConfigs      AdmissionFormConfig[]
  documentUploadConfigs     DocumentUploadConfig[]
  hostelEnrollments         HostelEnrollment[]
  commuteEnrollments        CommuteEnrollment[]
  broadcastNotifications    BroadcastNotification[]
  institutionGroups         InstitutionGroup[]
  institutionGroupMember    InstitutionGroupMember?
  collegeOnboardingRequests CollegeOnboardingRequest[]

  @@index([universityId], name: "idx_colleges_university")
  @@index([slug], name: "idx_colleges_slug")
  @@index([domain], name: "idx_colleges_domain")
  @@index([state], name: "idx_colleges_state")
  @@index([status], name: "idx_colleges_status")
  @@map("colleges")
}

model CollegeOnboardingRequest {
  id String @id @default(dbgenerated("('COR-'::text || (nextval('college_onboarding_request_seq'::regclass))::text)"))

  collegeName       String   @map("college_name") @db.VarChar(255)
  universityName    String?  @map("university_name") @db.VarChar(255)
  contactPersonName String   @map("contact_person_name") @db.VarChar(255)
  contactEmail      String   @map("contact_email") @db.VarChar(255)
  contactPhone      String?  @map("contact_phone") @db.VarChar(20)
  city              String?  @db.VarChar(100)
  state             String?  @db.VarChar(100)
  groupCode         String?  @map("group_code") @db.VarChar(20)
  message           String?  @db.Text
  status            String   @default("pending") @db.VarChar(20)
  reviewedBy        String?  @map("reviewed_by")
  reviewRemarks     String?  @map("review_remarks") @db.Text
  createdCollegeId  String?  @map("created_college_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  reviewer       PlatformAdmin? @relation(fields: [reviewedBy], references: [id])
  createdCollege College?       @relation(fields: [createdCollegeId], references: [id])

  @@index([status], name: "idx_onboard_status")
  @@map("college_onboarding_requests")
}

model Campus {
  id           String   @id @default(dbgenerated("('CMP-'::text || (nextval('campus_seq'::regclass))::text)"))
  collegeId    String   @map("college_id")
  name         String   @db.VarChar(255)
  address      String?  @db.Text
  city         String?  @db.VarChar(100)
  state        String?  @db.VarChar(100)
  pinCode      String?  @map("pin_code") @db.VarChar(10)
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  isMainCampus Boolean  @default(false) @map("is_main_campus")
  status       String   @default("active") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college      College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courses      Course[]
  applications Application[]
  enrollments  Enrollment[]

  @@index([collegeId], name: "idx_campuses_college")
  @@index([collegeId, status], name: "idx_campuses_status")
  @@map("campuses")
}

model Stream {
  id        String   @id @default(dbgenerated("('STR-'::text || (nextval('stream_seq'::regclass))::text)"))
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  logoUrl   String?  @map("logo_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  disciplines   Discipline[]

  @@map("streams")
}

model Discipline {
  id        String   @id @default(dbgenerated("('DSC-'::text || (nextval('discipline_seq'::regclass))::text)"))
  streamId  String   @map("stream_id")
  name      String   @db.VarChar(100)
  slug      String   @db.VarChar(50)
  logoUrl   String?  @map("logo_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  stream        Stream        @relation(fields: [streamId], references: [id])
  courses       Course[]

  @@unique([streamId, slug], name: "uq_discipline_slug")
  @@index([streamId], name: "idx_disciplines_stream")
  @@map("disciplines")
}

model StudyLevel {
  id        String   @id @default(dbgenerated("('SVL-'::text || (nextval('study_level_seq'::regclass))::text)"))
  name      String   @unique @db.VarChar(50)
  slug      String   @unique @db.VarChar(30)
  logoUrl   String?  @map("logo_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  courses       Course[]

  @@map("study_levels")
}

model ProgramType {
  id        String   @id @default(dbgenerated("('PGT-'::text || (nextval('program_type_seq'::regclass))::text)"))
  name      String   @unique @db.VarChar(50)
  slug      String   @unique @db.VarChar(30)
  logoUrl   String?  @map("logo_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  courses       Course[]

  @@map("program_types")
}


model Course {
  id                     String   @id @default(dbgenerated("('CRS-'::text || (nextval('course_seq'::regclass))::text)"))
  collegeId              String   @map("college_id")
  campusId               String?  @map("campus_id")
  disciplineId           String   @map("discipline_id")
  studyLevelId           String   @map("study_level_id")
  programTypeId          String   @map("program_type_id")
  appFeeCommissionType   String?  @map("app_fee_commission_type") @db.VarChar(10)
  appFeeCommissionValue  Decimal? @map("app_fee_commission_value") @db.Decimal(10, 2)
  tuitionCommissionType  String?  @map("tuition_commission_type") @db.VarChar(10)
  tuitionCommissionValue Decimal? @map("tuition_commission_value") @db.Decimal(10, 2)
  name                   String   @db.VarChar(255)
  code                   String   @db.VarChar(30)
  duration               String?  @db.VarChar(50)
  eligibility            String?  @db.Text
  intakeCapacity         Int?     @map("intake_capacity")
  studyMode              String   @default("full_time") @map("study_mode") @db.VarChar(20)
  status                 String   @default("active") @db.VarChar(20)
  metadata               Json     @default("{}")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college                College                 @relation(fields: [collegeId], references: [id])
  campus                 Campus?                 @relation(fields: [campusId], references: [id])
  discipline             Discipline              @relation(fields: [disciplineId], references: [id])
  studyLevel             StudyLevel              @relation(fields: [studyLevelId], references: [id])
  programType            ProgramType             @relation(fields: [programTypeId], references: [id])
  quotas                 CourseQuota[]
  admissionCycleCourses  AdmissionCycleCourse[]
  applicationCourses     ApplicationCourse[]
  questionCourseMappings QuestionCourseMapping[]
  feeStructures          FeeStructure[]
  serviceChargeConfigs   ServiceChargeConfig[]
  referralCodes          ReferralCode[]
  mediaKits              MediaKit[]
  enrollments            Enrollment[]
  courseSwitchRequestsTo CourseSwitchRequest[]   @relation("SwitchToCourse")

  @@unique([collegeId, code], name: "uq_course_code_college")
  @@index([collegeId], name: "idx_courses_college")
  @@index([campusId], name: "idx_courses_campus")
  @@index([disciplineId], name: "idx_courses_discipline")
  @@index([studyLevelId], name: "idx_courses_level")
  @@index([programTypeId], name: "idx_courses_program")
  @@index([collegeId, status], name: "idx_courses_status")
  @@map("courses")
}

model CourseQuota {
  id                 String   @id @default(dbgenerated("('CRQ-'::text || (nextval('course_quota_seq'::regclass))::text)"))
  courseId           String   @map("course_id")
  tuitionFeeOverride Decimal? @map("tuition_fee_override") @db.Decimal(12, 2)
  quotaName          String   @map("quota_name") @db.VarChar(100)
  seats              Int
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  applicationCourses ApplicationCourse[]

  @@unique([courseId, quotaName], name: "uq_course_quota")
  @@index([courseId], name: "idx_quotas_course")
  @@map("course_quotas")
}

model CollegeGallery {
  id        String   @id @default(dbgenerated("('CGY-'::text || (nextval('college_gallery_seq'::regclass))::text)"))
  collegeId String   @map("college_id")
  mediaType String   @map("media_type") @db.VarChar(10)
  url       String   @db.Text
  caption   String?  @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId], name: "idx_gallery_college")
  @@map("college_gallery")
}

model CollegeReview {
  id         String   @id @default(dbgenerated("('CRV-'::text || (nextval('college_review_seq'::regclass))::text)"))
  collegeId  String   @map("college_id")
  studentId  String   @map("student_id")
  rating     Int      @db.SmallInt
  reviewText String?  @map("review_text") @db.Text
  status     String   @default("pending") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college College @relation(fields: [collegeId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([collegeId, status], name: "idx_reviews_college")
  @@index([studentId], name: "idx_reviews_student")
  @@map("college_reviews")
}

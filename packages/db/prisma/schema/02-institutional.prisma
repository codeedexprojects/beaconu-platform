  accreditations                Json      @default("[]")
  keyDates                      Json      @default("[]") @map("key_dates")
  demographics                  Json      @default("{}")
  demographicsRefreshedAt       DateTime? @map("demographics_refreshed_at") @db.Timestamptz

  college                     College                      @relation(fields: [collegeId], references: [id])
  campus                      Campus?                      @relation(fields: [campusId], references: [id])
  department                  Department?                  @relation(fields: [departmentId], references: [id])
  discipline                  Discipline                   @relation(fields: [disciplineId], references: [id])
  studyLevel                  StudyLevel                   @relation(fields: [studyLevelId], references: [id])
  programType                 ProgramType                  @relation(fields: [programTypeId], references: [id])
  quotas                      CourseQuota[]
  admissionCycleCourses       AdmissionCycleCourse[]
  applicationCourses          ApplicationCourse[]
  questionCourseMappings      QuestionCourseMapping[]
  feeStructures               FeeStructure[]
  serviceChargeConfigs        ServiceChargeConfig[]
  referralCodes               ReferralCode[]
  mediaKits                   MediaKit[]
  enrollments                 Enrollment[]
  courseSwitchRequestsTo      CourseSwitchRequest[]        @relation("SwitchToCourse")
  newsAlerts                  NewsAlert[]
  collegeReviews              CollegeReview[]
  documentUploadConfigCourses DocumentUploadConfigCourse[]
  collegeWishlists            CollegeWishlist[]

  @@unique([collegeId, code], name: "uq_course_code_college")
  @@index([collegeId], name: "idx_courses_college")
  @@index([campusId], name: "idx_courses_campus")
  @@index([departmentId], name: "idx_courses_department")
  @@index([disciplineId], name: "idx_courses_discipline")
  @@index([studyLevelId], name: "idx_courses_level")
  @@index([programTypeId], name: "idx_courses_program")
  @@index([collegeId, status], name: "idx_courses_status")
  @@map("courses")
}

model CourseQuota {
  id                    String   @id @default(dbgenerated("('CRQ-'::text || (nextval('course_quota_seq'::regclass))::text)"))
  courseId              String   @map("course_id")
  collegeQuotaId        String   @map("college_quota_id")
  appFeeAdjustmentType  String?  @map("app_fee_adjustment_type") @db.VarChar(10)
  appFeeAdjustmentValue Decimal? @map("app_fee_adjustment_value") @db.Decimal(10, 2)
  tuitionFeeOverride    Decimal? @map("tuition_fee_override") @db.Decimal(12, 2)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  collegeQuota CollegeQuota @relation(fields: [collegeQuotaId], references: [id], onDelete: Cascade)

  @@unique([courseId, collegeQuotaId], name: "uq_course_college_quota")
  @@index([courseId], name: "idx_quotas_course")
  @@index([collegeQuotaId], name: "idx_quotas_college_quota")
  @@map("course_quotas")
}

model CollegeQuota {
  id          String   @id @default(dbgenerated("('CQT-'::text || (nextval('college_quota_seq'::regclass))::text)"))
  collegeId   String   @map("college_id")
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  bucketType  String   @map("bucket_type") @db.VarChar(20)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  college                    College                     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseQuotas               CourseQuota[]
  seatPools                  SeatPool[]
  courseQuotaSeats           CourseQuotaSeats[]
  documentUploadConfigQuotas DocumentUploadConfigQuota[]

  @@unique([collegeId, slug], name: "uq_college_quota_slug")
  @@index([collegeId], name: "idx_college_quotas_college")
  @@index([collegeId, bucketType], name: "idx_college_quotas_bucket")
  @@index([collegeId, isActive], name: "idx_college_quotas_active")
  @@map("college_quotas")
}

model CollegeGallery {
  id        String   @id @default(dbgenerated("('CGY-'::text || (nextval('college_gallery_seq'::regclass))::text)"))
  collegeId String   @map("college_id")
  mediaType String   @map("media_type") @db.VarChar(10)
  url       String   @db.Text
  caption   String?  @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId], name: "idx_gallery_college")
  @@map("college_gallery")
}

model CollegeReview {
  id         String   @id @default(dbgenerated("('CRV-'::text || (nextval('college_review_seq'::regclass))::text)"))
  collegeId  String   @map("college_id")
  studentId  String   @map("student_id")
  rating     Int      @db.SmallInt
  reviewText String?  @map("review_text") @db.Text
  status     String   @default("pending") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  courseId        String? @map("course_id")
  reviewType      String  @default("campus_life") @map("review_type") @db.VarChar(20)
  categoryRatings Json    @default("{}") @map("category_ratings")
  isAnonymous     Boolean @default(true) @map("is_anonymous")

  college College @relation(fields: [collegeId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  course  Course? @relation(fields: [courseId], references: [id])

  @@index([collegeId, status], name: "idx_reviews_college")
  @@index([studentId], name: "idx_reviews_student")
  @@index([courseId], name: "idx_reviews_course")
  @@map("college_reviews")
}

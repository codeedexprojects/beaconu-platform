model Hostel {
  id                 String   @id @default(dbgenerated("('HST-'::text || (nextval('hostel_seq'::regclass))::text)"))
  collegeId          String   @map("college_id")
  name               String   @db.VarChar(255)
  slug               String   @db.VarChar(100)
  hostelType         String   @map("hostel_type") @db.VarChar(20)
  isOnCampus         Boolean  @default(true) @map("is_on_campus")
  distanceFromCampus String?  @map("distance_from_campus") @db.VarChar(50)
  description        String?  @db.Text
  tags               Json     @default("[]")
  totalBeds          Int?     @map("total_beds")
  coverImageUrl      String?  @map("cover_image_url") @db.Text
  gallery            Json     @default("[]")
  wardenInfo         Json     @default("{}") @map("warden_info")
  amenities          Json     @default("[]")
  rules              Json     @default("[]")
  locationInfo       Json     @default("{}") @map("location_info")
  avgRating          Decimal  @default(0) @map("avg_rating") @db.Decimal(2, 1)
  reviewCount        Int      @default(0) @map("review_count")
  status             String   @default("active") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  safetyTier String? @map("safety_tier") @db.VarChar(100)
  badge      String? @db.VarChar(50)

  college       College              @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  roomTypes     HostelRoomType[]
  messPlans     HostelMessPlan[]
  addonServices HostelAddonService[]
  reviews       HostelReview[]
  enrollments   HostelEnrollment[]
  wishlists     HostelWishlist[]

  @@unique([collegeId, slug], name: "uq_hostel_slug")
  @@index([collegeId], name: "idx_hostels_college")
  @@index([hostelType], name: "idx_hostels_type")
  @@index([collegeId, status], name: "idx_hostels_status")
  @@map("hostels")
}

model HostelRoomType {
  id               String   @id @default(dbgenerated("('HRT-'::text || (nextval('hostel_room_type_seq'::regclass))::text)"))
  hostelId         String   @map("hostel_id")
  name             String   @db.VarChar(100)
  description      String?  @db.Text
  totalBeds        Int      @map("total_beds")
  availableBeds    Int      @map("available_beds")
  photos           Json     @default("[]")
  annualPlanPrice  Decimal? @map("annual_plan_price") @db.Decimal(10, 2)
  monthlyPlanPrice Decimal? @map("monthly_plan_price") @db.Decimal(10, 2)
  admissionFee     Decimal  @default(0) @map("admission_fee") @db.Decimal(10, 2)
  securityDeposit  Decimal  @default(0) @map("security_deposit") @db.Decimal(10, 2)
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  hostel      Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  enrollments HostelEnrollment[]

  @@index([hostelId], name: "idx_room_types_hostel")
  @@index([hostelId, isActive], name: "idx_room_types_active")
  @@index([availableBeds], name: "idx_room_types_available")
  @@map("hostel_room_types")
}

model HostelMessPlan {
  id             String   @id @default(dbgenerated("('HMP-'::text || (nextval('hostel_mess_plan_seq'::regclass))::text)"))
  hostelId       String   @map("hostel_id")
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  mealsIncluded  Json     @default("[]") @map("meals_included")
  priceMonthly   Decimal  @map("price_monthly") @db.Decimal(10, 2)
  duration       String   @default("1 Month") @db.VarChar(20)
  isCompulsory   Boolean  @default(false) @map("is_compulsory")
  dietaryOptions Json     @default("[]") @map("dietary_options")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  hostel      Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  enrollments HostelEnrollment[]

  @@index([hostelId], name: "idx_mess_plans_hostel")
  @@map("hostel_mess_plans")
}

model HostelAddonService {
  id          String   @id @default(dbgenerated("('HAS-'::text || (nextval('hostel_addon_service_seq'::regclass))::text)"))
  hostelId    String   @map("hostel_id")
  serviceType String   @map("service_type") @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isOptional  Boolean  @default(true) @map("is_optional")
  plans       Json
  notes       String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@index([hostelId], name: "idx_addon_hostel")
  @@index([serviceType], name: "idx_addon_type")
  @@map("hostel_addon_services")
}

model HostelReview {
  id         String   @id @default(dbgenerated("('HRV-'::text || (nextval('hostel_review_seq'::regclass))::text)"))
  hostelId   String   @map("hostel_id")
  studentId  String   @map("student_id")
  rating     Int      @db.SmallInt
  reviewText String?  @map("review_text") @db.Text
  isVerified Boolean  @default(false) @map("is_verified")
  status     String   @default("pending") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  hostel  Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])

  @@unique([hostelId, studentId], name: "uq_hostel_review_student")
  @@index([hostelId, status], name: "idx_hreviews_hostel")
  @@index([studentId], name: "idx_hreviews_student")
  @@map("hostel_reviews")
}

model HostelEnrollment {
  id                String    @id @default(dbgenerated("('HEN-'::text || (nextval('hostel_enrollment_seq'::regclass))::text)"))
  studentId         String    @map("student_id")
  collegeId         String    @map("college_id")
  hostelId          String    @map("hostel_id")
  roomTypeId        String    @map("room_type_id")
  roomPlanType      String    @map("room_plan_type") @db.VarChar(10)
  messId            String?   @map("mess_plan_id")
  dietaryPreference String?   @map("dietary_preference") @db.VarChar(20)
  selectedAddons    Json      @default("[]") @map("selected_addons")
  feeBreakdown      Json      @map("fee_breakdown")
  status            String    @default("active") @db.VarChar(20)
  enrolledFrom      DateTime  @map("enrolled_from") @db.Date
  enrolledUntil     DateTime? @map("enrolled_until") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  student  Student         @relation(fields: [studentId], references: [id])
  college  College         @relation(fields: [collegeId], references: [id])
  hostel   Hostel          @relation(fields: [hostelId], references: [id])
  roomType HostelRoomType  @relation(fields: [roomTypeId], references: [id])
  messPlan HostelMessPlan? @relation(fields: [messId], references: [id])

  @@index([studentId], name: "idx_henroll_student")
  @@index([collegeId], name: "idx_henroll_college")
  @@index([hostelId], name: "idx_henroll_hostel")
  @@index([status], name: "idx_henroll_status")
  @@map("hostel_enrollments")
}

model HostelWishlist {
  id        String   @id @default(dbgenerated("('HWL-'::text || (nextval('hostel_wishlist_seq'::regclass))::text)"))
  studentId String   @map("student_id")
  hostelId  String   @map("hostel_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel  Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@unique([studentId, hostelId], name: "uq_hostel_wishlist")
  @@index([studentId], name: "idx_hwish_student")
  @@index([hostelId], name: "idx_hwish_hostel")
  @@map("hostel_wishlists")
}

// ============================================================
// MODULE 4 — ADMISSIONS
// ============================================================

model AdmissionCycle {
  id              String    @id @default(dbgenerated("('ACV-'::text || (nextval('admission_cycle_seq'::regclass))::text)"))
  collegeId       String    @map("college_id")
  applicationType String    @map("application_type") @db.VarChar(50)
  name            String    @db.VarChar(255)
  slug            String    @db.VarChar(100)
  programLevel    String    @map("program_level") @db.VarChar(30)
  admissionYear   String    @map("admission_year") @db.VarChar(10)
  startsOn        DateTime  @map("starts_on") @db.Date
  endsOn          DateTime? @map("ends_on") @db.Date
  status          String    @default("open") @db.VarChar(20)
  settings        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college               College                @relation(fields: [collegeId], references: [id])
  admissionCycleCourses AdmissionCycleCourse[]
  applications          Application[]
  enrollments           Enrollment[]
  admissionFormConfigs  AdmissionFormConfig[]
  documentUploadConfigs DocumentUploadConfig[]
  seatPools             SeatPool[]

  @@unique([collegeId, slug], name: "uq_cycle_slug_college")
  @@index([collegeId], name: "idx_cycles_college")
  @@index([collegeId, status], name: "idx_cycles_status")
  @@index([startsOn, endsOn], name: "idx_cycles_dates")
  @@map("admission_cycles")
}

model AdmissionCycleCourse {
  id                     String   @id @default(dbgenerated("('ACC-'::text || (nextval('admission_cycle_course_seq'::regclass))::text)"))
  admissionCycleId       String   @map("admission_cycle_id")
  courseId               String   @map("course_id")
  applicationFee         Decimal  @default(0) @map("application_fee") @db.Decimal(10, 2)
  interviewRequired      Boolean  @default(true) @map("interview_required")
  assessmentRequired     Boolean  @default(true) @map("assessment_required")
  tokenPaymentStage      String?  @map("token_payment_stage") @db.VarChar(20)
  workExperienceRequired Boolean  @default(true) @map("work_experience_required")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  admissionCycle AdmissionCycle     @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)
  course         Course             @relation(fields: [courseId], references: [id])
  quotaSeats     CourseQuotaSeats[]

  @@unique([admissionCycleId, courseId], name: "uq_cycle_course")
  @@index([admissionCycleId], name: "idx_cycle_courses_cycle")
  @@index([courseId], name: "idx_cycle_courses_course")
  @@map("admission_cycle_courses")
}

// Seats for one course's quota, within one admission cycle. Entered right
// alongside attaching the quota to the course. Either holds its own
// totalSeats (exclusive to this course) or defers to a shared SeatPool.
model CourseQuotaSeats {
  id                     String   @id @default(dbgenerated("('CQS-'::text || (nextval('course_quota_seats_seq'::regclass))::text)"))
  admissionCycleCourseId String   @map("admission_cycle_course_id")
  collegeQuotaId         String   @map("college_quota_id")
  seatPoolId             String?  @map("seat_pool_id")
  totalSeats             Int?     @map("total_seats")
  openSeats              Int?     @map("open_seats")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  admissionCycleCourse AdmissionCycleCourse @relation(fields: [admissionCycleCourseId], references: [id], onDelete: Cascade)
  collegeQuota         CollegeQuota         @relation(fields: [collegeQuotaId], references: [id], onDelete: Cascade)
  seatPool             SeatPool?            @relation(fields: [seatPoolId], references: [id], onDelete: SetNull)

  @@unique([admissionCycleCourseId, collegeQuotaId], name: "uq_cycle_course_quota")
  @@index([admissionCycleCourseId], name: "idx_cqs_cycle_course")
  @@index([collegeQuotaId], name: "idx_cqs_quota")
  @@index([seatPoolId], name: "idx_cqs_seat_pool")
  @@map("course_quota_seats")
}

model Application {
  id                    String    @id @default(dbgenerated("('APP-'::text || (nextval('application_seq'::regclass))::text)"))
  applicationNumber     String    @unique @map("application_number") @db.VarChar(30)
  studentId             String    @map("student_id")
  collegeId             String    @map("college_id")
  campusId              String?   @map("campus_id")
  admissionCycleId      String    @map("admission_cycle_id")
  currentStep           Int       @default(1) @map("current_step") @db.SmallInt
  formStatus            String    @default("draft") @map("form_status") @db.VarChar(20)
  profilePhotoUrl       String?   @map("profile_photo_url") @db.Text
  whatsappCountryCode   String?   @default("+91") @map("whatsapp_country_code") @db.VarChar(5)
  whatsappNumber        String?   @map("whatsapp_number") @db.VarChar(15)
  nationality           String?   @db.VarChar(100)
  stateOfDomicile       String?   @map("state_of_domicile") @db.VarChar(100)
  passportCountry       String?   @map("passport_country") @db.VarChar(100)
  passportNumber        String?   @map("passport_number") @db.VarChar(50)
  workExperienceDetails Json?     @map("work_experience_details")
  entranceExamDetails   Json?     @map("entrance_exam_details")
  applicationPdfUrl     String?   @map("application_pdf_url") @db.Text
  quotaDetails          Json      @default("{}") @map("quota_details")
  personalDetails       Json      @default("{}") @map("personal_details")
  familyDetails         Json      @default("{}") @map("family_details")
  addressDetails        Json      @default("{}") @map("address_details")
  qualificationDetails  Json      @default("{}") @map("qualification_details")
  declaration           Json      @default("{}")
  totalApplicationFee   Decimal   @default(0) @map("total_application_fee") @db.Decimal(10, 2)
  feePaymentStatus      String    @default("pending") @map("fee_payment_status") @db.VarChar(20)
  feeTransactionId      String?   @map("fee_transaction_id")
  referralCodeId        String?   @map("referral_code_id")
  submittedAt           DateTime? @map("submitted_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  student            Student               @relation(fields: [studentId], references: [id])
  college            College               @relation(fields: [collegeId], references: [id])
  campus             Campus?               @relation(fields: [campusId], references: [id])
  admissionCycle     AdmissionCycle        @relation(fields: [admissionCycleId], references: [id])
  referralCode       ReferralCode?         @relation(fields: [referralCodeId], references: [id])
  applicationCourses ApplicationCourse[]
  documents          ApplicationDocument[]

  @@unique([studentId, admissionCycleId], name: "uq_student_cycle")
  @@index([studentId], name: "idx_applications_student")
  @@index([collegeId], name: "idx_applications_college")
  @@index([admissionCycleId], name: "idx_applications_cycle")
  @@index([collegeId, formStatus], name: "idx_applications_status")
  @@index([applicationNumber], name: "idx_applications_number")
  @@map("applications")
}

model ApplicationCourse {
  id              String    @id @default(dbgenerated("('APC-'::text || (nextval('application_course_seq'::regclass))::text)"))
  applicationId   String    @map("application_id")
  courseId        String    @map("course_id")
  applicationFee  Decimal   @default(0) @map("application_fee") @db.Decimal(10, 2)
  status          String    @default("draft") @db.VarChar(30)
  rejectionReason String?   @map("rejection_reason") @db.Text
  quotaId         String?   @map("quota_id")
  preferenceOrder Int       @default(1) @map("preference_order") @db.SmallInt
  statusHistory   Json      @default("[]") @map("status_history")
  statusUpdatedAt DateTime? @map("status_updated_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  application             Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  course                  Course                   @relation(fields: [courseId], references: [id])
  quota                   CourseQuota?             @relation(fields: [quotaId], references: [id])
  statusLogs              ApplicationStatusLog[]
  assessmentAttempts      AssessmentAttempt[]
  interviewBooking        InterviewBooking?
  offerLetter             OfferLetter?
  seatCancellations       SeatCancellation[]
  enrollment              Enrollment?
  referral                Referral?
  scholarshipApplications ScholarshipApplication[]
  studentFeeLedger        StudentFeeLedger[]

  @@unique([applicationId, courseId], name: "uq_application_course")
  @@index([applicationId], name: "idx_app_courses_application")
  @@index([courseId], name: "idx_app_courses_course")
  @@index([status], name: "idx_app_courses_status")
  @@index([applicationId, preferenceOrder], name: "idx_app_courses_preference")
  @@map("application_courses")
}

model ApplicationDocument {
  id                 String    @id @default(dbgenerated("('APD-'::text || (nextval('application_document_seq'::regclass))::text)"))
  applicationId      String    @map("application_id")
  documentType       String    @map("document_type") @db.VarChar(50)
  documentCategory   String    @map("document_category") @db.VarChar(30)
  fileUrl            String    @map("file_url") @db.Text
  fileName           String?   @map("file_name") @db.VarChar(255)
  fileSizeBytes      Int?      @map("file_size_bytes")
  verificationStatus String    @default("pending") @map("verification_status") @db.VarChar(20)
  rejectionReason    String?   @map("rejection_reason") @db.Text
  verifiedBy         String?   @map("verified_by")
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifier    StaffMember? @relation("VerifiedByStaff", fields: [verifiedBy], references: [id])
  // Note: verifiedBy is polymorphic (staff or student). Prisma FK points to staff_members.
  // Resolve student verification at application layer.

  @@index([applicationId], name: "idx_app_docs_application")
  @@index([documentType], name: "idx_app_docs_type")
  @@index([verificationStatus], name: "idx_app_docs_status")
  @@map("application_documents")
}

model ApplicationStatusLog {
  id                  String   @id @default(dbgenerated("('APL-'::text || (nextval('application_status_log_seq'::regclass))::text)"))
  applicationCourseId String   @map("application_course_id")
  fromStatus          String?  @map("from_status") @db.VarChar(30)
  toStatus            String   @map("to_status") @db.VarChar(30)
  changedByType       String   @map("changed_by_type") @db.VarChar(20)
  changedById         String?  @map("changed_by_id")
  remarks             String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  applicationCourse ApplicationCourse @relation(fields: [applicationCourseId], references: [id], onDelete: Cascade)

  @@index([applicationCourseId], name: "idx_status_logs_app_course")
  @@index([createdAt], name: "idx_status_logs_created")
  @@map("application_status_logs")
}

model SeatCancellation {
  id                  String    @id @default(dbgenerated("('SCN-'::text || (nextval('seat_cancellation_seq'::regclass))::text)"))
  applicationCourseId String    @map("application_course_id")
  studentId           String    @map("student_id")
  reason              String    @db.Text
  supportingDocUrls   Json      @default("[]") @map("supporting_doc_urls")
  status              String    @default("pending") @db.VarChar(20)
  refundAmount        Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  refundStatus        String?   @map("refund_status") @db.VarChar(20)
  processedBy         String?   @map("processed_by")
  remarks             String?   @db.Text
  requestedAt         DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  processedAt         DateTime? @map("processed_at") @db.Timestamptz

  // Relations
  applicationCourse ApplicationCourse @relation(fields: [applicationCourseId], references: [id])
  student           Student           @relation(fields: [studentId], references: [id])
  processor         StaffMember?      @relation(fields: [processedBy], references: [id])

  @@index([applicationCourseId], name: "idx_cancellations_app_course")
  @@index([studentId], name: "idx_cancellations_student")
  @@index([status], name: "idx_cancellations_status")
  @@map("seat_cancellations")
}

model Enrollment {
  id                  String    @id @default(dbgenerated("('ENR-'::text || (nextval('enrollment_seq'::regclass))::text)"))
  studentId           String    @map("student_id")
  collegeId           String    @map("college_id")
  courseId            String    @map("course_id")
  campusId            String?   @map("campus_id")
  applicationCourseId String    @unique @map("application_course_id")
  admissionCycleId    String    @map("admission_cycle_id")
  enrollmentNumber    String    @unique @map("enrollment_number") @db.VarChar(30)
  academicYear        String    @map("academic_year") @db.VarChar(10)
  enrolledAt          DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz
  status              String    @default("active") @db.VarChar(20)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  student                 Student               @relation(fields: [studentId], references: [id])
  college                 College               @relation(fields: [collegeId], references: [id])
  course                  Course                @relation(fields: [courseId], references: [id])
  campus                  Campus?               @relation(fields: [campusId], references: [id])
  applicationCourse       ApplicationCourse     @relation(fields: [applicationCourseId], references: [id])
  admissionCycle          AdmissionCycle        @relation(fields: [admissionCycleId], references: [id])
  courseSwitchRequests    CourseSwitchRequest[] @relation("EnrollmentSwitchRequests")
  newCourseSwitchRequests CourseSwitchRequest[] @relation("NewEnrollmentFromSwitch")
  studentFeeLedger        StudentFeeLedger[]

  @@unique([studentId, courseId, collegeId], name: "uq_enrollment_student_course")
  @@index([studentId], name: "idx_enrollments_student")
  @@index([collegeId], name: "idx_enrollments_college")
  @@index([courseId], name: "idx_enrollments_course")
  @@index([applicationCourseId], name: "idx_enrollments_app_course")
  @@index([collegeId, status], name: "idx_enrollments_status")
  @@index([enrollmentNumber], name: "idx_enrollments_number")
  @@index([academicYear], name: "idx_enrollments_academic_year")
  @@map("enrollments")
}

model CourseSwitchRequest {
  id                  String    @id @default(dbgenerated("('CSR-'::text || (nextval('course_switch_request_seq'::regclass))::text)"))
  studentId           String    @map("student_id")
  collegeId           String    @map("college_id")
  enrollmentId        String    @map("enrollment_id")
  toCourseId          String    @map("to_course_id")
  reason              String    @db.Text
  supportingDocuments Json      @default("[]") @map("supporting_documents")
  status              String    @default("pending") @db.VarChar(20)
  processedBy         String?   @map("processed_by")
  remarks             String?   @db.Text
  processedAt         DateTime? @map("processed_at") @db.Timestamptz
  newEnrollmentId     String?   @map("new_enrollment_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  student       Student      @relation(fields: [studentId], references: [id])
  college       College      @relation(fields: [collegeId], references: [id])
  enrollment    Enrollment   @relation("EnrollmentSwitchRequests", fields: [enrollmentId], references: [id])
  toCourse      Course       @relation("SwitchToCourse", fields: [toCourseId], references: [id])
  processor     StaffMember? @relation("ProcessedBySwitchStaff", fields: [processedBy], references: [id])
  newEnrollment Enrollment?  @relation("NewEnrollmentFromSwitch", fields: [newEnrollmentId], references: [id])

  @@index([studentId], name: "idx_csr_student")
  @@index([collegeId], name: "idx_csr_college")
  @@index([enrollmentId], name: "idx_csr_enrollment")
  @@index([status], name: "idx_csr_status")
  @@map("course_switch_requests")
}

model AdmissionFormConfig {
  id               String   @id @default(dbgenerated("('AFC-'::text || (nextval('admission_form_config_seq'::regclass))::text)"))
  collegeId        String   @map("college_id")
  admissionCycleId String?  @map("admission_cycle_id")
  section          String   @db.VarChar(30)
  fieldConfig      Json     @map("field_config")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college        College         @relation(fields: [collegeId], references: [id])
  admissionCycle AdmissionCycle? @relation(fields: [admissionCycleId], references: [id])

  @@index([collegeId], name: "idx_afc_college")
  @@index([admissionCycleId], name: "idx_afc_cycle")
  @@index([section], name: "idx_afc_section")
  @@index([collegeId, isActive], name: "idx_afc_active")
  @@map("admission_form_configs")
}

model DocumentUploadConfig {
  id                     String   @id @default(dbgenerated("('DUC-'::text || (nextval('document_upload_config_seq'::regclass))::text)"))
  collegeId              String   @map("college_id")
  admissionCycleId       String?  @map("admission_cycle_id")
  documentType           String   @map("document_type") @db.VarChar(50)
  documentCategory       String   @map("document_category") @db.VarChar(30)
  documentLabel          String   @map("document_label") @db.VarChar(100)
  isRequired             Boolean  @default(true) @map("is_required")
  appliesToQuotas        Json?    @map("applies_to_quotas")
  appliesToNationalities Json?    @map("applies_to_nationalities")
  appliesToCourses       Json?    @map("applies_to_courses")
  sortOrder              Int      @default(0) @map("sort_order")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college        College         @relation(fields: [collegeId], references: [id])
  admissionCycle AdmissionCycle? @relation(fields: [admissionCycleId], references: [id])

  @@index([collegeId], name: "idx_duc_college")
  @@index([admissionCycleId], name: "idx_duc_cycle")
  @@index([documentCategory], name: "idx_duc_category")
  @@index([collegeId, isActive], name: "idx_duc_active")
  @@map("document_upload_configs")
}

// An optional shared bucket of seats. A CourseQuotaSeats row can either hold
// its own totalSeats (exclusive to that course) or point at a SeatPool here
// to share seats with other courses' CourseQuotaSeats rows for the same quota.
model SeatPool {
  id               String   @id @default(dbgenerated("('SPL-'::text || (nextval('seat_pool_seq'::regclass))::text)"))
  collegeQuotaId   String   @map("college_quota_id")
  admissionCycleId String   @map("admission_cycle_id")
  totalSeats       Int      @map("total_seats")
  openSeats        Int      @map("open_seats")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  collegeQuota   CollegeQuota            @relation(fields: [collegeQuotaId], references: [id], onDelete: Cascade)
  admissionCycle AdmissionCycle          @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)
  courseQuotas   CourseQuotaSeats[]

  @@index([collegeQuotaId], name: "idx_seat_pool_college_quota")
  @@index([admissionCycleId], name: "idx_seat_pool_cycle")
  @@map("seat_pools")
}

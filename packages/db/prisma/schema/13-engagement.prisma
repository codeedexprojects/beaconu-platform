// ============================================================
// MODULE 13 — ENGAGEMENT
// ============================================================

model Community {
  id            String   @id @default(dbgenerated("('CMT-'::text || (nextval('community_seq'::regclass))::text)"))
  name          String   @db.VarChar(255)
  slug          String   @unique @db.VarChar(100)
  description   String?  @db.Text
  coverImageUrl String?  @map("cover_image_url") @db.Text
  iconUrl       String?  @map("icon_url") @db.Text
  createdById   String   @map("created_by_id")
  createdByType String   @map("created_by_type") @db.VarChar(20)
  memberCount   Int      @default(0) @map("member_count")
  postCount     Int      @default(0) @map("post_count")
  status        String   @default("active") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  members CommunityMember[]
  posts   CommunityPost[]

  @@index([slug], name: "idx_communities_slug")
  @@index([status], name: "idx_communities_status")
  @@index([memberCount(sort: Desc)], name: "idx_communities_members")
  @@map("communities")
}

model CommunityMember {
  id          String   @id @default(dbgenerated("('CMM-'::text || (nextval('community_member_seq'::regclass))::text)"))
  communityId String   @map("community_id")
  memberType  String   @map("member_type") @db.VarChar(20)
  memberId    String   @map("member_id")
  notifyMe    Boolean  @default(false) @map("notify_me")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, memberType, memberId], name: "uq_community_member")
  @@index([communityId], name: "idx_cmembers_community")
  @@index([memberType, memberId], name: "idx_cmembers_member")
  @@map("community_members")
}

model CommunityPost {
  id            String   @id @default(dbgenerated("('CPT-'::text || (nextval('community_post_seq'::regclass))::text)"))
  communityId   String   @map("community_id")
  authorId      String   @map("author_id")
  authorType    String   @map("author_type") @db.VarChar(20)
  content       String   @db.Text
  attachments   Json     @default("[]")
  upvoteCount   Int      @default(0) @map("upvote_count")
  downvoteCount Int      @default(0) @map("downvote_count")
  commentCount  Int      @default(0) @map("comment_count")
  shareCount    Int      @default(0) @map("share_count")
  status        String   @default("active") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  community Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  votes     CommunityPostVote[]
  comments  CommunityComment[]

  @@index([communityId, createdAt(sort: Desc)], name: "idx_cposts_community")
  @@index([authorId], name: "idx_cposts_author")
  @@index([status], name: "idx_cposts_status")
  @@map("community_posts")
}

model CommunityPostVote {
  id        String   @id @default(dbgenerated("('CPV-'::text || (nextval('community_post_vote_seq'::regclass))::text)"))
  postId    String   @map("post_id")
  voterId   String   @map("voter_id")
  voterType String   @map("voter_type") @db.VarChar(20)
  voteType  String   @map("vote_type") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, voterId, voterType], name: "uq_post_vote")
  @@index([postId], name: "idx_votes_post")
  @@index([voterId], name: "idx_votes_voter")
  @@map("community_post_votes")
}

model CommunityComment {
  id              String   @id @default(dbgenerated("('CCT-'::text || (nextval('community_comment_seq'::regclass))::text)"))
  postId          String   @map("post_id")
  authorId        String   @map("author_id")
  authorType      String   @map("author_type") @db.VarChar(20)
  parentCommentId String?  @map("parent_comment_id")
  content         String   @db.Text
  likeCount       Int      @default(0) @map("like_count")
  status          String   @default("active") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentComment CommunityComment? @relation("CommentReplies", fields: [parentCommentId], references: [id])

  replies CommunityComment[]     @relation("CommentReplies")
  likes   CommunityCommentLike[]

  @@index([postId, createdAt], name: "idx_comments_post")
  @@index([authorId], name: "idx_comments_author")
  @@index([parentCommentId], name: "idx_comments_parent")
  @@map("community_comments")
}

model CommunityCommentLike {
  id        String   @id @default(dbgenerated("('CCL-'::text || (nextval('community_comment_like_seq'::regclass))::text)"))
  commentId String   @map("comment_id")
  likerId   String   @map("liker_id")
  likerType String   @map("liker_type") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  comment CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, likerId, likerType], name: "uq_comment_like")
  @@index([commentId], name: "idx_clikes_comment")
  @@index([likerId], name: "idx_clikes_liker")
  @@map("community_comment_likes")
}

model SquadSearch {
  id             String   @id @default(dbgenerated("('SQS-'::text || (nextval('squad_search_seq'::regclass))::text)"))
  studentId      String   @map("student_id")
  preferredCity  String?  @map("preferred_city") @db.VarChar(100)
  preferredState String?  @map("preferred_state") @db.VarChar(100)
  friends        Json
  results        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId], name: "idx_squad_student")
  @@map("squad_searches")
}

model BeaconuCard {
  id             String   @id @default(dbgenerated("('BCR-'::text || (nextval('beaconu_card_seq'::regclass))::text)"))
  studentId      String   @unique @map("student_id")
  cardNumber     String   @unique @map("card_number") @db.VarChar(20)
  cardHolderName String   @map("card_holder_name") @db.VarChar(255)
  validUntil     DateTime @map("valid_until") @db.Date
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  totalEarned    Decimal  @default(0) @map("total_earned") @db.Decimal(12, 2)
  totalWithdrawn Decimal  @default(0) @map("total_withdrawn") @db.Decimal(12, 2)
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  student      Student                    @relation(fields: [studentId], references: [id])
  transactions StudentWalletTransaction[]

  @@index([studentId], name: "idx_card_student")
  @@index([cardNumber], name: "idx_card_number")
  @@index([status], name: "idx_card_status")
  @@map("beaconu_cards")
}

model StudentBankAccount {
  id                     String   @id @default(dbgenerated("('SBA-'::text || (nextval('student_bank_account_seq'::regclass))::text)"))
  studentId              String   @map("student_id")
  bankName               String   @map("bank_name") @db.VarChar(100)
  accountHolderName      String   @map("account_holder_name") @db.VarChar(255)
  accountNumberLast4     String   @map("account_number_last4") @db.VarChar(4)
  accountNumberEncrypted String   @map("account_number_encrypted") @db.Text
  ifscCode               String   @map("ifsc_code") @db.VarChar(15)
  accountType            String   @default("savings") @map("account_type") @db.VarChar(20)
  isVerified             Boolean  @default(false) @map("is_verified")
  isPrimary              Boolean  @default(false) @map("is_primary")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  student    Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  walletTxns StudentWalletTransaction[]

  @@index([studentId], name: "idx_sba_student")
  @@map("student_bank_accounts")
}

model StudentWalletTransaction {
  id               String   @id @default(dbgenerated("('SWT-'::text || (nextval('student_wallet_transaction_seq'::regclass))::text)"))
  cardId           String   @map("card_id")
  studentId        String   @map("student_id")
  type             String   @db.VarChar(20)
  amount           Decimal  @db.Decimal(10, 2)
  description      String?  @db.VarChar(255)
  referralId       String?  @map("referral_id")
  bankAccountId    String?  @map("bank_account_id")
  withdrawalStatus String?  @map("withdrawal_status") @db.VarChar(20)
  balanceAfter     Decimal  @map("balance_after") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  card        BeaconuCard         @relation(fields: [cardId], references: [id])
  student     Student             @relation(fields: [studentId], references: [id])
  referral    Referral?           @relation(fields: [referralId], references: [id])
  bankAccount StudentBankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([cardId], name: "idx_swtxn_card")
  @@index([studentId], name: "idx_swtxn_student")
  @@index([type], name: "idx_swtxn_type")
  @@index([createdAt(sort: Desc)], name: "idx_swtxn_created")
  @@index([withdrawalStatus], name: "idx_swtxn_withdrawal")
  @@map("student_wallet_transactions")
}

model AntiRaggingComplaint {
  id                  String    @id @default(dbgenerated("('ARC-'::text || (nextval('anti_ragging_complaint_seq'::regclass))::text)"))
  studentId           String    @map("student_id")
  collegeId           String    @map("college_id")
  complaintNumber     String    @unique @map("complaint_number") @db.VarChar(30)
  incidentType        String    @map("incident_type") @db.VarChar(20)
  subject             String    @db.VarChar(255)
  individualsInvolved Json      @default("[]") @map("individuals_involved")
  incidentDate        DateTime  @map("incident_date") @db.Date
  incidentTime        DateTime? @map("incident_time") @db.Time
  description         String    @db.Text
  isAnonymous         Boolean   @default(false) @map("is_anonymous")
  attachments         Json      @default("[]")
  status              String    @default("submitted") @db.VarChar(20)
  statusHistory       Json      @default("[]") @map("status_history")
  assignedTo          String?   @map("assigned_to")
  resolution          String?   @db.Text
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  student  Student      @relation(fields: [studentId], references: [id])
  college  College      @relation(fields: [collegeId], references: [id])
  assignee StaffMember? @relation(fields: [assignedTo], references: [id])

  @@index([studentId], name: "idx_arc_student")
  @@index([collegeId], name: "idx_arc_college")
  @@index([status], name: "idx_arc_status")
  @@index([complaintNumber], name: "idx_arc_number")
  @@map("anti_ragging_complaints")
}

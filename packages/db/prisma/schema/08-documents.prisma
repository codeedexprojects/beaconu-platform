model DocumentTemplate {
  id           String   @id @default(dbgenerated("('DTM-'::text || (nextval('document_template_seq'::regclass))::text)"))
  collegeId    String   @map("college_id")
  name         String   @db.VarChar(100)
  slug         String   @db.VarChar(50)
  category     String   @db.VarChar(50)
  instructions String?  @db.Text
  description  String?  @db.Text
  isStandard   Boolean  @default(true) @map("is_standard")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  college          College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  documentRequests DocumentRequest[]

  @@unique([collegeId, slug], name: "uq_doc_template_slug")
  @@index([collegeId], name: "idx_doc_templates_college")
  @@index([collegeId, isActive], name: "idx_doc_templates_active")
  @@map("document_templates")
}

model DocumentRequest {
  id                  String    @id @default(dbgenerated("('DRQ-'::text || (nextval('document_request_seq'::regclass))::text)"))
  requestNumber       String    @unique @map("request_number") @db.VarChar(30)
  studentId           String    @map("student_id")
  collegeId           String    @map("college_id")
  documentTemplateId  String?   @map("document_template_id")
  documentName        String    @map("document_name") @db.VarChar(255)
  description         String?   @db.Text
  deliveryMode        String    @map("delivery_mode") @db.VarChar(20)
  supportingDocuments Json      @default("[]") @map("supporting_documents")
  status              String    @default("submitted") @db.VarChar(20)
  rejectionReason     String?   @map("rejection_reason") @db.Text
  resubmissionCount   Int       @default(0) @map("resubmission_count")
  resubmissionHistory Json      @default("[]") @map("resubmission_history")
  assignedTo          String?   @map("assigned_to")
  processedBy         String?   @map("processed_by")
  issuedDocumentUrl   String?   @map("issued_document_url") @db.Text
  issuedAt            DateTime? @map("issued_at") @db.Timestamptz
  pickupDate          DateTime? @map("pickup_date") @db.Date
  pickupConfirmed     Boolean   @default(false) @map("pickup_confirmed")
  pickupInstructions  String?   @map("pickup_instructions") @db.Text
  officeContactPhone  String?   @map("office_contact_phone") @db.VarChar(20)
  statusHistory       Json      @default("[]") @map("status_history")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  student          Student           @relation(fields: [studentId], references: [id])
  college          College           @relation(fields: [collegeId], references: [id])
  documentTemplate DocumentTemplate? @relation(fields: [documentTemplateId], references: [id])
  assignedStaff    StaffMember?      @relation("AssignedStaff", fields: [assignedTo], references: [id])
  processedStaff   StaffMember?      @relation("ProcessedByStaff", fields: [processedBy], references: [id])
  issuedDocuments  IssuedDocument[]

  @@index([studentId], name: "idx_docreq_student")
  @@index([collegeId], name: "idx_docreq_college")
  @@index([documentTemplateId], name: "idx_docreq_template")
  @@index([collegeId, status], name: "idx_docreq_status")
  @@index([assignedTo], name: "idx_docreq_assigned")
  @@index([requestNumber], name: "idx_docreq_number")
  @@map("document_requests")
}

model IssuedDocument {
  id                String   @id @default(dbgenerated("('ISD-'::text || (nextval('issued_document_seq'::regclass))::text)"))
  documentRequestId String   @map("document_request_id")
  studentId         String   @map("student_id")
  collegeId         String   @map("college_id")
  documentName      String   @map("document_name") @db.VarChar(255)
  documentUrl       String   @map("document_url") @db.Text
  fileName          String?  @map("file_name") @db.VarChar(255)
  fileSizeBytes     Int?     @map("file_size_bytes")
  deliveryMode      String   @map("delivery_mode") @db.VarChar(20)
  issuedBy          String   @map("issued_by")
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz

  documentRequest DocumentRequest @relation(fields: [documentRequestId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])
  college         College         @relation(fields: [collegeId], references: [id])
  issuer          StaffMember     @relation(fields: [issuedBy], references: [id])

  @@index([documentRequestId], name: "idx_issued_request")
  @@index([studentId], name: "idx_issued_student")
  @@index([collegeId], name: "idx_issued_college")
  @@map("issued_documents")
}

model DocumentSubmissionRequest {
  id               String    @id @default(dbgenerated("('DSR-'::text || (nextval('document_submission_request_seq'::regclass))::text)"))
  collegeId        String    @map("college_id")
  studentId        String    @map("student_id")
  requestedBy      String    @map("requested_by")
  documentCategory String    @map("document_category") @db.VarChar(50)
  documentName     String    @map("document_name") @db.VarChar(255)
  instructions     String?   @db.Text
  deadline         DateTime  @db.Date
  status           String    @default("pending") @db.VarChar(20)
  fileUrl          String?   @map("file_url") @db.Text
  fileName         String?   @map("file_name") @db.VarChar(255)
  fileSizeBytes    Int?      @map("file_size_bytes")
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz
  rejectionReason  String?   @map("rejection_reason") @db.Text
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz
  statusHistory    Json      @default("[]") @map("status_history")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  college          College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student          Student      @relation(fields: [studentId], references: [id])
  requestedByStaff StaffMember  @relation("DocSubReqRequestedBy", fields: [requestedBy], references: [id])
  reviewedByStaff  StaffMember? @relation("DocSubReqReviewedBy", fields: [reviewedBy], references: [id])

  @@index([collegeId], name: "idx_docsubreq_college")
  @@index([studentId], name: "idx_docsubreq_student")
  @@index([collegeId, status], name: "idx_docsubreq_status")
  @@map("document_submission_requests")
}

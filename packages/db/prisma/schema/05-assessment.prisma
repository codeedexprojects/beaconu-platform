// ============================================================
// MODULE 5 — ASSESSMENT
// ============================================================

model AssessmentSection {
  id            String   @id @default(dbgenerated("('ASC-'::text || (nextval('assessment_section_seq'::regclass))::text)"))
  collegeId     String   @map("college_id")
  name          String   @db.VarChar(100)
  slug          String   @db.VarChar(50)
  description   String?  @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  isCoreSection Boolean  @default(true) @map("is_core_section")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college          College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  templateSections TemplateSection[]
  paperQuestions   PaperQuestion[]
  questions        Question[]
  studentAnswers   StudentAnswer[]

  @@unique([collegeId, slug], name: "uq_section_slug_college")
  @@index([collegeId], name: "idx_sections_college")
  @@index([collegeId, isActive], name: "idx_sections_active")
  @@map("assessment_sections")
}

model QuestionType {
  id             String   @id @default(dbgenerated("('QTP-'::text || (nextval('question_type_seq'::regclass))::text)"))
  collegeId      String   @map("college_id")
  name           String   @db.VarChar(100)
  slug           String   @db.VarChar(50)
  category       String   @db.VarChar(30)
  responseFormat String   @map("response_format") @db.VarChar(30)
  hasAudio       Boolean  @default(false) @map("has_audio")
  hasImage       Boolean  @default(false) @map("has_image")
  hasPassage     Boolean  @default(false) @map("has_passage")
  autoScorable   Boolean  @default(false) @map("auto_scorable")
  isSystemType   Boolean  @default(false) @map("is_system_type")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college   College    @relation(fields: [collegeId], references: [id])
  questions Question[]

  @@unique([collegeId, slug], name: "uq_qtype_slug_college")
  @@index([collegeId], name: "idx_qtypes_college")
  @@index([category], name: "idx_qtypes_category")
  @@map("question_types")
}

model Question {
  id               String   @id @default(dbgenerated("('QST-'::text || (nextval('question_seq'::regclass))::text)"))
  collegeId        String   @map("college_id")
  sectionId        String   @map("section_id")
  questionTypeId   String   @map("question_type_id")
  difficulty       String   @default("medium") @db.VarChar(10)
  title            String?  @db.VarChar(255)
  content          Json
  answerKey        Json?    @map("answer_key")
  marks            Decimal  @default(1.0) @db.Decimal(5, 2)
  negativeMarks    Decimal  @default(0) @map("negative_marks") @db.Decimal(5, 2)
  version          Int      @default(1)
  parentQuestionId String?  @map("parent_question_id")
  status           String   @default("active") @db.VarChar(20)
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college        College                 @relation(fields: [collegeId], references: [id])
  section        AssessmentSection       @relation(fields: [sectionId], references: [id])
  questionType   QuestionType            @relation(fields: [questionTypeId], references: [id])
  parentQuestion Question?               @relation("QuestionVersions", fields: [parentQuestionId], references: [id])
  childVersions  Question[]              @relation("QuestionVersions")
  courseMappings QuestionCourseMapping[]
  paperQuestions PaperQuestion[]
  studentAnswers StudentAnswer[]

  @@index([questionTypeId], name: "idx_questions_type")
  @@index([collegeId], name: "idx_questions_college")
  @@index([sectionId], name: "idx_questions_section")
  @@index([difficulty], name: "idx_questions_difficulty")
  @@index([status], name: "idx_questions_status")
  @@map("questions")
}

model QuestionCourseMapping {
  id         String @id @default(dbgenerated("('QCM-'::text || (nextval('question_course_mapping_seq'::regclass))::text)"))
  questionId String @map("question_id")
  courseId   String @map("course_id")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([questionId, courseId], name: "uq_question_course")
  @@index([questionId], name: "idx_qcm_question")
  @@index([courseId], name: "idx_qcm_course")
  @@map("question_course_mappings")
}

model AssessmentTemplate {
  id                String   @id @default(dbgenerated("('AST-'::text || (nextval('assessment_template_seq'::regclass))::text)"))
  collegeId         String   @map("college_id")
  name              String   @db.VarChar(255)
  templateType      String   @default("admission") @map("template_type") @db.VarChar(20)
  totalQuestions    Int      @map("total_questions")
  totalMarks        Decimal  @map("total_marks") @db.Decimal(7, 2)
  totalDurationMins Int      @map("total_duration_mins")
  status            String   @default("draft") @db.VarChar(20)
  instructions      Json     @default("[]")
  settings          Json     @default("{}")
  createdBy         String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college          College           @relation(fields: [collegeId], references: [id])
  templateSections TemplateSection[]
  assessmentPapers AssessmentPaper[]
  assessmentSlots  AssessmentSlot[]

  @@index([collegeId], name: "idx_templates_college")
  @@index([status], name: "idx_templates_status")
  @@map("assessment_templates")
}

model TemplateSection {
  id                     String   @id @default(dbgenerated("('TPS-'::text || (nextval('template_section_seq'::regclass))::text)"))
  templateId             String   @map("template_id")
  sectionId              String   @map("section_id")
  questionCount          Int      @map("question_count")
  timeLimitMins          Int      @map("time_limit_mins")
  sectionWeightage       Decimal? @map("section_weightage") @db.Decimal(5, 2)
  sortOrder              Int      @default(0) @map("sort_order")
  difficultyDistribution Json     @default("{}") @map("difficulty_distribution")

  // Relations
  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section  AssessmentSection  @relation(fields: [sectionId], references: [id])

  @@unique([templateId, sectionId], name: "uq_template_section")
  @@index([templateId], name: "idx_tsections_template")
  @@map("template_sections")
}

model AssessmentPaper {
  id             String    @id @default(dbgenerated("('ASP-'::text || (nextval('assessment_paper_seq'::regclass))::text)"))
  templateId     String    @map("template_id")
  paperCode      String    @unique @map("paper_code") @db.VarChar(30)
  name           String?   @db.VarChar(255)
  generationType String    @map("generation_type") @db.VarChar(10)
  status         String    @default("draft") @db.VarChar(20)
  generatedBy    String?   @map("generated_by")
  approvedBy     String?   @map("approved_by")
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  template           AssessmentTemplate  @relation(fields: [templateId], references: [id])
  paperQuestions     PaperQuestion[]
  assessmentAttempts AssessmentAttempt[]

  @@index([templateId], name: "idx_papers_template")
  @@index([status], name: "idx_papers_status")
  @@map("assessment_papers")
}

model PaperQuestion {
  id            String @id @default(dbgenerated("('PQS-'::text || (nextval('paper_question_seq'::regclass))::text)"))
  paperId       String @map("paper_id")
  questionId    String @map("question_id")
  sectionId     String @map("section_id")
  questionOrder Int    @map("question_order")

  // Relations
  paper    AssessmentPaper   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id])
  section  AssessmentSection @relation(fields: [sectionId], references: [id])

  @@unique([paperId, questionId], name: "uq_paper_question")
  @@unique([paperId, questionOrder], name: "uq_paper_order")
  @@index([paperId], name: "idx_pq_paper")
  @@index([sectionId], name: "idx_pq_section")
  @@map("paper_questions")
}

model AssessmentSlot {
  id          String   @id @default(dbgenerated("('ASL-'::text || (nextval('assessment_slot_seq'::regclass))::text)"))
  collegeId   String   @map("college_id")
  templateId  String   @map("template_id")
  slotType    String   @map("slot_type") @db.VarChar(10)
  windowStart DateTime @map("window_start") @db.Timestamptz
  windowEnd   DateTime @map("window_end") @db.Timestamptz
  maxCapacity Int?     @map("max_capacity")
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college        College                @relation(fields: [collegeId], references: [id])
  template       AssessmentTemplate     @relation(fields: [templateId], references: [id])
  attempts       AssessmentAttempt[]
  rescheduleFrom AssessmentReschedule[] @relation("RescheduleFromSlot")
  rescheduleTo   AssessmentReschedule[] @relation("RescheduleToSlot")

  @@index([collegeId], name: "idx_slots_college")
  @@index([templateId], name: "idx_slots_template")
  @@index([windowStart, windowEnd], name: "idx_slots_dates")
  @@index([status], name: "idx_slots_status")
  @@map("assessment_slots")
}

model AssessmentAttempt {
  id                  String    @id @default(dbgenerated("('AAT-'::text || (nextval('assessment_attempt_seq'::regclass))::text)"))
  applicationCourseId String    @map("application_course_id")
  studentId           String    @map("student_id")
  paperId             String    @map("paper_id")
  slotId              String    @map("slot_id")
  status              String    @default("not_started") @db.VarChar(20)
  startedAt           DateTime? @map("started_at") @db.Timestamptz
  completedAt         DateTime? @map("completed_at") @db.Timestamptz
  timeSpentSecs       Int?      @map("time_spent_secs")
  totalScore          Decimal?  @map("total_score") @db.Decimal(7, 2)
  maxScore            Decimal?  @map("max_score") @db.Decimal(7, 2)
  sectionScores       Json      @default("{}") @map("section_scores")
  antiCheatLog        Json      @default("[]") @map("anti_cheat_log")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  applicationCourse ApplicationCourse      @relation(fields: [applicationCourseId], references: [id])
  student           Student                @relation(fields: [studentId], references: [id])
  paper             AssessmentPaper        @relation(fields: [paperId], references: [id])
  slot              AssessmentSlot         @relation(fields: [slotId], references: [id])
  studentAnswers    StudentAnswer[]
  reschedules       AssessmentReschedule[]

  @@unique([applicationCourseId, studentId], name: "uq_student_attempt")
  @@index([applicationCourseId], name: "idx_attempts_app_course")
  @@index([studentId], name: "idx_attempts_student")
  @@index([paperId], name: "idx_attempts_paper")
  @@index([slotId], name: "idx_attempts_slot")
  @@index([status], name: "idx_attempts_status")
  @@map("assessment_attempts")
}

model StudentAnswer {
  id                String    @id @default(dbgenerated("('SAN-'::text || (nextval('student_answer_seq'::regclass))::text)"))
  attemptId         String    @map("attempt_id")
  questionId        String    @map("question_id")
  sectionId         String    @map("section_id")
  response          Json?
  isFlagged         Boolean   @default(false) @map("is_flagged")
  timeSpentSecs     Int       @default(0) @map("time_spent_secs")
  autoScore         Decimal?  @map("auto_score") @db.Decimal(5, 2)
  manualScore       Decimal?  @map("manual_score") @db.Decimal(5, 2)
  finalScore        Decimal?  @map("final_score") @db.Decimal(5, 2)
  evaluatedBy       String?   @map("evaluated_by")
  evaluationStatus  String    @default("pending") @map("evaluation_status") @db.VarChar(20)
  evaluationRemarks String?   @map("evaluation_remarks") @db.Text
  answeredAt        DateTime? @map("answered_at") @db.Timestamptz

  // Relations
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question  Question          @relation(fields: [questionId], references: [id])
  section   AssessmentSection @relation(fields: [sectionId], references: [id])
  evaluator StaffMember?      @relation(fields: [evaluatedBy], references: [id])

  @@unique([attemptId, questionId], name: "uq_attempt_question")
  @@index([attemptId], name: "idx_answers_attempt")
  @@index([questionId], name: "idx_answers_question")
  @@index([sectionId], name: "idx_answers_section")
  @@index([evaluationStatus], name: "idx_answers_eval")
  @@map("student_answers")
}

model AssessmentReschedule {
  id         String    @id @default(dbgenerated("('ARD-'::text || (nextval('assessment_reschedule_seq'::regclass))::text)"))
  attemptId  String    @map("attempt_id")
  studentId  String    @map("student_id")
  fromSlotId String    @map("from_slot_id")
  toSlotId   String?   @map("to_slot_id")
  reason     String    @db.Text
  status     String    @default("pending") @db.VarChar(20)
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  attempt  AssessmentAttempt @relation(fields: [attemptId], references: [id])
  student  Student           @relation(fields: [studentId], references: [id])
  fromSlot AssessmentSlot    @relation("RescheduleFromSlot", fields: [fromSlotId], references: [id])
  toSlot   AssessmentSlot?   @relation("RescheduleToSlot", fields: [toSlotId], references: [id])
  reviewer StaffMember?      @relation("ARescheduleReviewer", fields: [reviewedBy], references: [id])

  @@index([attemptId], name: "idx_reschedules_attempt")
  @@index([studentId], name: "idx_reschedules_student")
  @@map("assessment_reschedules")
}

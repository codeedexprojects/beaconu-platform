model Notification {
  id             String    @id @default(dbgenerated("('NTF-'::text || (nextval('notification_seq'::regclass))::text)"))
  recipientType  String    @map("recipient_type") @db.VarChar(20)
  recipientId    String    @map("recipient_id")
  title          String    @db.VarChar(255)
  body           String    @db.Text
  channel        String    @db.VarChar(10)
  category       String    @default("general") @db.VarChar(30)
  entityType     String?   @map("entity_type") @db.VarChar(50)
  entityId       String?   @map("entity_id")
  actionUrl      String?   @map("action_url") @db.Text
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at") @db.Timestamptz
  deliveryStatus String    @default("pending") @map("delivery_status") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([recipientType, recipientId, isRead], name: "idx_notif_recipient")
  @@index([category], name: "idx_notif_category")
  @@index([createdAt(sort: Desc)], name: "idx_notif_created")
  @@index([entityType, entityId], name: "idx_notif_entity")
  @@map("notifications")
}

model BroadcastNotification {
  id              String    @id @default(dbgenerated("('BCN-'::text || (nextval('broadcast_notification_seq'::regclass))::text)"))
  collegeId       String?   @map("college_id")
  title           String    @db.VarChar(255)
  body            String    @db.Text
  channels        Json
  targetFilters   Json      @map("target_filters")
  totalRecipients Int       @default(0) @map("total_recipients")
  sentCount       Int       @default(0) @map("sent_count")
  failedCount     Int       @default(0) @map("failed_count")
  sentByType      String    @map("sent_by_type") @db.VarChar(20)
  sentById        String    @map("sent_by_id")
  status          String    @default("draft") @db.VarChar(20)
  scheduledAt     DateTime? @map("scheduled_at") @db.Timestamptz
  sentAt          DateTime? @map("sent_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  college College? @relation(fields: [collegeId], references: [id])

  @@index([collegeId], name: "idx_broadcast_college")
  @@index([status], name: "idx_broadcast_status")
  @@index([sentAt(sort: Desc)], name: "idx_broadcast_sent")
  @@map("broadcast_notifications")
}

model Announcement {
  id          String    @id @default(dbgenerated("('ANN-'::text || (nextval('announcement_seq'::regclass))::text)"))
  collegeId   String    @map("college_id")
  title       String    @db.VarChar(255)
  content     String    @db.Text
  category    String    @default("general") @db.VarChar(30)
  isPinned    Boolean   @default(false) @map("is_pinned")
  status      String    @default("published") @db.VarChar(20)
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  requiredDocuments Json @default("[]") @map("required_documents")
  attachments Json      @default("[]")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  college College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  creator StaffMember @relation(fields: [createdBy], references: [id])

  @@index([collegeId, status], name: "idx_announce_college")
  @@index([publishedAt(sort: Desc)], name: "idx_announce_published")
  @@map("announcements")
}

// Short dated headline shown in the auto-scrolling "Updates" ticker on the
// college's public landing page (college-web) — distinct from Announcement
// above, which is the longer-form Notice Board content shown to enrolled
// students, not anonymous site visitors.
model SiteAnnouncement {
  id          String   @id @default(dbgenerated("('SAN-'::text || (nextval('site_announcement_seq'::regclass))::text)"))
  collegeId   String   @map("college_id")
  title       String   @db.VarChar(255)
  date        DateTime @db.Date
  link        String?  @db.Text
  highlighted Boolean  @default(false)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId, isActive], name: "idx_site_announce_college")
  @@index([date(sort: Desc)], name: "idx_site_announce_date")
  @@map("site_announcements")
}

model SupportTicket {
  id           String    @id @default(dbgenerated("('TKT-'::text || (nextval('support_ticket_seq'::regclass))::text)"))
  ticketNumber String    @unique @map("ticket_number") @db.VarChar(30)
  studentId    String    @map("student_id")
  collegeId    String    @map("college_id")
  subject      String    @db.VarChar(255)
  description  String    @db.Text
  category     String    @default("general") @db.VarChar(30)
  attachments  Json      @default("[]")
  assignedTo   String?   @map("assigned_to")
  status       String    @default("awaiting_response") @db.VarChar(20)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz
  closedAt     DateTime? @map("closed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  student  Student         @relation(fields: [studentId], references: [id])
  college  College         @relation(fields: [collegeId], references: [id])
  assignee StaffMember?    @relation(fields: [assignedTo], references: [id])
  messages TicketMessage[]

  @@index([studentId], name: "idx_tickets_student")
  @@index([collegeId], name: "idx_tickets_college")
  @@index([collegeId, status], name: "idx_tickets_status")
  @@index([assignedTo], name: "idx_tickets_assigned")
  @@index([ticketNumber], name: "idx_tickets_number")
  @@index([category], name: "idx_tickets_category")
  @@map("support_tickets")
}

model TicketMessage {
  id          String   @id @default(dbgenerated("('TKM-'::text || (nextval('ticket_message_seq'::regclass))::text)"))
  ticketId    String   @map("ticket_id")
  senderType  String   @map("sender_type") @db.VarChar(20)
  senderId    String?  @map("sender_id")
  message     String   @db.Text
  attachments Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt], name: "idx_tmsg_ticket")
  @@index([senderType, senderId], name: "idx_tmsg_sender")
  @@map("ticket_messages")
}

model PlatformTicket {
  id            String    @id @default(dbgenerated("('PTK-'::text || (nextval('platform_ticket_seq'::regclass))::text)"))
  ticketNumber  String    @unique @map("ticket_number") @db.VarChar(30)
  collegeId     String    @map("college_id")
  raisedBy      String    @map("raised_by")
  type          String    @default("query") @db.VarChar(20)
  subject       String    @db.VarChar(255)
  description   String    @db.Text
  phoneNumber   String?   @map("phone_number") @db.VarChar(20)
  preferredTime String?   @map("preferred_time") @db.VarChar(100)
  attachments   Json      @default("[]")
  assignedTo    String?   @map("assigned_to")
  status        String    @default("awaiting_response") @db.VarChar(20)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz
  closedAt      DateTime? @map("closed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  college  College                 @relation(fields: [collegeId], references: [id])
  raiser   StaffMember             @relation(fields: [raisedBy], references: [id])
  assignee PlatformAdmin?          @relation(fields: [assignedTo], references: [id])
  messages PlatformTicketMessage[]

  @@index([collegeId], name: "idx_ptickets_college")
  @@index([raisedBy], name: "idx_ptickets_raised_by")
  @@index([collegeId, status], name: "idx_ptickets_status")
  @@index([assignedTo], name: "idx_ptickets_assigned")
  @@index([ticketNumber], name: "idx_ptickets_number")
  @@index([type], name: "idx_ptickets_type")
  @@map("platform_tickets")
}

model PlatformTicketMessage {
  id          String   @id @default(dbgenerated("('PTM-'::text || (nextval('platform_ticket_message_seq'::regclass))::text)"))
  ticketId    String   @map("ticket_id")
  senderType  String   @map("sender_type") @db.VarChar(20)
  senderId    String?  @map("sender_id")
  message     String   @db.Text
  attachments Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket PlatformTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt], name: "idx_ptmsg_ticket")
  @@index([senderType, senderId], name: "idx_ptmsg_sender")
  @@map("platform_ticket_messages")
}

// Pre-enrollment "request a call back from this college" — any authenticated
// student, not just those already enrolled. Deliberately separate from
// SupportTicket (which is a post-enrollment, threaded query system): this is
// a single request + a staff decision, no message thread.
model CallRequest {
  id            String    @id @default(dbgenerated("('CRQ-'::text || (nextval('call_request_seq'::regclass))::text)"))
  studentId     String    @map("student_id")
  collegeId     String    @map("college_id")
  phoneNumber   String    @map("phone_number") @db.VarChar(20)
  preferredTime String?   @map("preferred_time") @db.VarChar(100)
  message       String?   @db.Text
  status        String    @default("pending") @db.VarChar(20)
  staffNote     String?   @map("staff_note") @db.Text
  respondedBy   String?   @map("responded_by")
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  student  Student      @relation(fields: [studentId], references: [id])
  college  College      @relation(fields: [collegeId], references: [id])
  responder StaffMember? @relation(fields: [respondedBy], references: [id])

  @@index([studentId], name: "idx_call_requests_student")
  @@index([collegeId], name: "idx_call_requests_college")
  @@index([collegeId, status], name: "idx_call_requests_status")
  @@map("call_requests")
}

model ChatConversation {
  id                 String    @id @default(dbgenerated("('CCV-'::text || (nextval('chat_conversation_seq'::regclass))::text)"))
  participant1Type   String    @map("participant_1_type") @db.VarChar(20)
  participant1Id     String    @map("participant_1_id")
  participant2Type   String    @map("participant_2_type") @db.VarChar(20)
  participant2Id     String    @map("participant_2_id")
  lastMessageText    String?   @map("last_message_text") @db.Text
  lastMessageAt      DateTime? @map("last_message_at") @db.Timestamptz
  participant1Unread Int       @default(0) @map("participant_1_unread")
  participant2Unread Int       @default(0) @map("participant_2_unread")
  status             String    @default("active") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  messages ChatMessage[]

  @@unique([participant1Type, participant1Id, participant2Type, participant2Id], name: "uq_conversation_pair")
  @@index([participant1Type, participant1Id], name: "idx_conv_p1")
  @@index([participant2Type, participant2Id], name: "idx_conv_p2")
  @@index([lastMessageAt(sort: Desc)], name: "idx_conv_last_msg")
  @@map("chat_conversations")
}

model ChatMessage {
  id             String    @id @default(dbgenerated("('CMG-'::text || (nextval('chat_message_seq'::regclass))::text)"))
  conversationId String    @map("conversation_id")
  senderType     String    @map("sender_type") @db.VarChar(20)
  senderId       String    @map("sender_id")
  message        String?   @db.Text
  attachments    Json      @default("[]")
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], name: "idx_cmsg_conversation")
  @@index([senderType, senderId], name: "idx_cmsg_sender")
  @@index([conversationId, isRead], name: "idx_cmsg_unread")
  @@map("chat_messages")
}

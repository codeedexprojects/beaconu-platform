// ============================================================
// MODULE 12 — BLINK
// ============================================================

model ReferralCode {
  id                 String   @id @default(dbgenerated("('RFC-'::text || (nextval('referral_code_seq'::regclass))::text)"))
  blinkUserId        String   @map("blink_user_id")
  collegeId          String   @map("college_id")
  courseId           String?  @map("course_id")
  code               String   @unique @db.VarChar(30)
  referralUrl        String?  @map("referral_url") @db.Text
  totalClicks        Int      @default(0) @map("total_clicks")
  totalRegistrations Int      @default(0) @map("total_registrations")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  blinkUser    BlinkUser     @relation(fields: [blinkUserId], references: [id])
  college      College       @relation(fields: [collegeId], references: [id])
  course       Course?       @relation(fields: [courseId], references: [id])
  referrals    Referral[]
  applications Application[]

  @@index([blinkUserId], name: "idx_refcodes_user")
  @@index([collegeId], name: "idx_refcodes_college")
  @@index([code], name: "idx_refcodes_code")
  @@map("referral_codes")
}

model Referral {
  id                  String    @id @default(dbgenerated("('RFL-'::text || (nextval('referral_seq'::regclass))::text)"))
  referralCodeId      String    @map("referral_code_id")
  blinkUserId         String    @map("blink_user_id")
  studentId           String    @map("student_id")
  applicationCourseId String?   @unique @map("application_course_id")
  status              String    @default("registered") @db.VarChar(30)
  statusHistory       Json      @default("[]") @map("status_history")
  statusUpdatedAt     DateTime? @map("status_updated_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  referralCode      ReferralCode               @relation(fields: [referralCodeId], references: [id])
  blinkUser         BlinkUser                  @relation(fields: [blinkUserId], references: [id])
  student           Student                    @relation(fields: [studentId], references: [id])
  applicationCourse ApplicationCourse?         @relation(fields: [applicationCourseId], references: [id])
  commission        Commission?
  studentWalletTxns StudentWalletTransaction[]

  @@unique([studentId, blinkUserId], name: "uq_referral_student")
  @@index([blinkUserId], name: "idx_referrals_user")
  @@index([studentId], name: "idx_referrals_student")
  @@index([status], name: "idx_referrals_status")
  @@index([referralCodeId], name: "idx_referrals_code")
  @@map("referrals")
}

model ServiceChargeConfig {
  id                 String   @id @default(dbgenerated("('SCC-'::text || (nextval('service_charge_config_seq'::regclass))::text)"))
  collegeId          String   @map("college_id")
  courseId           String   @map("course_id")
  academicYear       String   @map("academic_year") @db.VarChar(10)
  studentCategory    String   @map("student_category") @db.VarChar(50)
  grossAmount        Decimal  @map("gross_amount") @db.Decimal(10, 2)
  gstPercentage      Decimal  @default(18.00) @map("gst_percentage") @db.Decimal(5, 2)
  gstAmount          Decimal  @map("gst_amount") @db.Decimal(10, 2)
  netPayout          Decimal  @map("net_payout") @db.Decimal(10, 2)
  termsAndConditions String?  @map("terms_and_conditions") @db.Text
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college     College      @relation(fields: [collegeId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  commissions Commission[]

  @@index([collegeId], name: "idx_scc_college")
  @@index([courseId], name: "idx_scc_course")
  @@index([academicYear], name: "idx_scc_year")
  @@map("service_charge_configs")
}

model Commission {
  id              String    @id @default(dbgenerated("('CMN-'::text || (nextval('commission_seq'::regclass))::text)"))
  referralId      String    @unique @map("referral_id")
  blinkUserId     String    @map("blink_user_id")
  serviceChargeId String    @map("service_charge_id")
  grossAmount     Decimal   @map("gross_amount") @db.Decimal(10, 2)
  gstAmount       Decimal   @map("gst_amount") @db.Decimal(10, 2)
  netPayout       Decimal   @map("net_payout") @db.Decimal(10, 2)
  status          String    @default("pending") @db.VarChar(20)
  payoutDueDate   DateTime? @map("payout_due_date") @db.Date
  paidAt          DateTime? @map("paid_at") @db.Timestamptz
  approvedBy      String?   @map("approved_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  referral      Referral                 @relation(fields: [referralId], references: [id])
  blinkUser     BlinkUser                @relation(fields: [blinkUserId], references: [id])
  serviceCharge ServiceChargeConfig      @relation(fields: [serviceChargeId], references: [id])
  walletTxns    BlinkWalletTransaction[]

  @@index([blinkUserId], name: "idx_comm_user")
  @@index([status], name: "idx_comm_status")
  @@index([referralId], name: "idx_comm_referral")
  @@map("commissions")
}

model BlinkWallet {
  id             String   @id @default(dbgenerated("('BLW-'::text || (nextval('blink_wallet_seq'::regclass))::text)"))
  blinkUserId    String   @unique @map("blink_user_id")
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  totalEarned    Decimal  @default(0) @map("total_earned") @db.Decimal(12, 2)
  totalWithdrawn Decimal  @default(0) @map("total_withdrawn") @db.Decimal(12, 2)
  bankDetails    Json     @default("{}") @map("bank_details")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  blinkUser    BlinkUser                @relation(fields: [blinkUserId], references: [id])
  transactions BlinkWalletTransaction[]

  @@index([blinkUserId], name: "idx_bwallet_user")
  @@map("blink_wallets")
}

model BlinkWalletTransaction {
  id               String   @id @default(dbgenerated("('BWT-'::text || (nextval('blink_wallet_transaction_seq'::regclass))::text)"))
  walletId         String   @map("wallet_id")
  blinkUserId      String   @map("blink_user_id")
  type             String   @db.VarChar(20)
  amount           Decimal  @db.Decimal(10, 2)
  description      String?  @db.VarChar(255)
  commissionId     String?  @map("commission_id")
  withdrawalStatus String?  @map("withdrawal_status") @db.VarChar(20)
  balanceAfter     Decimal  @map("balance_after") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  wallet     BlinkWallet @relation(fields: [walletId], references: [id])
  blinkUser  BlinkUser   @relation(fields: [blinkUserId], references: [id])
  commission Commission? @relation(fields: [commissionId], references: [id])

  @@index([walletId], name: "idx_bwtxn_wallet")
  @@index([blinkUserId], name: "idx_bwtxn_user")
  @@index([type], name: "idx_bwtxn_type")
  @@index([createdAt], name: "idx_bwtxn_created")
  @@map("blink_wallet_transactions")
}

model CampusVisit {
  id                 String   @id @default(dbgenerated("('CMV-'::text || (nextval('campus_visit_seq'::regclass))::text)"))
  collegeId          String   @map("college_id")
  studentId          String   @map("student_id")
  ambassadorId       String   @map("ambassador_id")
  studentName        String   @map("student_name") @db.VarChar(255)
  courseInterest     String?  @map("course_interest") @db.VarChar(255)
  department         String?  @db.VarChar(255)
  proposedDate       DateTime @map("proposed_date") @db.Date
  proposedTime       DateTime @map("proposed_time") @db.Time
  status             String   @default("pending") @db.VarChar(20)
  reassignedFrom     String?  @map("reassigned_from")
  reassignmentReason String?  @map("reassignment_reason") @db.Text
  visitNotes         String?  @map("visit_notes") @db.Text
  visitRating        Int?     @map("visit_rating") @db.SmallInt
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college            College    @relation(fields: [collegeId], references: [id])
  student            Student    @relation(fields: [studentId], references: [id])
  ambassador         BlinkUser  @relation("AmbassadorVisits", fields: [ambassadorId], references: [id])
  previousAmbassador BlinkUser? @relation("ReassignedFrom", fields: [reassignedFrom], references: [id])
  // staffCreator: creation tracked via audit_logs; ambassadorId FK is to blink_users

  @@index([collegeId], name: "idx_visits_college")
  @@index([ambassadorId], name: "idx_visits_ambassador")
  @@index([studentId], name: "idx_visits_student")
  @@index([proposedDate], name: "idx_visits_date")
  @@index([status], name: "idx_visits_status")
  @@map("campus_visits")
}

model MediaKit {
  id            String   @id @default(dbgenerated("('MDK-'::text || (nextval('media_kit_seq'::regclass))::text)"))
  collegeId     String   @map("college_id")
  courseId      String?  @map("course_id")
  title         String   @db.VarChar(255)
  assetType     String   @map("asset_type") @db.VarChar(20)
  scope         String   @db.VarChar(20)
  fileUrl       String   @map("file_url") @db.Text
  fileName      String?  @map("file_name") @db.VarChar(255)
  fileSizeBytes Int?     @map("file_size_bytes")
  thumbnailUrl  String?  @map("thumbnail_url") @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id])

  @@index([collegeId], name: "idx_media_college")
  @@index([courseId], name: "idx_media_course")
  @@index([assetType], name: "idx_media_type")
  @@index([scope], name: "idx_media_scope")
  @@map("media_kits")
}

// ============================================================
// MODULE 3 — CONTENT & DISCOVERY
// ============================================================

model BlogAuthor {
  id           String    @id @default(dbgenerated("('BLA-'::text || (nextval('blog_author_seq'::regclass))::text)"))
  fullName     String    @map("full_name") @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.Text
  bio          String?   @db.Text
  avatarUrl    String?   @map("avatar_url") @db.Text
  status       String    @default("active") @db.VarChar(20)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([email], name: "idx_blog_authors_email")
  @@map("blog_authors")
}

model NewsAlert {
  id            String    @id @default(dbgenerated("('NWS-'::text || (nextval('news_alert_seq'::regclass))::text)"))
  title         String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(100)
  summary       String?   @db.Text
  content       String    @db.Text
  coverImageUrl String?   @map("cover_image_url") @db.Text
  tags          Json      @default("[]")
  source        String?   @db.Text
  collegeId     String?   @map("college_id")
  status        String    @default("draft") @db.VarChar(20)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  publishedBy   String?   @map("published_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college        College?       @relation(fields: [collegeId], references: [id])
  publishedAdmin PlatformAdmin? @relation(fields: [publishedBy], references: [id])

  @@index([status], name: "idx_news_status")
  @@index([collegeId], name: "idx_news_college")
  @@index([publishedAt(sort: Desc)], name: "idx_news_published")
  @@index([slug], name: "idx_news_slug")
  @@map("news_alerts")
}

model Article {
  id            String    @id @default(dbgenerated("('ART-'::text || (nextval('article_seq'::regclass))::text)"))
  title         String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(100)
  summary       String?   @db.Text
  content       String    @db.Text
  coverImageUrl String?   @map("cover_image_url") @db.Text
  tags          Json      @default("[]")
  authorName    String?   @map("author_name") @db.VarChar(100)
  authorType    String    @map("author_type") @db.VarChar(20)
  authorId      String?   @map("author_id")
  collegeId     String?   @map("college_id")
  status        String    @default("draft") @db.VarChar(20)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  viewCount     Int       @default(0) @map("view_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  college College? @relation(fields: [collegeId], references: [id])

  @@index([status], name: "idx_articles_status")
  @@index([collegeId], name: "idx_articles_college")
  @@index([publishedAt(sort: Desc)], name: "idx_articles_published")
  @@index([slug], name: "idx_articles_slug")
  @@map("articles")
}

model Blog {
  id              String    @id @default(dbgenerated("('BLG-'::text || (nextval('blog_seq'::regclass))::text)"))
  title           String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(100)
  summary         String?   @db.Text
  content         String    @db.Text
  coverImageUrl   String?   @map("cover_image_url") @db.Text
  tags            Json      @default("[]")
  authorId        String    @map("author_id")
  authorType      String    @map("author_type") @db.VarChar(20)
  authorName      String    @map("author_name") @db.VarChar(100)
  status          String    @default("pending") @db.VarChar(20)
  rejectionReason String?   @map("rejection_reason") @db.Text
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  viewCount       Int       @default(0) @map("view_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  reviewer PlatformAdmin? @relation("BlogReviewer", fields: [reviewedBy], references: [id])

  @@index([status], name: "idx_blogs_status")
  @@index([authorType, authorId], name: "idx_blogs_author")
  @@index([publishedAt(sort: Desc)], name: "idx_blogs_published")
  @@index([slug], name: "idx_blogs_slug")
  @@map("blogs")
}

model EntranceExam {
  id                String    @id @default(dbgenerated("('ENX-'::text || (nextval('entrance_exam_seq'::regclass))::text)"))
  name              String    @db.VarChar(255)
  code              String    @unique @db.VarChar(20)
  conductingBody    String?   @map("conducting_body") @db.VarChar(255)
  examLevel         String    @map("exam_level") @db.VarChar(20)
  applicableCourses Json      @default("[]") @map("applicable_courses")
  eligibility       String?   @db.Text
  description       String?   @db.Text
  registrationStart DateTime? @map("registration_start") @db.Date
  registrationEnd   DateTime? @map("registration_end") @db.Date
  examDate          DateTime? @map("exam_date") @db.Date
  resultDate        DateTime? @map("result_date") @db.Date
  officialWebsite   String?   @map("official_website") @db.Text
  status            String    @default("active") @db.VarChar(20)
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator PlatformAdmin? @relation(fields: [createdBy], references: [id])

  @@index([examLevel], name: "idx_exams_level")
  @@index([status], name: "idx_exams_status")
  @@index([examDate], name: "idx_exams_dates")
  @@index([code], name: "idx_exams_code")
  @@map("entrance_exams")
}

model Event {
  id                String    @id @default(dbgenerated("('EVT-'::text || (nextval('event_seq'::regclass))::text)"))
  title             String    @db.VarChar(255)
  slug              String    @unique @db.VarChar(100)
  description       String?   @db.Text
  coverImageUrl     String?   @map("cover_image_url") @db.Text
  category          String    @db.VarChar(30)
  speakerName       String?   @map("speaker_name") @db.VarChar(255)
  speakerTitle      String?   @map("speaker_title") @db.VarChar(255)
  organizer         String?   @db.VarChar(255)
  eventDate         DateTime  @map("event_date") @db.Date
  startTime         DateTime? @map("start_time") @db.Time
  endTime           DateTime? @map("end_time") @db.Time
  duration          String?   @db.VarChar(50)
  eventMode         String    @map("event_mode") @db.VarChar(20)
  venue             String?   @db.VarChar(255)
  onlineLink        String?   @map("online_link") @db.Text
  isFree            Boolean   @default(true) @map("is_free")
  ticketPrice       Decimal   @default(0) @map("ticket_price") @db.Decimal(10, 2)
  totalSeats        Int?      @map("total_seats")
  registeredCount   Int       @default(0) @map("registered_count")
  hasRecording      Boolean   @default(false) @map("has_recording")
  recordingUrl      String?   @map("recording_url") @db.Text
  recordingDuration String?   @map("recording_duration") @db.VarChar(20)
  recordedAt        DateTime? @map("recorded_at") @db.Date
  collegeId         String?   @map("college_id")
  status            String    @default("draft") @db.VarChar(20)
  createdByType     String?   @map("created_by_type") @db.VarChar(20)
  createdById       String?   @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  registrations EventRegistration[]

  @@index([status], name: "idx_events_status")
  @@index([eventDate], name: "idx_events_date")
  @@index([collegeId], name: "idx_events_college")
  @@index([category], name: "idx_events_category")
  @@index([eventMode], name: "idx_events_mode")
  @@index([isFree], name: "idx_events_free")
  @@index([hasRecording], name: "idx_events_recording")
  @@index([slug], name: "idx_events_slug")
  @@map("events")
}

model EventRegistration {
  id            String    @id @default(dbgenerated("('ERG-'::text || (nextval('event_registration_seq'::regclass))::text)"))
  eventId       String    @map("event_id")
  studentId     String    @map("student_id")
  paymentStatus String    @default("not_applicable") @map("payment_status") @db.VarChar(20)
  transactionId String?   @map("transaction_id")
  status        String    @default("registered") @db.VarChar(20)
  registeredAt  DateTime  @default(now()) @map("registered_at") @db.Timestamptz
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz

  // Relations
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])

  @@unique([eventId, studentId], name: "uq_event_registration")
  @@index([eventId], name: "idx_ereg_event")
  @@index([studentId], name: "idx_ereg_student")
  @@index([status], name: "idx_ereg_status")
  @@map("event_registrations")
}

model EducationLoan {
  id                   String   @id @default(dbgenerated("('EDL-'::text || (nextval('education_loan_seq'::regclass))::text)"))
  bankName             String   @map("bank_name") @db.VarChar(255)
  bankLogoUrl          String?  @map("bank_logo_url") @db.Text
  productName          String   @map("product_name") @db.VarChar(255)
  tag                  String?  @db.VarChar(100)
  interestRate         String   @map("interest_rate") @db.VarChar(100)
  interestRateMin      Decimal? @map("interest_rate_min") @db.Decimal(5, 2)
  maxAmount            String   @map("max_amount") @db.VarChar(100)
  moratorium           String   @db.VarChar(100)
  processingFee        String   @map("processing_fee") @db.VarChar(100)
  loanType             String   @map("loan_type") @db.VarChar(20)
  status               String   @default("active") @db.VarChar(20)
  sortOrder            Int      @default(0) @map("sort_order")
  processingTime       String?  @map("processing_time") @db.VarChar(100)
  margin               String?  @db.VarChar(100)
  collateralAmount     String?  @map("collateral_amount") @db.VarChar(100)
  nonCollateralAmount  String?  @map("non_collateral_amount") @db.VarChar(100)
  repaymentTenure      String?  @map("repayment_tenure") @db.VarChar(100)
  requiresCosigner     Boolean  @default(false) @map("requires_cosigner")
  description          String?  @db.Text
  expensesCovered      Json     @default("[]") @map("expenses_covered")
  eligibility          Json     @default("[]")
  eligibleCourses      String?  @map("eligible_courses") @db.Text
  documentsApplicant   Json     @default("[]") @map("documents_applicant")
  documentsCoApplicant Json     @default("[]") @map("documents_co_applicant")
  helpfulVideos        Json     @default("[]") @map("helpful_videos")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status], name: "idx_education_loans_status")
  @@index([loanType], name: "idx_education_loans_loan_type")
  @@index([sortOrder], name: "idx_education_loans_sort_order")
  @@map("education_loans")
}

model StarterGuideVideo {
  id           String   @id @default(dbgenerated("('SGV-'::text || (nextval('starter_guide_video_seq'::regclass))::text)"))
  title        String   @db.VarChar(255)
  videoKey     String   @map("video_key") @db.Text
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive], name: "idx_sgv_is_active")
  @@index([displayOrder], name: "idx_sgv_display_order")
  @@map("starter_guide_videos")
}

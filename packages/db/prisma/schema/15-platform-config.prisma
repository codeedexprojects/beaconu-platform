// ============================================================
// MODULE 15 — PLATFORM CONFIG
// ============================================================

model PlatformConfig {
  id                             String   @id @default("default") @db.VarChar(20)
  gstPercentage                  Decimal  @default(18.00) @map("gst_percentage") @db.Decimal(5, 2)
  counsellorMinWithdrawalAmount  Decimal  @default(500.00) @map("counsellor_min_withdrawal_amount") @db.Decimal(10, 2)
  updatedByAdminId               String?  @map("updated_by_admin_id")
  createdAt                      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  updatedByAdmin PlatformAdmin? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@map("platform_configs")
}

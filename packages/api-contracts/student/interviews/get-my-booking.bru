meta {
  name: Get My Interview Booking
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/student/interviews/bookings/application/{{applicationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

docs {
  Read-only. Fetches the student's own interview booking for one whole
  Application — 404 until the college schedules it (there is no
  self-service booking action anymore; the college schedules the date,
  time, panel member, and mode after the candidate reaches the interview
  stage).

  Response includes `mode`, `scheduledDate`/`startTime`/`endTime`,
  `panelMemberName`, `meetingUrl` (for "gmeet"), and `venue` (for
  "on_campus") once scheduled.
}

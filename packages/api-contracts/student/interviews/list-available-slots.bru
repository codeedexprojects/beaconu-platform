meta {
  name: List Available Interview Slots
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/student/interviews/slots?college_id={{collegeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

params:query {
  college_id: {{collegeId}}
  ~mode: gmeet
  ~scheduled_date: 2026-08-15
  ~date_from: 2026-08-15
  ~date_to: 2026-08-31
  ~page: 1
  ~limit: 20
}

docs {
  Every currently-bookable slot at a college — active, upcoming, with open
  capacity. `college_id` is required (students aren't scoped to one
  college via their session — they can apply to several). Paginated —
  response includes `meta` (page/limit/total/totalPages/hasNextPage/
  hasPreviousPage), same shape as every other paginated list in this API.

  Filters (all optional):
  - `mode` ("type"): "gmeet" | "on_campus"
  - `scheduled_date` ("date wise"): exact day, "YYYY-MM-DD" — when given,
    takes priority over `date_from`/`date_to` and matches that exact day
    only.
  - `date_from` / `date_to`: "YYYY-MM-DD", either or both — bounds the
    default "any upcoming date" range. Omitting both defaults to "today
    onward". 400 if `date_from` is after `date_to`.
  - `page` (default 1) / `limit` (default 20, max 100).

  Each slot's `campus` field (present when `mode` is "on_campus" and a
  campus was selected at creation) carries the structured address/city/
  state/pinCode/latitude/longitude — latitude/longitude are null if that
  campus was never geo-tagged.
}

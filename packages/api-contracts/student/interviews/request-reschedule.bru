meta {
  name: Request Interview Reschedule
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/student/interviews/bookings/{{interviewBookingId}}/reschedule-requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "to_slot_id": null,
    "reason": "I have a scheduling conflict at this time — requesting a later slot."
  }
}

docs {
  Requests a reschedule for the student's own booking. `to_slot_id` is
  optional — the college-admin can pick the actual new slot at review time
  if omitted.

  Only one non-rejected request per booking, ever ("only once" — a
  previously-rejected request doesn't count against this). Must be
  submitted at least 30 minutes before the slot's scheduled start time.

  409 ConflictError "You've already requested a reschedule for this
  interview". 409 "Reschedule requests must be submitted at least 30
  minutes before the interview".
}

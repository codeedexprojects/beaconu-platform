meta {
  name: Cancel My Interview Booking
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/student/interviews/bookings/{{interviewBookingId}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

docs {
  Cancels the student's own active booking — frees the slot's capacity.
  409 ConflictError "This booking is not currently active" if already
  completed/cancelled.
}

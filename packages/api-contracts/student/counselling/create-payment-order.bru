meta {
  name: Create Payment Order
  type: http
  seq: 1.5
}

post {
  url: {{baseUrl}}/api/v1/student/counselling/sessions/create-order
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{studentAccessToken}}
}

body:json {
  {
    "availability_id": "{{availabilityId}}"
  }
}

script:pre-request {
  const token = bru.getEnvVar("studentAccessToken") || bru.getEnvVar("accessToken");
  const availabilityId = bru.getEnvVar("availabilityId");
  if (!token) {
    throw new Error("studentAccessToken is not set. Run Student Verify OTP/Login first.");
  }
  bru.setEnvVar("studentAccessToken", token);
  if (!availabilityId) {
    throw new Error("availabilityId is not set. Run List Available Slots first and pick a slot id from time_slots array.");
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.order_id) {
      bru.setEnvVar("razorpayOrderId", data.data.order_id);
    }
  }
}

docs {
  Creates a Razorpay order for booking a counselling slot.

  ## Flow
  1. Call this endpoint with `availability_id`.
  2. If `payment_required` is false, the slot is free — skip Razorpay
     and call Book Session directly.
  3. If `payment_required` is true, open Razorpay Checkout on the
     client using `order_id`, `amount`, `currency`, and the public
     Razorpay key from app config (NEXT_PUBLIC_RAZORPAY_KEY_ID /
     mobile equivalent) — not returned by this endpoint.
  4. After payment succeeds, Razorpay sends a `payment.captured`
     webhook to POST /api/v1/webhooks/counselling/razorpay, which marks
     the order as paid server-side (keyed by availability_id + student_id
     from the order notes).
  5. Call Book Session with just `availability_id` — it checks the
     paid marker set by the webhook.
}

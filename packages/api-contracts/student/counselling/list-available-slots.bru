meta {
  name: List Available Slots
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/student/counselling/slots
  body: none
  auth: none
}

params:query {
  counsellor_id: {{counsellorId}}
  from_date: 2026-06-01
  to_date: 2026-06-30
  page: 1
  limit: 20
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (Array.isArray(data.data) && data.data.length > 0 && data.data[0].id) {
      bru.setEnvVar("availabilityId", data.data[0].id);
    }
  }
}

docs {
  Lists unbooked counselling slots with optional counsellor/date filters.
  Requires: student access token.
}

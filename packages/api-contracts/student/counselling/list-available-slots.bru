meta {
  name: List Available Slots
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/student/counselling/slots
  body: none
  auth: none
}

params:query {
  counsellor_id: {{counsellorId}}
  from_date: 2026-06-01
  to_date: 2026-06-30
  page: 1
  limit: 20
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

script:pre-request {
  const token = bru.getEnvVar("studentAccessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("studentAccessToken is not set. Run Student Verify OTP/Login first.");
  }
  bru.setEnvVar("studentAccessToken", token);
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    // Response is grouped by date: data.data[0].time_slots[0].id
    if (Array.isArray(data.data) && data.data.length > 0) {
      const firstDate = data.data[0];
      if (firstDate.time_slots && firstDate.time_slots.length > 0) {
        bru.setEnvVar("availabilityId", firstDate.time_slots[0].id);
      }
    }
  }
}

docs {
  Lists unbooked counselling slots grouped by date with available time slots.
  Requires: student access token.

  ## Response structure
  data: [
    {
      "date": "2026-06-12",
      "counsellor": {
        "id": "CNS-1",
        "full_name": "Dr. Meera Kapoor",
        "counsellor_type": "academic",
        "rating": 4.5,
        "known_languages": "English, Hindi",
        "session_fee": 499
      },
      "time_slots": [
        {
          "id": "CNA-4",
          "start_time": "10:00:00.000Z",
          "end_time": "10:45:00.000Z",
          "session_duration_mins": 45,
          "session_fee": 499,
          "is_booked": false
        }
      ]
    }
  ]

  ## Session modes supported for booking
  - voice_call
  - video_call
}

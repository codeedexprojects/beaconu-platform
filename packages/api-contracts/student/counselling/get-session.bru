meta {
  name: Get Session
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/student/counselling/sessions/{{sessionId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

script:pre-request {
  const token = bru.getEnvVar("studentAccessToken") || bru.getEnvVar("accessToken");
  const sessionId = bru.getEnvVar("sessionId");
  if (!token) {
    throw new Error("studentAccessToken is not set. Run Student Verify OTP/Login first.");
  }
  bru.setEnvVar("studentAccessToken", token);
  if (!sessionId) {
    throw new Error("sessionId is not set. Run Book Session or List Sessions first.");
  }
}

docs {
  Returns one counselling session owned by the logged-in student.
  Requires: student access token.

  ## Response keys are snake_case
  Includes: session_mode, session_type, scheduled_date, session_fee,
  payment_status, booking_reason, and nested student/counsellor objects.
}

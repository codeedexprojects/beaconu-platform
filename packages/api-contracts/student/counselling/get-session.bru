meta {
  name: Get Session
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/student/counselling/sessions/{{sessionId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:pre-request {
  const sessionId = bru.getEnvVar("sessionId");
  if (!sessionId) {
    throw new Error("sessionId is not set. Run List Sessions first.");
  }
}

docs {
  Returns one counselling session owned by the logged-in student.
  Requires: student access token.
}

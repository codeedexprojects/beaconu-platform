meta {
  name: List Sessions
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/student/counselling/sessions
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
  date: 2026-06-08
  status:
  search:
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

script:pre-request {
  const token = bru.getEnvVar("studentAccessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("studentAccessToken is not set. Run Student Verify OTP/Login first.");
  }
  bru.setEnvVar("studentAccessToken", token);
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (Array.isArray(data.data) && data.data.length > 0 && data.data[0].id) {
      bru.setEnvVar("sessionId", data.data[0].id);
    }
  }
}

docs {
  Lists counselling sessions for logged-in student, ordered by scheduled date.
  Requires: student access token.

  ## Optional filters
  - date: YYYY-MM-DD (exact scheduled date)
  - status: booked | completed | cancelled
  - search: counsellor name/email, booking reason, session type/mode

  ## Response keys are snake_case
  Example fields:
  - session_mode, session_type, scheduled_date
  - booking_reason, session_fee, payment_status
  - student.full_name, counsellor.full_name

  ## Date-wise behavior
  - Without `date`: sessions are returned date-wise (latest date first).
  - With `date`: only sessions from that exact date are returned.
}

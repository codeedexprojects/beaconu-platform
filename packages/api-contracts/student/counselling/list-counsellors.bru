meta {
  name: List Counsellors
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/student/counselling/counsellors
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  ~date: 2026-06-10
  ~counsellor_type: academic
  ~language: English
  ~page: 1
  ~limit: 20
}

docs {
  ## Query params
  - date            : YYYY-MM-DD — only counsellors with a free slot on this date
  - counsellor_type : "academic" | "mindcare"
  - language        : matches against counsellor's known_languages
                       (case-insensitive substring match, e.g. "Hindi")
  - page, limit     : pagination
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0] && data.data[0].id) {
      bru.setEnvVar("counsellorId", data.data[0].id);
    }
  }
}

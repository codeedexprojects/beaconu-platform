meta {
  name: List Commute Payments
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/student/commute/payments?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

params:query {
  page: 1
  limit: 20
}

docs {
  Backs the "Payment History" screen. Paginated commute_fee ledger entries
  for the student, newest first — each with its period ("YYYY-MM"), amount,
  status, and its latest transaction's paidAt.

  `id` is the StudentFeeLedger entry's id — use `transactionId` (the
  latest Transaction row's id, null if no transaction exists yet) to look
  up the invoice via `GET /payments/receipts/by-transaction/:transactionId`.
}

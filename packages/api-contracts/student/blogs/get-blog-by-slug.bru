meta {
  name: Get Blog By Slug
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/student/blogs/:slug
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:path {
  slug: my-college-experience
}

headers {
  Content-Type: application/json
}

docs {
  Get a published blog by its slug. Requires student authentication.
  Each request increments the blog's view count.
  Returns 404 if the blog is not found or not yet approved.
}

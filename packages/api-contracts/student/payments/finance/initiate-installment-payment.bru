meta {
  name: Initiate Installment Payment
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/student/payments/finance/installments/{{installmentLedgerId}}/pay/initiate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("courseFeeTransactionId", data.data.id);
    }
  }
}

docs {
  Pays one specific installment (identified by its ledgerEntryId from
  Setup/List Installments), not the whole fee.
}

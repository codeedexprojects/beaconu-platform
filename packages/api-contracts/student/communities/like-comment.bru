meta {
  name: Like Comment
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/student/communities/{{communityId}}/posts/{{communityPostId}}/comments/{{communityCommentId}}/like
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  communityId: CMT-1
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("communityCommentId", data.data.id);
    }
  }
}

docs {
  Toggles like on a comment (like if not liked, unlike if already liked).
  Set communityId, communityPostId, and communityCommentId env vars before calling.

  Response includes:
    - likeCount  (Int)     — updated like count after toggle
    - isLiked    — derive from list-posts response; this endpoint returns the updated comment row
}

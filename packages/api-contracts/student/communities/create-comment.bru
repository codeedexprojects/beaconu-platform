meta {
  name: Create Comment
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/student/communities/{{communityId}}/posts/{{communityPostId}}/comments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "content": "Thanks for sharing this update."
  }
}

vars:pre-request {
  communityId: CMT-1
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("communityCommentId", data.data.id);
    }
  }
}

docs {
  Adds a comment to a community post.
  Set communityId and communityPostId env vars before calling.

  Response:
  {
    "success": true,
    "message": "Comment created",
    "data": {
      "id": "CCT-1",
      "postId": "CPT-1",
      "authorId": "STU-1",
      "authorType": "student",
      "parentCommentId": null,
      "content": "Thanks for sharing this update.",
      "likeCount": 0,
      "status": "active",
      "createdAt": "2026-06-08T12:13:43.280Z",
      "updatedAt": "2026-06-08T12:13:48.644Z",
      "replies": [],
      "authorName": "Rahul Sharma",
      "authorAvatarUrl": null,
      "currentUserVote": null,
      "isLiked": false,
      "isDisliked": false,
      "isOwnComment": true
    },
    "timestamp": "2026-06-08T12:13:48.644Z"
  }
}

meta {
  name: Share Post
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/student/communities/{{communityId}}/posts/{{communityPostId}}/share
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  communityId: CMT-1
}

docs {
  Increments share count for a community post.
  Set communityId and communityPostId env vars before calling.
}

meta {
  name: List Communities
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/student/communities
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

query {
  page: 1
  limit: 10
}

headers {
  Content-Type: application/json
}

docs {
  Lists active communities for students.
  Requires login token from student auth.
}

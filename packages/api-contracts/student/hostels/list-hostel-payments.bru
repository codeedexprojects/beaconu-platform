meta {
  name: List Hostel Payments
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/student/hostels/payments?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

params:query {
  page: 1
  limit: 20
}

docs {
  Payment history of hostel_booking_fee ledger entries (one per booking
  attempt), newest first — each with its feeCategory, roomTypeId, amount
  (admission fee + security deposit combined), status, and latest
  transaction's paidAt.

  `id` is the StudentFeeLedger entry's id — use `transactionId` (the
  latest Transaction row's id, null if no transaction exists yet) to look
  up the invoice via `GET /payments/receipts/by-transaction/:transactionId`.
}

meta {
  name: Initiate Hostel Booking
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/student/hostels/booking/initiate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

body:json {
  {
    "room_type_id": "{{hostelRoomTypeId}}",
    "room_plan_type": "monthly",
    "mess_plan_id": "",
    "dietary_preference": "vegetarian",
    "selected_addons": []
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("hostelTransactionId", data.data.id);
    }
  }
}

docs {
  Creates a single payment order for the room type's admission fee +
  security deposit combined (feeCategory "hostel_booking_fee") — one
  payment covers the whole booking, no separate application-fee step.

  Body:
  - room_type_id: required
  - room_plan_type: "monthly" | "annual"
  - mess_plan_id, dietary_preference, selected_addons: optional — the full
    booking configuration, since confirming this payment immediately
    creates the HostelEnrollment (see confirm-booking.bru), so it all
    needs to be known up front.

  409 ConflictError "You already have an active hostel enrollment" if one
  exists already.
}

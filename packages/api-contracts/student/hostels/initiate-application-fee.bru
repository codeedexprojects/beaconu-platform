meta {
  name: Initiate Hostel Application Fee
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/student/hostels/room-types/{{hostelRoomTypeId}}/application-fee/initiate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("hostelTransactionId", data.data.id);
    }
  }
}

docs {
  Creates a payment order for a room type's admission ("application") fee —
  same Transaction/StudentFeeLedger/PaymentProvider mechanism as every
  other fee in this codebase, feeCategory "hostel_application_fee".

  403 ForbiddenError "You are not enrolled at this college" if the student
  has no real Enrollment at the hostel's college (see docs/context.md §11 —
  hostel is a post-admission Student Hub benefit).

  Idempotent while a "pending" transaction already exists for this room
  type — calling again returns that same transaction.
}

meta {
  name: Get Event Detail
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/student/events/{{eventId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{studentAccessToken}}
}

docs {
  Get full details of a specific event by ID. Student auth required.
  Returns all event fields including description, online_link, recording info,
  is_joined, and is_youtube_video.
}

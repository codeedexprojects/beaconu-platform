meta {
  name: List My Document Requests
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/student/documents/requests
  body: none
  auth: none
}

query {
  ~status: submitted
  ~search: bonafide
  page: 1
  limit: 20
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  search (optional): case-insensitive match against document name,
  description, or request number (e.g. "bonafide", "DOC-A1B2C3D4").
}

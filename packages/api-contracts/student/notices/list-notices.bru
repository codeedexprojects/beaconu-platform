meta {
  name: List Notices
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/student/notices?college_id={{collegeId}}&page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  college_id: {{collegeId}}
  page: 1
  limit: 20
  status:
  category:
  search:
  from_date:
  to_date:
}

auth:bearer {
  token: {{studentAccessToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.notices && data.data.notices[0]) {
      bru.setEnvVar("noticeId", data.data.notices[0].id);
    }
  }
}

docs {
  "Latest Notices" list — defaults to status=published (pinned first, then
  newest-published first). Pass status=archived for "View Archived
  Notices". Optional: category, search (title/content).

  Date-wise filter (backs "Filter by Date"): from_date / to_date (ISO
  date, e.g. "2026-11-01"), both optional, inclusive, filtered against
  publishedAt. Pass either alone for an open-ended range, or both for a
  bounded range. 400 ValidationError if from_date is after to_date.

  403 ForbiddenError if the student has no active enrollment at
  college_id.
}

meta {
  name: Record Anti-Cheat Event
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/student/assessments/attempts/{{assessmentAttemptId}}/anti-cheat-events
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "type": "tab_hidden"
  }
}

docs {
  Client fires this on visibilitychange (type: "tab_hidden" /
  "tab_visible"). The auto-submit job checks every minute: if the latest
  logged event is "tab_hidden" for more than 10 seconds with no later
  "tab_visible", the attempt is terminated (disqualified).
}

meta {
  name: Get Attempt Overview
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/student/assessments/attempts/{{assessmentAttemptId}}/overview?section_id={{assessmentSectionIdVerbal}}
  body: none
  auth: none
}

params:query {
  section_id: {{assessmentSectionIdVerbal}}
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Overview screen: per-section progress — answered_count, flagged_count,
  and an ordered questions[] list ({question_order, question_id,
  is_answered, is_flagged}) for building the Question Map. "Not visited"
  vs "skipped" isn't returned by the server — that's the client's own
  navigation history (which questions it has rendered this session)
  combined with this answered/flagged truth, same as any exam app.
  "Submit Test" on this screen is a client-side navigation action (back
  to the section list); the actual whole-attempt submission is
  Submit Attempt, called once every section is complete.
}

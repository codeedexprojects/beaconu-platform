meta {
  name: Begin Attempt
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/student/assessments/attempts/{{assessmentAttemptId}}/begin
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Starts the timer: "not_started" -> "in_progress", sets started_at and
  last_activity_at. Kept separate from Start Attempt so the instructions
  screen (Get Assessment Start Info) and the actual clock-start are
  distinct actions.
}

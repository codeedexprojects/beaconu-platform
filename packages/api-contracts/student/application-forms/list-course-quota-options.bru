meta {
  name: List Course Quota Options (Student)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/student/application-forms/{{admissionCycleId}}/courses/{{courseId}}/quota-options
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

docs {
  Browse the fee-adjusted quota options for a course on this application
  form, before committing to a selection. Returns the base application fee
  plus each active quota's computed fee (base + CourseQuota's bidirectional
  appFeeAdjustmentType/Value — positive surcharges e.g. NRI, negative
  discounts) and seat availability. Does not require a draft application to
  already exist — purely for browsing/comparison.
}

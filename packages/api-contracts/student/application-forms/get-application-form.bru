meta {
  name: Get Application Form (Student)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/student/application-forms/{{admissionCycleId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

docs {
  Fetches a single open application form by id. Returns 404 if it doesn't
  exist or isn't currently open (e.g. archived/closed).
}

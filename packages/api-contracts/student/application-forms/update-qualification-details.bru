meta {
  name: Update Qualification Details (Student)
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/student/application-forms/my-applications/{{applicationId}}/qualification-details
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{studentAccessToken}}
}

body:json {
  {
    "qualifications": [
      {
        "level": "12th",
        "board_or_university": "CBSE",
        "institution_name": "DPS Bangalore",
        "year_of_passing": 2024,
        "percentage_or_cgpa": 92.5,
        "subjects": "PCB"
      }
    ]
  }
}

docs {
  LEGACY flat shape — superseded by the three level-specific screens
  (10th Grade / 12th Grade / Undergraduate, see
  "Update Tenth Grade Details" etc.), kept only for old draft data /
  backward compatibility. New clients should use those three endpoints
  instead, which merge into the same Student.qualificationDetails column
  under their own keys rather than overwriting it wholesale like this one
  does — calling this after using the new endpoints will wipe out
  tenth_grade/twelfth_grade/undergraduate data.

  Full-replace write of the qualification-details step (409 if already
  submitted). At least one qualification entry is required. Advances
  currentStep to at least 6. Lands on the Student profile, not this
  Application row — see Update Personal Details' docs for why.
}

meta {
  name: List My Applications For Cycle (Student)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/student/application-forms/{{admissionCycleId}}/application
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

docs {
  Lists every Application the authenticated student has for this admission
  cycle (draft or submitted). A student can now have several — one per
  course, each a fully separate Application — as long as no two active
  (non-withdrawn) course selections across all of them target the same
  course. Empty array if they haven't started any yet.

  Each nested action (personal-details, documents, declaration, submit,
  etc.) is addressed via its own applicationId under
  /application-forms/my-applications/{{applicationId}}/... — use this list
  to find the applicationId for whichever application you want to act on.
}

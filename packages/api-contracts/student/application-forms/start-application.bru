meta {
  name: Start Application (Student)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/student/application-forms/{{admissionCycleId}}/application
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{studentAccessToken}}
}

body:json {
  {
    "nationality": "Indian",
    "course_id": "{{courseId}}",
    "state_of_domicile": "Karnataka",
    "passport_country": null,
    "passport_number": null,
    "campus_id": null
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("applicationId", data.data.id);
    }
  }
}

docs {
  Creates a draft Application for the authenticated student against this
  admission cycle (404 if the cycle doesn't exist, 409 if it's not
  currently "open"). Idempotent: calling this again for the same
  student+cycle returns the existing draft instead of erroring, since
  (studentId, admissionCycleId) is unique.

  `nationality` is required and drives NRI-style application-fee surcharges
  applied on the primary course's fee. `course_id` is REQUIRED — this
  becomes the application's primary course, and its fee is what payment
  gates before the rest of the flow (details, documents, declaration,
  submit) unlocks. No quota is set here — the primary course starts
  quota-less, same as every other course; use Change Application Course
  Quota afterward if a quota applies. `state_of_domicile` /
  `passport_country` / `passport_number` are optional, relevant mainly for
  foreign-nationality applicants. `campus_id` is optional and must belong
  to the cycle's college if given.

  Typical next steps: browse List Course Catalogue (courses + their quota
  options in one call) to add more courses or pick a quota via Change
  Application Course Quota, then POST
  /payments/applications/{{applicationId}}/initiate to pay — nothing else
  on the application unlocks until that payment is confirmed.
}

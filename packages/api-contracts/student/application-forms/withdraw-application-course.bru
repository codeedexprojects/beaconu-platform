meta {
  name: Withdraw Application Course (Student)
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/api/v1/student/application-forms/{{admissionCycleId}}/application/courses/{{applicationCourseId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

docs {
  Withdraws a NON-primary course selection from the student's own draft
  application (soft — sets status to "withdrawn", never a hard delete, so
  the fee history survives). Recomputes the parent Application's
  totalApplicationFee. 409 if the application has already been submitted,
  if payment has been initiated/completed (courses lock the instant an
  order exists, not just once paid), or if the target is the primary
  course — the one set at Start Application can never be withdrawn
  (though its quota can still be changed — see Change Course Quota).
}

meta {
  name: Get Admission Cycle Status (Student)
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/api/v1/student/application-forms/{{admissionCycleId}}/application/status
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

params:query {
  ~application_id: {{applicationId}}
}

docs {
  Onboarding-process status — application progress, assessment, interview,
  and token/offer amount details, all in one call — one entry per
  Application the student has here (there can be several now, one per
  course, see Start Application). Courses and documents are NOT part of
  this response — courses live on the application form itself (Get
  Application Details), and documents have their own dedicated endpoint
  (Get Required Documents).

  Optional query param `application_id` narrows the result to that one
  Application (still returned as a 1-item array, same shape) — useful once
  the student has several applications under this cycle and only one is
  needed. Omit it to get every application under this cycle, as before.

  `data` is `null` if the student hasn't started any application for this
  admission cycle yet. Otherwise an array, each entry shaped:

  {
    application: {
      applicationId, applicationNumber,
      collegeId, collegeName,
      admissionCycleId, admissionCycleName,
      formStatus, feePaymentStatus,
      pendingAction: "payment" | "personal_details" | "family_details"
                   | "address_details" | "qualification_details"
                   | "entrance_exam_details" | "declaration" | "submit" | "none",
      // Full per-screen breakdown — see get-application-status-all.bru's
      // docs for the complete key list/ordering and status semantics.
      formSteps: [{ key, label, status: "completed"|"current"|"pending" }, ...],
      createdAt
    },

    // One assessment attempt covers the WHOLE application (every course
    // on it), not one per course — see Plan R.
    assessment: {
      status: "not_required" | "not_started" | "in_progress" | "completed"
            | "auto_submitted" | "terminated" | "under_evaluation"
            | "evaluated" | "result_published",
      attemptId, startedAt, completedAt, totalScore, maxScore
    },

    // Whole-application, not per-course — one shared InterviewBooking
    // covers every course on the application.
    interview: {
      status: "not_scheduled" | "booked" | "completed" | "cancelled" | "rescheduled",
      scheduledAt, completedAt, outcome, score, remarks
    },

    // isShortlisted is true if ANY non-withdrawn course on this
    // application has reached "shortlisted" or later
    // (offer_issued/token_paid/enrolled). `courses` lists exactly which
    // ones — only the courses that reached that stage (a student could be
    // shortlisted for one course but not another on the same
    // application), empty array when isShortlisted is false.
    shortlist: {
      isShortlisted,
      courses: [
        { courseId, courseName, courseCode, status }, ...
      ]
    },

    // Every scholarship application submitted against this Application
    // (a student can apply to multiple different scholarships for the
    // same application) — empty array if none applied yet.
    scholarships: [
      { scholarshipApplicationId, scholarshipConfigId, scholarshipName,
        status: "pending" | "approved" | "rejected" }, ...
    ],

    // Still per-course under the hood (resolved off the primary course's
    // offer letter) — shortlisting/offers can genuinely differ per course
    // on one application, unlike assessment/interview.
    amountDetails: {
      status: "not_issued" | "issued" | "expired" | "withdrawn",
      // The shortlisted ApplicationCourse this amountDetails describes —
      // null until at least one course is shortlisted. Use this to call
      // the token payment endpoints (.../payments/courses/{applicationCourseId}/token/initiate|confirm).
      applicationCourseId,
      offerNumber, tokenAmount, tokenPaymentStatus, validUntil,
      // documentUrl is only non-null once tokenPaymentStatus === "paid" —
      // before that the student can see the offer's amount/status but not
      // download the letter itself.
      documentUrl,
      // Which token-fee payment methods are available for this admission
      // cycle — college-admin config on the Application Form
      // (token_online_payment_enabled / token_offline_payment_enabled).
      // Both default to true; use this to show/hide the online (Razorpay)
      // vs offline (demand draft / bank transfer) payment options.
      paymentMethods: { online: true, offline: true }
    },
    // "not_enrolled" until a course reaches Enrollment (College Admin >
    // Applications > Mark Enrolled, only possible once token_paid), else
    // the Enrollment row's own status: active|on_leave|suspended|
    // completed|withdrawn|course_switched.
    enrollmentStatus: "not_enrolled" | string
  }

  pendingAction — the single next thing to do for this application, not a
  list of everything remaining:
  - primary course's fee not yet paid -> "payment"
  - paid, still draft -> the first incomplete step's name (e.g.
    "qualification_details"), derived cheaply from the application's
    currentStep (never re-checks whether an earlier step was actually
    filled in)
  - paid, currentStep past declaration -> "submit" (ready to call Submit
    Application)
  - formStatus "submitted" -> "none"

  `amountDetails` shows "not_issued" until a course is shortlisted —
  shortlisting a course (College Admin > Interviews > Shortlist &amp; Issue
  Offer Letter) now issues the OfferLetter in the same action, so
  `amountDetails` reflects real offer data ("issued") from that point on.

  `amountDetails.tokenAmount` and `amountDetails.applicationCourseId` are
  the exception — even with status "not_issued", they're populated as
  soon as a course is shortlisted: resolved off the primary course if it's
  the shortlisted one, else the first shortlisted course found.
  `tokenAmount` here is a preview of what the student will owe (from that
  course's admission-form config, Attach Course to Application Form's
  `token_amount`), not a real offer amount yet — both fields stay `null`
  until at least one course is shortlisted.
}

meta {
  name: Update Achievements Details (Student)
  type: http
  seq: 24
}

patch {
  url: {{baseUrl}}/api/v1/student/application-forms/my-applications/{{applicationId}}/achievements-details
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{studentAccessToken}}
}

body:json {
  {
    "internships": [

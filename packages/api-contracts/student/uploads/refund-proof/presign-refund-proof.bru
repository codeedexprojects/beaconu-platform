meta {
  name: Presign Refund Proof Upload
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/student/uploads/refund-proof/presign
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "mimeType": "image/jpeg",
    "fileSizeBytes": 204800
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.key) {
      bru.setEnvVar("refundProofUploadKey", data.data.key);
      bru.setEnvVar("refundProofUploadUrl", data.data.uploadUrl);
    }
  }
}

docs {
  Step 1 of 2 — Request a pre-signed PUT URL to upload optional proof
  (screenshot, recording, etc.) for a counselling refund request.

  After receiving the response:
  1. PUT the file binary to `uploadUrl` with the matching Content-Type header
  2. Call verify-refund-proof with the returned `key`
  3. Pass the resulting `permanentUrl` as `proof_url` in Request Refund

  Body:
  - mimeType (required): image/jpeg | image/png | image/webp | application/pdf
  - fileSizeBytes (required): file size in bytes, max 10 MB (10485760)

  Response:
  - uploadUrl: pre-signed S3 PUT URL, valid for 5 minutes
  - key: S3 object key — pass this to the verify endpoint
  - expiresIn: 300 (seconds)
}

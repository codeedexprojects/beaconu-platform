meta {
  name: Verify Refund Proof Upload
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/student/uploads/refund-proof/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "key": "{{refundProofUploadKey}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.permanentUrl) {
      bru.setEnvVar("refundProofUrl", data.data.permanentUrl);
    }
  }
}

docs {
  Step 3 of 3 — Confirm the proof file was successfully uploaded to S3.

  Saves `permanentUrl` to {{refundProofUrl}} for use as `proof_url` in
  Request Refund.

  Body:
  - key (required): the S3 key returned by presign-refund-proof

  Response:
  - verified: true
  - permanentUrl: permanent public S3 URL
  - viewUrl: signed URL valid for 1 hour
}

meta {
  name: List Shorts (Student)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/student/shorts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

params:query {
  ~page: 1
  ~limit: 20
}

docs {
  Lists active shorts for the student-facing feed, paginated. Requires
  student authentication.

  Each item includes id, title, thumbnailUrl, videoUrl, displayOrder.
  Response includes `meta` (page, limit, total, totalPages, hasNextPage,
  hasPreviousPage) alongside `data`. Inactive shorts are never returned.
}

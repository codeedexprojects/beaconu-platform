meta {
  name: Resend OTP
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/student/auth/resend-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone_number": "9876543210",
    "phone_country_code": "+91"
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.devOtp) {
      bru.setEnvVar("studentOtp", data.data.devOtp);
    }
  }
}

docs {
  Resend OTP to the student's phone number. Replaces the previous OTP.
  New OTP expires in 5 minutes. In dev mode, updates {{studentOtp}} automatically.
}

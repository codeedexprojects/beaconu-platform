meta {
  name: Refresh Token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/student/auth/refresh-token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{studentRefreshToken}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data) {
      if (data.data.accessToken) {
        bru.setEnvVar("accessToken", data.data.accessToken);
      }
      if (data.data.refreshToken) {
        bru.setEnvVar("studentRefreshToken", data.data.refreshToken);
      }
    }
  }
}

docs {
  Exchange a valid refresh token for a new access token + rotated refresh token.

  Web: refresh token is read from the httpOnly cookie automatically.
  Mobile: pass refreshToken in the request body.

  Both old refresh token is invalidated and a new one is issued (token rotation).
  The new refresh token is set as an httpOnly cookie AND returned in the response body.

  Response:
  - accessToken: new JWT access token (15 min)
  - refreshToken: new refresh token (90 days) — replaces the one sent in the request
}

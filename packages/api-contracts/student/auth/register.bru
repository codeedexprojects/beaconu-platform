meta {
  name: Register
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/student/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "Rahul Sharma",
    "email": "rahul.sharma@example.com",
    "phone_number": "9876543210",
    "phone_country_code": "+91",
    "registration_token": "{{studentRegistrationToken}}",
    "fcm_token": "{{studentFcmToken}}"
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data) {
      if (data.data.accessToken) {
        bru.setEnvVar("accessToken", data.data.accessToken);
      }
      if (data.data.refreshToken) {
        bru.setEnvVar("studentRefreshToken", data.data.refreshToken);
      }
      if (data.data.user && data.data.user.id) {
        bru.setEnvVar("studentId", data.data.user.id);
      }
    }
  }
}

docs {
  Register a new student using the registration_token obtained from verify-otp.
  Creates the student account, logs them in, and returns tokens.

  Body:
  - full_name (required): Student's full name
  - email (optional): Student's email address
  - phone_number (required): Must match the phone used during OTP flow
  - phone_country_code (optional): Defaults to +91
  - registration_token (required): Token from verify-otp response (valid 10 min)
  - fcm_token (optional): Firebase Cloud Messaging token for push notifications (mobile only)

  Response:
  - accessToken: JWT access token (15 min)
  - refreshToken: long-lived token (90 days) — also set as httpOnly cookie
  - user: { id, fullName, email, avatarUrl }
}

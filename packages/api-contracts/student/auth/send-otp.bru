meta {
  name: Send OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/student/auth/send-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone_number": "8137821636",
    "phone_country_code": "+91"
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.devOtp) {
      bru.setEnvVar("studentOtp", data.data.devOtp);
    }
  }
}

docs {
  Send a 4-digit OTP to the student's phone number. OTP expires in 5 minutes.
  
  In development (NODE_ENV != production), the response includes `devOtp` which
  is auto-captured into the `studentOtp` env var for use in verify-otp.
  
  Body:
  - phone_number (required): 10-15 digit phone number
  - phone_country_code (optional): Country code, defaults to +91
}

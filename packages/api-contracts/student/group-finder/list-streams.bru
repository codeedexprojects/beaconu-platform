meta {
  name: List Streams & Disciplines (Group Finder)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/student/group-finder/streams
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

docs {
  Global "Program/Major" dropdown for the Group Finder "Who's coming?"
  screen (e.g. "Computer Science Engineering") — returns Streams, each
  with its nested active Disciplines. Use a discipline's `id` as
  `discipline_id` in Match Group.
}

meta {
  name: List My Scholarship Applications
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/student/scholarships/applications
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

docs {
  Every scholarship application the student has ever submitted, across
  every course/application, newest first.
}

meta {
  name: Get Wallet Transactions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/student/beaconu-card/transactions?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentAccessToken}}
}

params:query {
  page: 1
  limit: 20
  ~type: credit
}

docs {
  Paginated BeaconU Card ledger for the authenticated student, newest first.

  Query params (all optional):
    type  — credit | debit
    page  — default 1
    limit — default 20, max 100

  Each row: id, type, amount, description, withdrawalStatus, balanceAfter,
  createdAt, plus `referral` — non-null only on referral credits, carrying
  referredStudentName, baseAmount and percentage so the app can explain how
  the amount was derived without a second call.

  Pagination meta is in the response `meta` field.

  Table: student_wallet_transactions
}

meta {
  name: Activate Video Testimonial
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/admin/video-testimonials/{{videoTestimonialId}}/activate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Re-activates a previously deactivated video testimonial. Requires
  platform_admin auth + content.manage. 403 if already active.
}

meta {
  name: Get Video Testimonial
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/video-testimonials/{{videoTestimonialId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Fetches a single video testimonial by id. Requires platform_admin auth
  + content.view. 404 if not found.
}

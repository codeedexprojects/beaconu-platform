meta {
  name: Deactivate Video Testimonial
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/admin/video-testimonials/{{videoTestimonialId}}/deactivate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft-deactivates a video testimonial (isActive: false) — never
  hard-deleted. Requires platform_admin auth + content.manage. 403 if
  already inactive.
}

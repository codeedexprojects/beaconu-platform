meta {
  name: Create Admin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/platform-admins
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "fullName": "Sub Admin Test",
    "email": "subadmin@beaconu.com",
    "password": "Password123!",
    "platformRoleId": "{{platformRoleId}}"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("platformAdminId", data.data.id);
    }
  }
}

docs {
  Creates a new platform administrator (can be a sub-admin depending on the roleId).
  Requires: super admin access token.

  Saves platformAdminId to env.
  Table: platform_admins
}

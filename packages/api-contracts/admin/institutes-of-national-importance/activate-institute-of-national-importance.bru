meta {
  name: Activate Institute of National Importance
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/admin/institutes-of-national-importance/{{instituteOfNationalImportanceId}}/activate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Re-activates a previously deactivated institute. Requires platform_admin
  auth + institutes-of-national-importance.manage. 403 if already active.
}

meta {
  name: List Institutes of National Importance
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/institutes-of-national-importance
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  ~is_active: true
  ~search: IIT
  ~page: 1
  ~limit: 50
}

docs {
  Lists institutes of national importance, paginated. Requires
  platform_admin auth + institutes-of-national-importance.view.

  Query (all optional):
  - is_active: true | false
  - search: case-insensitive match on name
  - page: default 1
  - limit: default 50, max 100

  Each item includes `collegesCount` — a manually-entered number set by
  the admin on create/update (not computed from real college
  associations). Response includes `meta` (page, limit, total,
  totalPages, hasNextPage, hasPreviousPage) alongside `data`.
}

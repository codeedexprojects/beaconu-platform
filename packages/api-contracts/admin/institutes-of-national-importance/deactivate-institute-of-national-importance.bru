meta {
  name: Deactivate Institute of National Importance
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/admin/institutes-of-national-importance/{{instituteOfNationalImportanceId}}/deactivate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft-deactivates an institute (isActive: false) — never hard-deleted.
  Requires platform_admin auth + institutes-of-national-importance.manage.
  403 if already inactive.
}

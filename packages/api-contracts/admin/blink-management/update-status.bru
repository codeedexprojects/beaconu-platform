meta {
  name: Update Blink User Status
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/v1/admin/users/blink-users/{{blinkUserId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "status": "active"
  }
}

docs {
  Platform Admin endpoint to approve or reject Blink users (Associate Admins or Employees).
  Requires: Platform Admin access token.

  status: active | rejected | suspended
}

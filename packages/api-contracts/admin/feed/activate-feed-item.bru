meta {
  name: Activate Feed Item
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/admin/feed/{{feedId}}/activate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Re-activates a previously deactivated feed item. Requires platform_admin
  auth + content.manage. 403 if already active.
}

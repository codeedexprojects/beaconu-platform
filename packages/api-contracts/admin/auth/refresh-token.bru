meta {
  name: Refresh Token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/auth/refresh-token
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("accessToken", data.data.accessToken);
    }
  }
}

docs {
  Issues a new access token using the refreshToken cookie.
  No Authorization header needed — reads from cookie.

  Rotates the refresh token on each call (old token is invalidated).
}

meta {
  name: Deactivate Entrance Exam
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/admin/entrance-exams/{{entranceExamId}}/deactivate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

docs {
  Sets the exam status to "inactive". Inactive exams are hidden from the student view.
}

meta {
  name: Update Entrance Exam
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/entrance-exams/{{entranceExamId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "JEE Main 2025",
    "exam_date": "2025-01-22",
    "result_date": "2025-02-12"
  }
}

docs {
  Partially updates an entrance exam. All fields optional.
  Pass null for date fields to clear them (e.g. "exam_date": null).
}

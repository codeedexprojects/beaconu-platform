meta {
  name: Get Entrance Exam
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/entrance-exams/{{entranceExamId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

docs {
  Returns full details of a single entrance exam by ID.
}

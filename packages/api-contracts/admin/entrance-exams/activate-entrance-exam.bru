meta {
  name: Activate Entrance Exam
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/admin/entrance-exams/{{entranceExamId}}/activate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

docs {
  Sets an inactive exam's status back to "active". Active exams are visible in the student view.
}

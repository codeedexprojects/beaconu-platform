meta {
  name: Update College Lead Status
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/college-leads/{{collegeLeadId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "status": "contacted"
  }
}

docs {
  Updates the status of a college onboarding lead.

  Fields:
  - status: New status string (required)

  Requires: platform admin access token.
}

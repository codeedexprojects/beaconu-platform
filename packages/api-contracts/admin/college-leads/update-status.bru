meta {
  name: Update College Lead Status
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/college-leads/{{collegeLeadId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "status": "approved",
    "review_remarks": "Verified details and approved for provisioning."
  }
}

docs {
  Updates the status of a college onboarding lead.

  Fields:
  - status: New status (required: pending, approved, rejected)
  - review_remarks: Reviewer note (optional)

  Requires: platform admin access token.
}

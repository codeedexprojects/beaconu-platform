meta {
  name: Get College Leads Stats
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/college-leads/stats
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns aggregate stats for college leads (total, by status, recent).

  Requires: platform admin access token.
}

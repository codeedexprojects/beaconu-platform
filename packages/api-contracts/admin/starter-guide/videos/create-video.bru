meta {
  name: Create Video
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/starter-guide/videos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Getting Started with BeaconU",
    "video_key": "{{sgvUploadKey}}",
    "display_order": 0
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("sgvId", data.data.id);
    }
  }
}

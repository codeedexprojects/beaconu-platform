meta {
  name: Presign Upload
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/starter-guide/videos/presign
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mime_type": "video/mp4",
    "file_size_bytes": 10485760
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.key) {
      bru.setEnvVar("sgvUploadKey", data.data.key);
    }
  }
}

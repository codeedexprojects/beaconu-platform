meta {
  name: Activate Starter Guide
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/admin/starter-guide/{{starterGuideId}}/activate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Re-activates a previously deactivated starter guide. Requires
  platform_admin auth + content.manage. 403 if already active.
}

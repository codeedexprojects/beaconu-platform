meta {
  name: List Permissions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/roles/permissions
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns all available permission codes that can be assigned to roles.
  Requires: super admin access token.

  Use these codes when creating or updating a role.
  Table: platform_role_permissions
}

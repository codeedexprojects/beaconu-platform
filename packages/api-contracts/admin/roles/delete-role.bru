meta {
  name: Delete Role
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/admin/roles/{{platformRoleId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

script:pre-request {
  const platformRoleId = bru.getEnvVar("platformRoleId");
  if (!platformRoleId) {
    throw new Error("platformRoleId is not set. Run 'Create Role' first.");
  }
}

docs {
  Deletes a platform role by id.
  Requires: platform admin with platform.roles.manage permission (super_admin has this by default).

  Deletion is blocked when role is a system role or currently assigned to one or more admins.
  platformRoleId: set by running Create Role.

  Tables: platform_roles, platform_role_permissions
}

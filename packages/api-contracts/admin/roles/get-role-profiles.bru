meta {
  name: Get Role Profiles
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/admin/roles/profiles
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns all user profiles grouped by role.
  Alias of GET /api/v1/admin/users/profiles scoped under the roles router.

  Requires: platform admin access token.
}

meta {
  name: Publish / Unpublish Legal Document
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/legal-documents/terms_and_conditions/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "draft"
  }
}

docs {
  Publishes or unpublishes without touching the content. Requires: platform
  admin token + content.manage. 404 when the document hasn't been written yet.

  Unpublishing removes it from the public endpoints immediately.
}

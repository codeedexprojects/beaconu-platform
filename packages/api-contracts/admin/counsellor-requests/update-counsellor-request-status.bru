meta {
  name: Update Counsellor Request Status
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/admin/counsellor-requests/{{counsellorRequestId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "status": "approved",
    "review_remarks": "Qualifications verified — cleared to onboard."
  }
}

script:pre-request {
  const counsellorRequestId = bru.getEnvVar("counsellorRequestId");
  if (!counsellorRequestId) {
    throw new Error("counsellorRequestId is not set. Run List Counsellor Requests first.");
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.counsellor_code) {
      bru.setEnvVar("counsellorCode", data.data.counsellor_code);
    }
  }
}

docs {
  Approves or rejects a counsellor registration request.
  When approved, creates a counsellor account and returns counsellor_code + temp_password.
  Requires: super admin access token + counsellors.manage permission.

  status: approved | rejected
  review_remarks: optional reviewer note

  On approval response includes:
    counsellor_code: e.g. "CC-1" — unique code assigned to the counsellor account

  Table: counsellor_registration_requests + counsellors
}

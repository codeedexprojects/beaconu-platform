meta {
  name: Get All Profiles
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/users/profiles
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns all user profiles across the platform (students and blink users).
  Requires: platform admin access token.

  Tables: students, blink_users
}

meta {
  name: Archive University
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/admin/universities/{{universityId}}/archive
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Archives a university (sets status to "archived").
  Archived universities are hidden from the public API.
  This is a soft operation — the record is not deleted.

  Requires: platform admin access token.
}

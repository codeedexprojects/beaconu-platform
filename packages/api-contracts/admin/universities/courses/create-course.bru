meta {
  name: Create Course
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/universities/courses
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Bachelor of Computer Applications (BCA)",
    "slug": "bachelor-of-computer-applications-bca",
    "discipline_id": "{{disciplineId}}",
    "sort_order": 1,
    "is_active": true
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("courseMasterId", data.data.id);
    }
  }
}

docs {
  Creates a new course-master entry. Only a Discipline (which carries its
  Stream) and a name are required — Study Level and Program Type are
  optional classification fields, not asked for at creation time since
  picking a Discipline already establishes the relevant context. Rejects
  duplicates: the combination of (discipline_id, slug) must be unique —
  a 409 is returned if the exact same course already exists under that
  discipline.

  Fields:
  - name: String (required)
  - slug: Lowercase alphanumeric with hyphens (required)
  - discipline_id: UUID of an existing discipline (required — carries the
    Stream implicitly, since Discipline belongs to a Stream)
  - study_level_id: UUID of an existing study level (optional)
  - program_type_id: UUID of an existing program type (optional)
  - sort_order: Integer (optional, default 0)
  - is_active: Boolean (optional, default true)

  Requires: platform admin access token.
  Saves courseMasterId to env for use in other requests.
}

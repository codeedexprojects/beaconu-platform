meta {
  name: Get University
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/admin/universities/{{universityId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns a specific university by ID, including its university type.

  Requires: platform admin access token.
}

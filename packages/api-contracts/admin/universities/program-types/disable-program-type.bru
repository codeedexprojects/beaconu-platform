meta {
  name: Disable Program Type
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/universities/program-types/{{programTypeId}}/disable
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Disables a program type (sets isActive to false).

  Requires: platform admin access token.
}

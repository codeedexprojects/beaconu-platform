meta {
  name: List University Types
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/universities/types
  body: none
  auth: none
}

query {
  ~is_active: true
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns all university types.

  Query Parameters:
  - is_active: Filter by active status (optional)

  Requires: platform admin access token.
}

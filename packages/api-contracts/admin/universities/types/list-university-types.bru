meta {
  name: List University Types
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/universities/types
  body: none
  auth: none
}

params:query {
  ~is_active: true
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0].id) {
      bru.setEnvVar("universityTypeId", data.data[0].id);
    }
  }
}

docs {
  Returns all university types.
  
  Query Parameters:
  - is_active: Filter by active status (optional)
  
  Requires: platform admin access token.
}

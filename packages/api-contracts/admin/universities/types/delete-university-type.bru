meta {
  name: Delete University Type
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/admin/universities/types/{{universityTypeId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Soft-deletes a university type (sets isActive to false).
  The record is not removed from the database.

  Requires: platform admin access token.
}

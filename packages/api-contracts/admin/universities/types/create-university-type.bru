meta {
  name: Create University Type
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/universities/types
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Central University",
    "slug": "central-university",
    "sort_order": 1,
    "is_active": true
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("universityTypeId", data.data.id);
    }
  }
}

docs {
  Creates a new university type.

  Fields:
  - name: String (max 100)
  - slug: String (lowercase alphanumeric with hyphens, unique)
  - sort_order: Integer (optional, default 0)
  - is_active: Boolean (optional, default true)

  Requires: platform admin access token.
  Saves universityTypeId to env for use in other requests.
}

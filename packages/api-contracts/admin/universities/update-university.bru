meta {
  name: Update University
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/admin/universities/{{universityId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "University of Delhi",
    "city": "New Delhi",
    "accreditation": "NAAC A++",
    "cover_url": "",
    "metadata": {
      "overview": {
        "discipline": [
          {
            "name": "Engineering"
          }
        ],
        "videos": [
          "https://example.com/videos/campus-tour.mp4"
        ]
      }
    },
    "governance": {
      "academic_council": [
        {
          "userPhotoUrl": "",
          "name": "Member 1",
          "designation": "Chairperson",
          "description": "Updated academic council description"
        }
      ],
      "management_council": [
        {
          "userPhotoUrl": "",
          "name": "Member 1",
          "designation": "Member",
          "description": "Updated management council description"
        }
      ],
      "organizational_organogram": {
        "title": "Organizational Organogram",
        "fileUrl": "",
        "description": ""
      }
    }
  }
}

docs {
  Updates a university.
  Supports partial updates — only include fields to change.

  Updatable fields:
  - university_type_id, name, slug, state, city, accreditation,
    governance_details, cover_url, logo_url, metadata, governance
  - For metadata.overview.discipline and metadata.overview.videos,
    send array values consistently (even for a single item)

  Requires: platform admin access token.
}

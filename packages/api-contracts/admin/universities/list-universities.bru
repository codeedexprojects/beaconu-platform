meta {
  name: List Universities
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/universities
  body: none
  auth: none
}

query {
  ~status: active
  ~university_type_id:
  ~state:
  ~search:
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns all universities with their university type.

  Query Parameters:
  - status: Filter by status — active | inactive | archived (optional)
  - university_type_id: Filter by university type UUID (optional)
  - state: Filter by state name (optional)
  - search: Search by university name (case-insensitive, optional)

  Requires: platform admin access token.
}

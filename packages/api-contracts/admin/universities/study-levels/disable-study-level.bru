meta {
  name: Disable Study Level
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/universities/study-levels/{{studyLevelId}}/disable
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Disables a study level (sets isActive to false).

  Requires: platform admin access token.
}

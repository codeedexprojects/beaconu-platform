meta {
  name: List Disciplines
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/universities/disciplines
  body: none
  auth: none
}

query {
  ~is_active: true
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0] && data.data[0].id) {
      bru.setEnvVar("disciplineId", data.data[0].id);
    }
  }
}

docs {
  Returns all disciplines.

  Query Parameters:
  - is_active: Filter by active status (optional)

  Requires: platform admin access token.
  Saves disciplineId from first result to env.
}

meta {
  name: Create Discipline
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/universities/disciplines
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Computer Science",
    "slug": "computer-science",
    "sort_order": 1,
    "is_active": true
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("disciplineId", data.data.id);
    }
  }
}

docs {
  Creates a new discipline.

  Fields:
  - name: String (required)
  - slug: Lowercase alphanumeric with hyphens, unique (required)
  - sort_order: Integer (optional, default 0)
  - is_active: Boolean (optional, default true)

  Requires: platform admin access token.
  Saves disciplineId to env for use in other requests.
}

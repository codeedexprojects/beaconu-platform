meta {
  name: Disable Discipline
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/universities/disciplines/{{disciplineId}}/disable
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Disables a discipline (sets isActive to false).

  Requires: platform admin access token.
}

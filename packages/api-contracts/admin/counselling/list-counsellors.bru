meta {
  name: List Counsellors
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/counsellors
  body: none
  auth: none
}

params:query {
  counsellor_type: academic
  status: active
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns all counsellors with optional filters.
  Requires: super admin access token.

  Query params (all optional):
    counsellor_type: academic | mindcare
    status: active | inactive | suspended

  Table: counsellors
}

meta {
  name: Get Counsellor Detail
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/counsellors/{{counsellorId}}/detail
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Counsellor detail view for the platform admin panel: profile, stats,
  and wallet balance only. Slots, sessions, and wallet transactions are
  fetched separately via their own paginated endpoints (see List
  Counsellor Slots, List Counsellor Sessions, List Counsellor Wallet
  Transactions in this folder).
  Requires: super admin access token + counsellors.view permission.

  ## Response shape
  {
    "counsellor": { ...full profile, including session_fee, rating, known_languages, upi_id, bank_details },
    "stats": {
      "slots": { "total": number, "available": number, "booked": number },
      "sessions": { "total": number, "booked": number, "completed": number, "cancelled": number },
      "payments": { "paid_sessions_count": number, "total_payment_received": number }
    },
    "wallet": {
      "id", "counsellor_id", "balance", "total_earned", "total_withdrawn",
      "created_at", "updated_at"
    }
  }
}

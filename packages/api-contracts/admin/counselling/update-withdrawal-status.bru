meta {
  name: Update Withdrawal Status
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/admin/counsellors/withdrawals/{{withdrawalRequestId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "approved",
    "remarks": "Verified payout details and processed payout manually"
  }
}

docs {
  Approves or rejects a pending counsellor withdrawal request.
  Requires: platform admin access token + permission "counsellors.manage".

  Body:
  - status: approved | rejected
  - remarks (optional, max 500 chars)

  Behavior:
  - approved: decrements counsellor_wallets.balance by the amount AND
    increments total_withdrawn by the amount (balance was untouched until
    now — the request only reserved it logically, not in the DB). The
    actual payout (bank transfer or UPI) happens manually outside the
    system, using the transaction's payout_details snapshot.
  - rejected: no wallet change at all — balance was never decremented for
    a pending request, so there's nothing to refund.

  Returns 404 if the request doesn't exist, 409 if it has already been reviewed.

  Tables: counsellor_wallet_transactions, counsellor_wallets
}

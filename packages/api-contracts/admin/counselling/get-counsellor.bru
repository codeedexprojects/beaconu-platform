meta {
  name: Get Counsellor
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/counsellors/{{counsellorId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:pre-request {
  const counsellorId = bru.getEnvVar("counsellorId");
  if (!counsellorId) {
    throw new Error("counsellorId is not set. Run counsellor Login or Get Profile first.");
  }
}

docs {
  Returns full profile of a single counsellor.
  Requires: super admin access token.

  counsellorId: set automatically by counsellor Login or Get Profile.
  Table: counsellors
}

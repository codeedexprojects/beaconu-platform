meta {
  name: Get Platform Config
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/config
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns the platform-wide config singleton.
  Requires: platform admin access token + permission "platform.settings.view".

  Response:
  {
    meetingGstPercentage: number,   // GST applied to counselling session fee payments only
    counsellorMinWithdrawalAmount: number,
    updatedByAdminId: string | null,
    updatedAt: string
  }

  Note: other payment flows (e.g. Blink referral commissions) use their own
  independent per-course GST percentage (service_charge_configs.gst_percentage)
  — unaffected by this config.

  Table: platform_configs (single row, id = 'default')
}

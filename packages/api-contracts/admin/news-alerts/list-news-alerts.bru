meta {
  name: List News Alerts
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/news
  body: none
  auth: none
}

query {
  page: 1
  limit: 10
  ~status: draft
  ~category: news
  ~search:
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.length > 0 && data.data[0].id) {
      bru.setEnvVar("newsAlertId", data.data[0].id);
      bru.setEnvVar("newsAlertSlug", data.data[0].slug);
    }
  }
}

docs {
  Returns all news alerts with pagination. Platform admin can filter by status, category, and search.

  Query Parameters:
  - status: Filter by status — draft | published | archived (optional)
  - category: Filter by category — news | alert | admission | exam | scholarship | event | result (optional)
  - search: Search in title (optional)
  - page: Page number (default: 1)
  - limit: Items per page (default: 10, max: 50)
}

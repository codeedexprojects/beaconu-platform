meta {
  name: Archive News Alert
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/admin/news/{{newsAlertId}}/archive
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Soft-delete a news alert by setting status to "archived".
  Archived alerts are hidden from the public feed.
}

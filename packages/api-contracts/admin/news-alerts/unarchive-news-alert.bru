meta {
  name: Unarchive News Alert
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/admin/news/{{newsAlertId}}/unarchive
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Moves an archived news alert back to "draft" status so it can be edited and re-published.
}

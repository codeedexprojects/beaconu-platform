meta {
  name: Update Permission
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/admin/permissions/{{platformPermissionId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "code": "platform.test.updated",
    "description": "Updated test permission description"
  }
}

docs {
  Updates an existing permission in the registry.
  Requires: platform admin with platform.roles.manage permission.
}

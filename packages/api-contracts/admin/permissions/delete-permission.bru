meta {
  name: Delete Permission
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/admin/permissions/{{platformPermissionId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Deletes a permission from the registry.
  Requires: platform admin with platform.roles.manage permission.
}

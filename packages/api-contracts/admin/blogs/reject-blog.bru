meta {
  name: Reject Blog
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/blogs/:id/reject
  body: json
  auth: none
}

params:path {
  id: {{blogId}}
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "rejection_reason": "Content does not meet our publishing guidelines."
  }
}

docs {
  Reject a pending blog. Requires a rejection_reason. Sets status to "rejected".
  Only pending blogs can be rejected.
}

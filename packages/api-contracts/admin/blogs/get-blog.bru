meta {
  name: Get Blog
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/blogs/:id
  body: none
  auth: none
}

params:path {
  id: {{blogId}}
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Get a single blog by ID including full content, review details, and rejection reason.
}

meta {
  name: List Blogs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/blogs
  body: none
  auth: none
}

query {
  ~status: pending
  ~search:
  page: 1
  limit: 10
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.length > 0 && data.data[0].id) {
      bru.setEnvVar("blogId", data.data[0].id);
    }
  }
}

docs {
  Returns all blogs with pagination. Super admin can filter by status and search.

  Query Parameters:
  - status: Filter by status — pending | approved | rejected (optional)
  - search: Search in title or author name (optional)
  - page: Page number (default: 1)
  - limit: Items per page (default: 10, max: 50)
}

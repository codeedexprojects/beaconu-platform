meta {
  name: Create Blog (Admin)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/blogs
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "title": "Top Colleges for Engineering in India 2025",
    "summary": "A comprehensive guide to the best engineering colleges.",
    "content": "India has hundreds of engineering colleges but only a handful stand out for their academic excellence, placement records, and campus life...",
    "cover_image_url": "https://example.com/engineering-colleges.jpg",
    "tags": ["engineering", "colleges", "india"]
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("blogId", data.data.id);
    }
  }
}

docs {
  Create a blog post as a platform admin. Published immediately (no review step).
  Author name and slug are generated server-side from the authenticated admin's profile.
}

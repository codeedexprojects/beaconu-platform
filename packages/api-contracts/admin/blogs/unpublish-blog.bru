meta {
  name: Unpublish Blog
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/admin/blogs/{{blogId}}/unpublish
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("blogId", data.data.id);
    }
  }
}

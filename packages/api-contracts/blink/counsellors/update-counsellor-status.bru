meta {
  name: Update Counsellor Status
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/blink/counsellors/{{counsellorId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "status": "active"
  }
}

script:pre-request {
  const counsellorId = bru.getEnvVar("counsellorId");
  if (!counsellorId) {
    throw new Error("counsellorId is not set. Run 'Get My Profile' as a counsellor first.");
  }
}

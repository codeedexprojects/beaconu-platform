meta {
  name: List Own Referrals
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/blink/employee/referrals?page=1&limit=20
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

params:query {
  page: 1
  limit: 20
  status:
  search:
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0] && data.data[0].id) {
      bru.setEnvVar("referralId", data.data[0].id);
    }
  }
}

docs {
  Returns a paginated list of referrals created by the authenticated associate employee.
  Requires: blink_employee access token.

  Query params:
  - status (optional): registered | rejected | confirmed | dropped_out
  - search (optional): matches student full name, email, or phone (case-insensitive)
  - page (default: 1)
  - limit (default: 20, max: 100)

  Tables: referrals, students, blink_users, referral_codes, commissions
}

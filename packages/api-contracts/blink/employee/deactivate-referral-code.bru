meta {
  name: Deactivate Referral Code
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/blink/employee/referral-codes/{{referralCodeId}}/deactivate
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Soft-deactivates one of the authenticated associate employee's own referral codes
  (isActive: false). Ownership-checked — 404 if the code belongs to someone else.
  Requires: associate employee access token (blink_employee userType).

  Tables: referral_codes
}

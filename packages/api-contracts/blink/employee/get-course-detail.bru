meta {
  name: Get Course Detail
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/blink/colleges/{{blinkCollegeId}}/courses/{{blinkCourseId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns full course detail for a specific course under a college.
  Requires: blink_employee access token.

  Returns 404 if the course does not exist, is not active, or does not
  belong to the specified college.

  Response includes:
    - Core info: name, code, duration, eligibility, studyMode, intakeCapacity
    - Classification: discipline, stream, studyLevel, programType, campus
    - Content: highlights, curriculum, careerOpportunities, eligibilityCriteria, faqs
    - quotas[]: active admission quotas with seat count and optional tuition override
    - feeStructures[]: active fee rows (category, amount, instalment config,
      oneTimeFees, additionalFees, whatsIncluded, whatsExcluded, feePdfUrl)
    - commissions[]: active Blink service charge configs showing the employee's
      expected netPayout per confirmed referral for this course

  Tables: courses, fee_structures, course_quotas, service_charge_configs
}

meta {
  name: Get Wallet Transactions
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/blink/employee/wallet/transactions
  body: none
  auth: none
}

params:query {
  ~page: 1
  ~limit: 20
  ~type: credit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

vars:pre-request {
  accessToken: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJCTFUtNDkiLCJ1c2VyVHlwZSI6ImJsaW5rX2VtcGxveWVlIiwicm9sZUlkIjoiQkxSLTIiLCJwZXJtaXNzaW9ucyI6WyJibGluazpkYXNoYm9hcmQ6dmlldyIsImJsaW5rOnJlZmVycmFsczptYW5hZ2UiLCJibGluazpwcm9maWxlOnZpZXciXSwic2Vzc2lvbklkIjoiVVNTLTU0NSIsImlhdCI6MTc4ODMzMzg0MCwiZXhwIjoxNzk2MTA5ODQwfQ.Qaj7hRDXZowIVu-nA2mBVe9kVE4zNZXTiQtQ8Ajhgzg
  baseUrl: http://localhost:4000
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0] && data.data[0].id) {
      bru.setEnvVar("blinkWalletTxnId", data.data[0].id);
    }
  }
}

docs {
  Returns paginated wallet transaction history for the authenticated associate employee.
  Requires: associate employee access token (blink_employee userType).
  
  Each item includes: type (credit/debit), amount, description, withdrawalStatus, balanceAfter, createdAt.
  
  Query params:
    type  (optional): credit | debit — filters to only that transaction type
    page  (optional, default 1)
    limit (optional, default 20, max 100)

  Table: blink_wallet_transactions
}

meta {
  name: List My Conversations (Ambassador)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/blink/ambassador/chat/conversations?page=1&limit=20
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

params:query {
  page: 1
  limit: 20
}

docs {
  Every conversation this ambassador is part of, newest-last-message first.
  otherParticipant here is the student. Ambassadors never initiate
  conversations — this list only ever contains threads a student already
  started (see Start Or Get Conversation in student/chat).
}

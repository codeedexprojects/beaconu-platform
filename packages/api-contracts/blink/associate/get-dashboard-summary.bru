meta {
  name: Get Dashboard Summary
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/blink/associate/dashboard/summary
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

params:query {
  ~from:
  ~to:
}

docs {
  Returns home/dashboard counts for the authenticated associate admin's team,
  optionally scoped to a date range.
  Requires: associate admin access token (blink_associate userType).

  Query params:
  - from (optional): ISO date/datetime — only referrals created on or after this date are counted
  - to (optional): ISO date/datetime — only referrals created on or before this date are counted

  Response:
  {
    applicationSubmitted: number,  // referral status = registered
    admissionConfirmed: number,    // referral status = confirmed
    applicationRejected: number,   // referral status = rejected
    droppedOut: number             // referral status = dropped_out
  }

  Counts are scoped to referrals generated by all employees under this admin
  (blink_users.associate_parent_id = current admin).

  Tables: referrals, blink_users
}

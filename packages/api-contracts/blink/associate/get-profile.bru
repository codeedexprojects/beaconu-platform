meta {
  name: Get Profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/blink/associate/profile
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns the profile of the currently authenticated Blink user.
  Requires: any Blink App access token (associate admin or employee).

  Table: blink_users
}

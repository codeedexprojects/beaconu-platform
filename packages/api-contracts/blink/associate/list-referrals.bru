meta {
  name: List Referrals
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/blink/associate/referrals
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

params:query {
  ~status: registered
  ~page: 1
  ~limit: 20
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0] && data.data[0].id) {
      bru.setEnvVar("referralId", data.data[0].id);
    }
  }
}

docs {
  Returns all referrals generated by employees of the authenticated associate admin.
  Requires: associate admin access token (blink_associate userType).

  Query params:
    status  (optional) — filter by referral status: registered | rejected | confirmed | dropped_out
    page    (optional, default 1)
    limit   (optional, default 20, max 100)

  Each item includes: student snippet, employee snippet, college/course, commission status.
  Tables: referrals, blink_users, students, referral_codes, colleges, courses, commissions
}

meta {
  name: Request Withdrawal
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/blink/associate/wallet/withdraw
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "amount": 500,
    "description": "Monthly payout"
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.transactionId) {
      bru.setEnvVar("blinkWithdrawalTxnId", data.data.transactionId);
    }
  }
}

docs {
  Submits a withdrawal request against the authenticated associate admin's wallet balance.
  Requires: associate admin access token (blink_associate userType).

  Validation:
    amount      — positive number, ≥ platform config `blinkMinWithdrawalAmount`,
                  must not exceed current balance
    description — optional, max 255 chars

  Bank details must be saved first (PUT /wallet/bank-details).

  On success: creates a blink_wallet_transaction (type: debit, withdrawalStatus: pending)
  and decrements the wallet balance atomically. The balance check is part of the
  same UPDATE, so concurrent requests can never take the balance below zero.

  Returns 422 if amount is below the minimum withdrawal amount.
  Returns 422 if no bank details are saved.
  Returns 422 if amount exceeds available balance.
  Returns 422 if no wallet exists (no commissions recorded yet).

  Tables: blink_wallets, blink_wallet_transactions, platform_configs
}

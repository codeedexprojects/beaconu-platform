meta {
  name: Update Employee Status
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/blink/associate/employees/{{employeeId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "status": "active"
  }
}

script:pre-request {
  const employeeId = bru.getEnvVar("employeeId");
  if (!employeeId) {
    throw new Error("employeeId is not set. Run 'Register Employee' first.");
  }
}

docs {
  Updates the status of an employee belonging to the authenticated associate admin.
  Requires: associate admin access token (blink_associate userType).

  An admin can only update their own employees (enforced by associateParentId check).
  status: active | inactive | suspended | rejected

  Table: blink_users
}

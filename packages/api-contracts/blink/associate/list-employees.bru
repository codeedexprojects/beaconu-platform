meta {
  name: List Employees
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/blink/associate/employees?page=1&limit=20
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

params:query {
  page: 1
  limit: 20
  status:
  search:
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0] && data.data[0].id) {
      bru.setEnvVar("employeeId", data.data[0].id);
    }
  }
}

docs {
  Returns a plain (non-ranked) paginated list of employees under the authenticated
  associate admin.
  Requires: associate admin access token (blink_associate userType).

  Query params:
  - status (optional): active | inactive | suspended | rejected | pending_approval
  - search (optional): matches employee full name or id (case-insensitive)
  - page (default: 1)
  - limit (default: 20, max: 100)

  meta includes activeCount — total count of active employees under this admin
  (unaffected by status/search filters, always the overall active count).

  For ranked/leaderboard view, use GET /blink/associate/employees/leaderboard instead.

  Tables: blink_users
}

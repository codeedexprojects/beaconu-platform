meta {
  name: List Employees
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/blink/associate/employees
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns all employees under the authenticated associate admin.
  Requires: associate admin access token (blink_associate userType).

  Only returns employees where associateParentId = req.userId.
  Table: blink_users (role: associate_employee)
}

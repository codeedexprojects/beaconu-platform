meta {
  name: Delete Uploaded File
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/blink/uploads/file
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "key": "{{uploadKey}}"
  }
}

docs {
  Delete a previously uploaded S3 object (avatar). Can only delete keys under
  the caller's own `blink_users/{userId}/` prefix — any other key returns 400.

  Body:
  - key (required): the S3 key to delete

  Response:
  - deleted: true
}

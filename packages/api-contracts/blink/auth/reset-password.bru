meta {
  name: Reset Password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/blink/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reset_token": "{{resetToken}}",
    "new_password": "NewPassword@123"
  }
}

docs {
  Step 3 of the blink forgot-password flow.
  Validates the resetToken (UUID, 15 min TTL), hashes the new password, and updates
  passwordHash + passwordChangedAt on the blink_users record.
  The resetToken is consumed after use and cannot be reused.
  No authentication required.
}

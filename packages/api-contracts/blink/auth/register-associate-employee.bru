meta {
  name: Register Associate Employee
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/blink/auth/register/associate-employee
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "Jane Doe",
    "email": "john+@agency.com",
    "phone_number": "+919876543211",
    "associate_parent_id": "{{associateAdminId}}",
    "password": "Password@123",
    "confirm_password": "Password@123"
  }
}

script:pre-request {
  const associateAdminId = bru.getEnvVar("associateAdminId");
  if (!associateAdminId) {
    throw new Error("associateAdminId is not set. Run 'Register Associate Admin' first.");
  }
}

meta {
  name: Register Associate Employee (Self-Registration)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/blink/auth/register-employee
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "Kaja Hussain",
    "email": "kaja@gmail.com",
    "agency_reg_number": "REG-8212",
    "password": "123456",
    "confirm_password": "123456",
    "phone_number": "9846274829"
  }
}

vars:pre-request {
  baseUrl: http://localhost:4000
}

docs {
  Public endpoint for employees to register themselves using their agency's registration number.
  
  Registration defaults to `pending_approval`.
  The Associate Admin with the matching `agency_reg_number` must approve the account.
}

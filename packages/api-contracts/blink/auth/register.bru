meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/blink/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agency_reg_number": "REG-12345",
    "agency_name": "Global Education Agency",
    "agency_email": "agency@example.com",
    "agency_phone_no": "+919876543210",
    "country": "India",
    "password": "Password@123",
    "confirm_password": "Password@123"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("accessToken", data.data.accessToken);
    }
  }
}

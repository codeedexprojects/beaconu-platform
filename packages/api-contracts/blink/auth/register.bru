meta {
  name: Register Associate Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/blink/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "John Doe",
    "email": "john@agency.com",
    "phone_number": "+919876543210",
    "country": "India",
    "agency_name": "EduConnect Pvt Ltd",
    "agency_reg_number": "REG-1234",
    "password": "Password@123",
    "confirm_password": "Password@123",
    "companyPan": "ABCDE1234F",
    "currentAccNo": "1234567890",
    "ifsc": "HDFC0000123",
    "gstin": "27AAAAA1111A1Z1"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("accessToken", data.data.accessToken);
    }
    if (data.data && data.data.user && data.data.user.id) {
      bru.setEnvVar("associateAdminId", data.data.user.id);
    }
  }
}

docs {
  Registers a new Associate Admin agency account.
  No authentication required.
  
  agency_reg_number must be unique across all blink_users.
  Returns an access token (15 min) and sets a refreshToken cookie (90 days).
  Saves associateAdminId to env for use in employee registration.
  
  Table: blink_users (role: associate_admin)
}

meta {
  name: Register Counsellor
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/blink/counsellors/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "Dr. Meera Kapoor",
    "email": "meera@counsellor.com",
    "password": "Password@123",
    "confirm_password": "Password@123",
    "phone_number": "+919990001111",
    "counsellor_type": "academic"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("accessToken", data.data.accessToken);
    }
  }
}

meta {
  name: Register Associate Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/blink/auth/register/associate-admin
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "John Doe",
    "email": "john+2@agency.com",
    "phone_number": "+919876543210",
    "country": "India",
    "agency_name": "EduConnect Pvt Ltd",
    "agency_reg_number": "REG-1234",
    "password": "Password@123",
    "confirm_password": "Password@123"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("accessToken", data.data.accessToken);
    }
  }
}

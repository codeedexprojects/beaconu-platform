meta {
  name: Forgot Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/blink/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "john@agency.com"
  }
}

docs {
  Step 1 of the blink forgot-password flow.
  Looks up the blink user by email and sends a 4-digit OTP to their registered phone number.
  No authentication required.

  In development the OTP is returned in the response as devOtp.
  In production devOtp is omitted and the OTP is delivered via SMS.

  Table: blink_users
}

meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/blink/associate-admin/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "john@agency.com",
    "password": "Password@123"
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("accessToken", data.data.accessToken);
    }
    if (data.data && data.data.user && data.data.user.id) {
      bru.setEnvVar("associateAdminId", data.data.user.id);
    }
  }
}

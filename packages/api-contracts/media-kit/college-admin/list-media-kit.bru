meta {
  name: List Media Kit (College Admin)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/college-admin/media-kit
  body: none
  auth: none
}

query {
  ~asset_type: poster
  ~scope: campus_wide
  ~course_id: {{courseId}}
  page: 1
  limit: 20
}

headers {
  Authorization: Bearer {{accessToken}}
}

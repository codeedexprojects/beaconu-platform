meta {
  name: List My Assigned Visits (Ambassador)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/blink/ambassador/campus-visits
  body: none
  auth: none
}

query {
  ~when: upcoming
  ~status: pending,confirmed
  ~date: 2026-08-15
  page: 1
  limit: 20
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    const visits = data.data && data.data.visits;
    if (visits && visits.length > 0 && visits[0].id) {
      bru.setEnvVar("campusVisitId", visits[0].id);
    }
  }
}

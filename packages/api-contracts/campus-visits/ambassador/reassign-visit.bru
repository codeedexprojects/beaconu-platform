meta {
  name: Reassign Campus Visit (Ambassador)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/blink/ambassador/campus-visits/{{campusVisitId}}/reassign
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "ambassador_id": "{{ambassadorId}}",
    "reassignment_reason": "Scheduling conflict — handing off to available ambassador"
  }
}

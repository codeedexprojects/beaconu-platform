meta {
  name: List My Campus Visits
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/student/campus-visits
  body: none
  auth: none
}

query {
  ~status: pending
  ~date: 2026-08-15
  page: 1
  limit: 20
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.length > 0 && data.data[0].id) {
      bru.setEnvVar("campusVisitId", data.data[0].id);
    }
  }
}

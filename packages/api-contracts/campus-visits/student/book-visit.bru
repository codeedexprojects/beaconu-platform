meta {
  name: Book Campus Visit
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/student/campus-visits
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "college_id": "{{collegeId}}",
    "ambassador_id": "{{ambassadorId}}",
    "full_name": "Test Student",
    "email": "student@example.com",
    "phone_number": "9876543210",
    "proposed_date": "2026-08-15",
    "proposed_time": "10:30",
    "additional_visitors_count": 2,
    "guests": [
      { "name": "Parent Name", "relation": "Parent" }
    ],
    "reason_for_visit": "Interested in B.Tech CSE program"
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("campusVisitId", data.data.id);
    }
  }
}

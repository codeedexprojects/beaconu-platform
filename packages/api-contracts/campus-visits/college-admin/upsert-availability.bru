meta {
  name: Set Campus Visit Availability (College Admin)
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/college-admin/campus-visits/availability
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "weekday": 1,
    "max_capacity": 5,
    "is_off": false
  }
}

docs {
  Sets the recurring weekly pattern for one weekday — whether it's open
  at all (`is_off`) and how many visits it can hold (`max_capacity`).
  No `time` anymore — every open day uses the single college-wide time
  set via Upsert Campus Visit Settings instead of a per-weekday time.
}

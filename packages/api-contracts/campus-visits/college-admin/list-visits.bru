meta {
  name: List All Campus Visits (College Admin)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/college-admin/campus-visits
  body: none
  auth: none
}

query {
  ~when: upcoming
  ~status: pending,confirmed
  ~date: 2026-08-15
  ~ambassador_id: {{ambassadorId}}
  page: 1
  limit: 20
}

headers {
  Authorization: Bearer {{accessToken}}
}

meta {
  name: List Active Education Loans
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/public/financial-aid/loans
  body: none
  auth: none
}

query {
  page: 1
  limit: 12
  ~loan_type: both
  ~search:
}

headers {
  Content-Type: application/json
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.length > 0 && data.data[0].id) {
      bru.setEnvVar("loanId", data.data[0].id);
    }
  }
}

docs {
  Returns active education loans with pagination. No authentication required.

  Query Parameters:
  - loan_type: Filter by type (domestic | abroad | both)
  - search: Search in bank name or product name
  - page: Page number (default: 1)
  - limit: Items per page (default: 12, max: 50)
}

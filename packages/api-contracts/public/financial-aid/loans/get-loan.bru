meta {
  name: Get Active Education Loan
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/public/financial-aid/loans/{{loanId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

docs {
  Returns full details of a single active education loan by ID. No authentication required.
  Returns 404 if the loan does not exist or is inactive.
}

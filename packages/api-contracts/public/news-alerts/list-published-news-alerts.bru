meta {
  name: List Published News Alerts
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/public/news
  body: none
  auth: none
}

query {
  page: 1
  limit: 12
  ~category: exam
  ~search:
}

headers {
  Content-Type: application/json
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.length > 0 && data.data[0].slug) {
      bru.setEnvVar("newsAlertSlug", data.data[0].slug);
    }
  }
}

docs {
  Returns published news alerts with pagination. No authentication required.

  Query Parameters:
  - category: Filter by category — news | alert | admission | exam | scholarship | event | result (optional)
  - search: Search in title (optional)
  - page: Page number (default: 1)
  - limit: Items per page (default: 12, max: 50)
}

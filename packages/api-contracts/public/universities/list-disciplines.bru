meta {
  name: List Disciplines
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/public/universities/disciplines?page=1&limit=10&search=&university_id=&stream_id=
  body: none
  auth: none
}

query {
  page: 1
  limit: 10
  ~search: Computer
  ~university_id: 12345678-1234-1234-1234-123456789012
  ~stream_id: 12345678-1234-1234-1234-123456789012
}

docs {
  Returns paginated list of disciplines.
  Supports search and filtering by university_id.
}

meta {
  name: List Universities
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/public/universities
  body: none
  auth: none
}

query {
  ~university_type_id:
  ~state: Karnataka
  ~search:
}

docs {
  Returns list of active universities.
  No authentication required.

  Query Parameters:
  - university_type_id: Filter by university type ID (optional)
  - state: Filter by state name, e.g. "Karnataka" (optional)
  - search: Search by university name (optional)
}

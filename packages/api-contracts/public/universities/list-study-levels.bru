meta {
  name: List Study Levels
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/public/universities/study-levels?page=1&limit=10&search=&university_id=
  body: none
  auth: none
}

query {
  page: 1
  limit: 10
  ~search: UG
  ~university_id: 12345678-1234-1234-1234-123456789012
}

docs {
  Returns paginated list of study levels.
  Supports search and filtering by university_id.
}

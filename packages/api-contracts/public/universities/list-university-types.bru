meta {
  name: List University Types
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/public/universities/types?page=1&limit=10&search=&university_id=
  body: none
  auth: none
}

query {
  page: 1
  limit: 10
  ~search: State
  ~university_id: 12345678-1234-1234-1234-123456789012
}

docs {
  Returns all active university types.
  Supports pagination, search, and university_id filtering.
  No authentication required.
  Used for filtering and display in public university listings.
}

meta {
  name: Get University Filters
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/public/universities/types
  body: none
  auth: none
}

docs {
  Returns filter options for university listings.
  Includes active university types and distinct states from active universities.
  No authentication required.

  Response:
  - universityTypes: [{ id, name, slug }]
  - states: ["Karnataka", "Maharashtra", ...]
}

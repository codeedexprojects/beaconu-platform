meta {
  name: Get College Filters
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/public/colleges/filters
  body: none
  auth: none
}

query {
  ~search: Karnataka
}

docs {
  Returns filter options for the college listing page.
  No authentication required.

  Query Parameters:
  - search: Filter states by name prefix (optional), e.g. "Karn" → ["Karnataka"]

  Response:
  {
    "states": ["Karnataka", "Maharashtra", ...]
  }
}

meta {
  name: Get College Filters
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/public/colleges/filters
  body: none
  auth: none
}

query {
  ~search: Karnataka
}

docs {
  Returns filter options for college listings.
  Includes distinct states from active colleges.
  No authentication required.

  Query Parameters:
  - search: Filter states by name (optional), e.g. "Karn" → ["Karnataka"]

  Response:
  - states: ["Karnataka", "Maharashtra", ...]
}

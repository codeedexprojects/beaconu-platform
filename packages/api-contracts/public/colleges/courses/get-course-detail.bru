meta {
  name: Get Course Detail (with Tabs)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/public/colleges/by-slug/{{collegeSlug}}/courses/{{courseId}}
  body: none
  auth: none
}

docs {
  Returns the complete public course detail payload.
  The response data now includes flattened top-level fields used by the portal UI
  such as admission_batches, quick_info, tabs, highlights, curriculum,
  courseStructure, valueAddedCourses, careerOpportunities,
  higherEducationCertifications, flexibleExitOptions, classTimings,
  industryTools, labFacilities, roomFacilities, featuredAlumni, faqs,
  studentForum and certifications.

  Path params:
  - collegeSlug: College subdomain slug
  - courseId: Course ID (set via list-courses script)

  Response shape:
  {
    "id": "CRS-1",
    "name": "B.Tech Computer Science",
    "admission_batches": [],
    "quick_info": [],
    "tabs": [
      "course_info",
      "admission_policy",
      "placements"
    ],
    "highlights": {},
    "curriculum": {},
    "courseStructure": {},
    "studentForum": {},
    "certifications": {}
  }

  `tabs` contains setup tabs configured for the course. Use a tab name from
  this list as the :tabName parameter in the Get Course Tab request.
}

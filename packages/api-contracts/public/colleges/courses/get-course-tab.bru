meta {
  name: Get Course Tab
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/public/colleges/by-slug/{{collegeSlug}}/courses/{{courseId}}/tabs/{{tabName}}
  body: none
  auth: none
}

vars:pre-request {
  tabName: clubs_associations
}

docs {
  Returns the content of a single course tab by its tab name.
  
  Path params:
  - collegeSlug: College subdomain slug
  - courseId: Course ID (set via list-courses script)
  - tabName: Tab identifier from the tabs array returned by Get Course Detail
  
  Setup tabs (stored in course metadata):
    course_info, admission_policy, placements, fees, financial_aid,
    student_housing, exam_policy, faculty, review, library,
    clubs_associations, alliance, other_courses_offered, demo_graphics
  
  Content tabs (stored as dedicated course fields):
    highlights, curriculum, course_structure, value_added_courses,
    career_opportunities, higher_education_certifications, flexible_exit_options,
    class_timings, industry_tools, lab_facilities, room_facilities,
    featured_alumni, faqs, entrance_exam_eligibility, eligibility_criteria,
    accreditations, key_dates, demographics
  
  Returns 404 if the tab name is invalid or the course is not found.
  
  --- fees tab response shape ---
  {
    "success": true,
    "message": "Course tab fetched",
    "data": {
      "tab": "fees",
      "title": "Tuition Fees",
      "fee_structure_pdf": {
        "icon": "...",
        "label": "Download Fee Structure",
        "subtitle": "Detailed breakdown PDF (2.4 MB)",
        "size": "2.4 MB",
        "download_icon": "...",
        "url": "..."
      },
      "fee_details": [
        {
          "quota": "Merit Quota",
          "gender": "Boys",
          "tuition_fees": { "title": "Tuition Amount", "rows": [{ "year": "1st Year", "amount": "₹ 1,25,276" }] },
          "one_time_payable_fees": { "title": "One-time Payable Fees", "icon": "...", "items": [{ "label": "...", "amount": "₹ ..." }] },
          "additional_fees": { "title": "Additional Fees", "icon": "...", "items": [...] },
          "deadlines_and_installments": { "title": "Deadlines & Installments", "icon": "...", "items": [{ "due": "WITHIN 10 DAYS", "label": "...", "amount": "₹ ..." }] },
          "fees_summary": { "title": "Fees Summary", "icon": "...", "full_course_fee": { "label": "Full course fee", "amount": "INR ..." }, "booking_amount": { "label": "Booking Amount", "amount": "INR ..." } }
        }
      ],
      "whats_included": { "title": "WHAT'S INCLUDED", "icon": "...", "items": ["Tuition Fees", ...] },
      "whats_excluded": { "title": "WHAT'S EXCLUDED", "icon": "...", "items": ["Uniform Dress", ...] },
      "refund_policy": { "title": "Refund Policy", "icon": "...", "items": ["Booking amount refundable within limited time", ...] }
    }
  }
  

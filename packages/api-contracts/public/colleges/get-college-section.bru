meta {
  name: Get College Section
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/public/colleges/{{collegeId}}/section/{{sectionName}}
  body: none
  auth: none
}

params:query {
  collegeId: 027a4a1a-742a-4f9a-ae13-994f1f4afd9b
  ~sectionName: course_info
}

vars:pre-request {
  sectionName: course_info
}

docs {
  Returns a single profile section for a college by sectionName.
  The response includes sectionName, sectionKey and section data.
  Supported sectionName values:
  college_overview, course_info, admission_policy, placements, fees,
  financial_aid, student_housing, exam_policy, faculty, review, commute,
  library, clubs_associations, student_code_of_conduct, happenings,
  institutions_across_world, alliance, other_courses_offered,
  demo_graphics.
}

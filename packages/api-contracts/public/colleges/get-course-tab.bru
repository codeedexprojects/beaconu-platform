meta {
  name: Get Course Tab (Public)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/public/colleges/by-slug/{{collegeSlug}}/courses/{{courseId}}/tabs/{{courseTabName}}
  body: none
  auth: none
}

docs {
  Returns a single tab's data for a course (public view).
  No authentication required.

  Valid tab names:
  highlights, curriculum, course_structure, value_added_courses,
  career_opportunities, higher_education_certifications,
  flexible_exit_options, class_timings, industry_tools,
  lab_facilities, room_facilities, featured_alumni, faqs,
  exam_policy, entrance_exam_eligibility, eligibility_criteria,
  accreditations, key_dates, demographics

  Note: collegeSlug, courseId, and courseTabName env vars must be set.

  Response shape:
  {
    "tabName": "curriculum",
    "data": [...]
  }
}

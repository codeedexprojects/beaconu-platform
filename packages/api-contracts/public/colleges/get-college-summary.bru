meta {
  name: Get College Summary
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/public/colleges/{{collegeId}}/summary?universityId=&streamId=&disciplineId=&studyLevelId=&programTypeId=
  body: none
  auth: none
}

query {
  ~collegeId: 12345678-1234-1234-1234-123456789012
  ~universityId: 12345678-1234-1234-1234-123456789011
  ~streamId: 12345678-1234-1234-1234-123456789013
  ~disciplineId: 12345678-1234-1234-1234-123456789014
  ~studyLevelId: 12345678-1234-1234-1234-123456789015
  ~programTypeId: 12345678-1234-1234-1234-123456789016
}

docs {
  Returns a lightweight college summary with logo, cover image, location, and a single matching active course.
  Filters by universityId and course taxonomy filters (streamId, disciplineId, studyLevelId, programTypeId) when provided.

  Response shape:
  ```json
  {
    "data": {
      "college": {
        "id": "CLG-1",
        "name": "...",
        "slug": "...",
        "logoUrl": "...",
        "coverImageUrl": "...",
        "location": { "address": "...", "city": "...", "state": "...", "district": "...", "pinCode": "..." },
        "university": { "id": "...", "name": "...", "universityType": { ... } }
      },
      "course": { "id": "...", "name": "...", "discipline": { ... }, ... },
      "tabListing": ["college_overview", "course_info", "placements", ...]
    }
  }
  ```

  - `tabListing` is a flat array of enabled profile section IDs (or section keys when id is missing).
    Disabled sections are excluded.
}
meta {
  name: Get College Hostel Detail
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/public/colleges/by-slug/{{collegeSlug}}/hostels/{{hostelId}}
  body: none
  auth: none
}

docs {
  Returns full hostel detail for public display: description, gallery,
  wardenInfo, amenities, rules, locationInfo, roomTypes (with pricing),
  messPlans, and addonServices (grouped by serviceType client-side, e.g.
  laundry/gym/parking). No auth required.
}

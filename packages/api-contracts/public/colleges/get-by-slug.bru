meta {
  name: Get College By Slug
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/public/colleges/by-slug/:slug
  body: none
  auth: none
}

docs {
  Returns full public details for a college by its subdomain slug.

  Response includes: university info, active campuses, active courses
  (with discipline/stream/studyLevel/programType), institution group
  membership, related sister colleges, `collegeDetails.profileSections`,
  and top-level `tabs`.

  Note: `settings` is excluded from the response.
  `profileSections` is included under `collegeDetails.profileSections`.
  `tabs` is a flat array of enabled section IDs in id-style format
  (snake_case). If a section id is missing, the section key is used.
  To get individual profile sections, use the Get College Section endpoint.
}

meta {
  name: Get College By Id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/public/colleges/{{collegeId}}
  body: none
  auth: none
}

docs {
  Returns full public details for a college by its ID.

  Response shape:
  {
    "collegeDetails": {
      "id": "CLG-1",
      "name": "...",
      "slug": "...",
      "logoUrl": "...",
      "coverImageUrl": "...",
      "address": "...",
      "city": "...",
      "state": "...",
      "district": "...",
      "pinCode": "...",
      "university": { "id": "...", "name": "...", "logoUrl": "...", "universityType": { "id": "...", "name": "...", "slug": "..." } },
      "campuses": [...],
      "courses": [...],
      "profileSections": { ... }
    },
    "tabs": [
      { "id": "college_overview", "name": "College Overview" },
      { "id": "course_info", "name": "Course Info" },
      { "id": "placements", "name": "Placements" }
    ],
    "totalCourses": 5,
    "instituteType": "...",
    "campusAmbassadors": [...]
  }

  `tabs` is an array of enabled college-level static sections only — { id, name } objects.
  These are tabs under the college profile (e.g. college_overview, placements, fees)
  and do NOT include course-level tabs (highlights, curriculum, etc.).
  Disabled sections are excluded.

  Note: `settings` is excluded from the response.
  To fetch the content of a specific tab, use the Get College Section endpoint.
}

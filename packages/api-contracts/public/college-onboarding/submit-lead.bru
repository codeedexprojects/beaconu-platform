meta {
  name: Submit College Onboarding Lead
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/public/college-onboarding
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "college_name": "Example College of Engineering",
    "contact_name": "Dr. Rajesh Kumar",
    "email": "rajesh@example-college.edu",
    "phone": "9876543210",
    "city": "Bangalore",
    "state": "Karnataka",
    "message": "Interested in onboarding our college to the BeaconU platform."
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("collegeLeadId", data.data.id);
    }
  }
}

docs {
  Submits a college onboarding interest form (public lead capture).
  No authentication required.

  Fields:
  - college_name: Name of the college (required)
  - contact_name: Primary contact person (required)
  - email: Contact email (required)
  - phone: Contact phone number (required)
  - city: College city (optional)
  - state: College state (optional)
  - message: Additional message (optional)

  Saves collegeLeadId to env if returned.
}

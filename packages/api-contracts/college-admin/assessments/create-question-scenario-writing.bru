meta {
  name: Create Question (Scenario Writing, Leadership Qualities)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/college-admin/assessments/sections/leadership-qualities/questions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{staffToken}}
}

body:json {
  {
    "question_type_id": "{{questionTypeId}}",
    "difficulty": "medium",
    "title": "Handling a missed deadline",
    "content": {
      "text": "Your team missed a critical deadline due to a dependency outside your control.",
      "question": "How would you communicate this to stakeholders, and what would you do next?"
    },
    "marks": 5,
    "negative_marks": 0,
    "course_ids": []
  }
}

docs {
  Example of a text_response, non-autoScorable question type. No answer_key
  is required or accepted for this type — it's evaluator-scored manually
  during the (not-yet-built) evaluation phase.

  `content.question` (optional, all question types): for prompt/passage-
  based questions, `content.text` holds the passage/scenario and
  `content.question` holds the specific question being asked about it —
  keeps the two visually/semantically separate instead of concatenating
  them into one `text` block.
}

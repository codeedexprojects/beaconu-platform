meta {
  name: List Questions (Verbal Communication)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/college-admin/assessments/sections/verbal-communication/questions
  body: none
  auth: none
}

query {
  ~question_type_id: {{questionTypeId}}
  ~difficulty: medium
  ~status: active
  ~course_id: {{courseId}}
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Lists questions in the Verbal Communication section. All query filters
  are optional. status defaults to active if omitted.
}

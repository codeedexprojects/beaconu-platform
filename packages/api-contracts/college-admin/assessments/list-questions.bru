meta {
  name: List Questions (Verbal Communication)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/college-admin/assessments/sections/verbal-communication/questions
  body: none
  auth: none
}

query {
  ~question_type_id: {{questionTypeId}}
  ~difficulty: medium
  ~status: active
  ~course_id: {{courseId}}
  ~page: 1
  ~limit: 20
}

headers {
  Authorization: Bearer {{staffToken}}
}

docs {
  Lists questions in the Verbal Communication section, paginated. All query
  filters are optional. status defaults to active if omitted. page defaults
  to 1, limit defaults to 20 (max 100). Response shape:
  data: { questions: Question[], meta: { total, page, limit, hasNext } }.
}

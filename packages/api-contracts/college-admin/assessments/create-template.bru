meta {
  name: Create Assessment Template
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/college-admin/assessments/templates
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{staffToken}}
}

body:json {
  {
    "name": "Standard Admission Assessment",
    "negative_marking_mode": "none",
    "instructions": [
      {
        "heading": "Time Limit",
        "description": "Total time is the sum of every question's own time limit."
      },
      {
        "heading": "Tab Switching",
        "description": "Do not switch tabs or minimize the window during the test."
      }
    ],
    "sections": [
      {
        "section_id": "{{assessmentSectionIdVerbal}}",
        "question_count": 5,
        "time_limit_mins": 15,
        "section_weightage": 20
      },
      {
        "section_id": "{{assessmentSectionIdAptitude}}",
        "question_count": 10,
        "time_limit_mins": 20,
        "section_weightage": 80
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("assessmentTemplateId", data.data.id);
    }
  }
}

docs {
  Creates a template in status "draft". total_questions is computed
  server-side as the sum of each section's question_count. If
  section_weightage is provided on every section, they must sum to 100; if
  omitted entirely that's fine too, but partial (some sections with, some
  without) is rejected. Get real section_id values from GET
  /assessments/sections (enable a section first if needed).

  No total_duration_mins or total_marks field on the template itself —
  both are always computed, but from different sources: total DURATION is
  the sum of each section's own time_limit_mins (set per-section right
  here on this request) plus a fixed 5-minute buffer — set these
  correctly, since this is what students see on the Room screen and what
  the auto-submit job/fixed-slot window-end actually enforce as the
  deadline. total MARKS is separately computed from the approved normal
  paper's questions' marks (set per-question in Create Question) — marks
  genuinely need a paper to exist since they're not declared per-section.
}

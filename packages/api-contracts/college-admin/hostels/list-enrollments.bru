meta {
  name: List Hostel Enrollments (Students)
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/v1/college-admin/hostels/enrollments?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  hostel_id: {{hostelId}}
  room_type_id:
  status: active
  search:
}

auth:bearer {
  token: {{staffToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0]) {
      bru.setEnvVar("hostelEnrollmentId", data.data[0].id);
    }
  }
}

docs {
  Students who have enrolled in this college's hostels — paginated roster,
  each row joined with student identity, hostel, room type, and mess plan
  (if any).

  Optional filters: hostel_id, room_type_id, status (default: no filter,
  pass "active" to see only currently-active enrollments), search (matches
  student full name/email/phone).

  Response `data` is an array; pagination info is in the top-level `meta`
  (page, limit, total, totalPages, hasNextPage, hasPreviousPage).
}

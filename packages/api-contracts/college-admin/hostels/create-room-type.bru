meta {
  name: Create Room Type
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/college-admin/hostels/{{hostelId}}/room-types
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "name": "3-Sharing (Non-AC)",
    "totalBeds": 60,
    "annualPlanPrice": 65000,
    "monthlyPlanPrice": 6000,
    "securityDeposit": 7000
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("roomTypeId", data.data.id);
    }
  }
}

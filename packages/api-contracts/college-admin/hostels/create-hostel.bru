meta {
  name: Create Hostel
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/college-admin/hostels
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Creates a hostel with optional nested room types, mess plans, and addon services.
  Response includes a `gallery` array built from the cover image and room-type photos.
}

body:json {
  {
    "name": "CV Raman Boys Residence Hall",
    "hostelType": "boys",
    "isOnCampus": true,
    "totalBeds": 250,
    "description": "Premium on-campus student residential facility.",
    "roomTypes": [
      {
        "name": "Double AC Sharing Room",
        "totalBeds": 120,
        "annualPlanPrice": 85000,
        "securityDeposit": 10000
      },
      {
        "name": "Single Luxury AC Room",
        "totalBeds": 50,
        "annualPlanPrice": 140000,
        "securityDeposit": 15000
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("hostelId", data.data.id);
    }
    if (data.data && data.data.roomTypes && data.data.roomTypes[0]) {
      bru.setEnvVar("roomTypeId", data.data.roomTypes[0].id);
    }
  }
}

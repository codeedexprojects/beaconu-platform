meta {
  name: Update Staff Member
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/staff/:id
  body: json
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "fullName": "Jane Doe",
    "email": "jane@college.edu",
    "phoneNumber": "+91 98765 43210",
    "collegeRoleId": "",
    "status": "inactive"
  }
}

docs {
  Partial update of a staff member. All fields optional, at least one
  expected. Requires staff.manage; cannot be used to modify your own
  staff record (403).

  fullName / email / phoneNumber — profile edit fields.
  collegeRoleId — must belong to the same college.
  status — active | inactive.

  Returns 409 if email is changed to one already used by another staff
  member at this college.
}

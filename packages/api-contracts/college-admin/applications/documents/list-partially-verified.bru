meta {
  name: List Partially Verified Documents
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/college-admin/applications/documents/partially-verified?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffAccessToken}}
}

params:query {
  page: 1
  limit: 20
  ~search: mzamil
}

docs {
  Paginated queue of submitted applications where at least one document has
  been approved or rejected, but not every document is approved yet. Once
  every document reaches "approved", the application drops out of this list
  (and the under-review list) entirely — there's no separate "fully
  verified" list in this pass.

  Requires staff_member auth, admissions.view. Response shape: `data: {
  applications: [...], meta: { total, page, limit, hasNext } } }`.
}

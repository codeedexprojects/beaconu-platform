meta {
  name: List Reschedule Requests
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/college-admin/interviews/reschedules
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffAccessToken}}
}

params:query {
  ~status: pending
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0] && data.data[0].id) {
      bru.setEnvVar("interviewRescheduleId", data.data[0].id);
    }
  }
}

docs {
  Lists every interview reschedule request at this college. `status`:
  "pending" | "approved" | "rejected".
}

meta {
  name: Update Interview Slot
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/interviews/slots/{{interviewSlotId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "venue": "Admin Block, Room 4"
  }
}

docs {
  Updates any subset of an interview slot's fields (mode, scheduled_date,
  start_time, end_time, duration_mins, campus_id, venue, interviewer_id).
  No max_capacity — every slot is a fixed 1-on-1 booking, not configurable.

  If scheduled_date or start_time is being changed, 400 ValidationError
  "Interview slots cannot be scheduled in the past" if the resulting
  scheduled_date + start_time combined is at or before the current time.

  409 ConflictError if changing `mode` to one that's currently disabled
  for this college — see Get Interview Settings / Update Interview
  Settings.

  404 "Campus not found" if `campus_id` is changed to one that doesn't
  belong to this college.
}

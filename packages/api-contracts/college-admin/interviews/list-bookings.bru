meta {
  name: List Interview Bookings
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/college-admin/interviews/bookings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffAccessToken}}
}

params:query {
  ~status: pending
  ~search:
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0]) {
      if (data.data[0].id) bru.setEnvVar("interviewBookingId", data.data[0].id);
      if (data.data[0].applicationId) bru.setEnvVar("interviewApplicationId", data.data[0].applicationId);
    }
  }
}

docs {
  Lists interview candidates at this college. `status`:
  - "pending" — candidates eligible for interview with no active booking
    yet (a computed, live list — nothing is stored for these rows; see
    plan doc Design Decision #6). Response items have no `id` (no
    InterviewBooking exists yet) — use `applicationId` for the next step.
  - "scheduled" | "completed" | "cancelled" — real InterviewBooking rows.

  `search` matches applicant name or application number.
}

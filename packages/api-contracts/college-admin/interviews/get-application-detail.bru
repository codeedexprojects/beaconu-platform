meta {
  name: Get Interview Candidate
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/college-admin/interviews/applications/{{interviewApplicationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffAccessToken}}
}

docs {
  Applicant context for the scheduling screen — works whether or not an
  InterviewBooking row exists yet. `booking` is null for a still-pending
  candidate, or the current booking (for pre-filling a reschedule form)
  otherwise.
}

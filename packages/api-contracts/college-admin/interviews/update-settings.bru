meta {
  name: Update Interview Settings
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/interviews/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "allow_gmeet": true,
    "allow_on_campus": false,
    "gmeet": {
      "heading": "Before Your Online Interview",
      "description": "Please review the following before joining on Google Meet.",
      "instructions": [
        "Test your mic and camera beforehand",
        "Join the call 5 minutes early",
        "Ensure a stable internet connection"
      ]
    },
    "on_campus": {
      "heading": "Before Your On-Campus Interview",
      "description": "Please review the following before visiting the campus.",
      "instructions": [
        "Bring a valid photo ID",
        "Report to the admin block front desk 10 minutes early"
      ]
    }
  }
}

docs {
  Partial update — every field optional, but at least one of
  allow_gmeet/allow_on_campus/gmeet/on_campus must be present (400
  ValidationError otherwise). Upserts: the first call for a college
  creates its InterviewSettings row implicitly.

  `allow_gmeet` / `allow_on_campus`: turning a mode off blocks Create/
  Update Interview Slot from using it going forward (409 ConflictError) —
  existing slots of that mode are untouched, still bookable/completable.

  `gmeet` / `on_campus`: SEPARATE heading/description/instructions blocks
  — online and offline interviews get different guidance. Each is its own
  partial object (heading/description/instructions all individually
  optional within it); `instructions` is a flat array of short strings
  (max 20), fully replaced (not merged) whenever included. Updating one
  block (e.g. `gmeet`) never touches the other (`on_campus`) — send both
  in the same call if you need to update both at once.
}

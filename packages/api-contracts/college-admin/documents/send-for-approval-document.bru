  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/documents/requests/{{documentRequestId}}/send-for-approval
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {}
}

docs {
  Moves a document request from "processing" to "awaiting_approval". Only
  valid while the request status is "processing".
}

meta {
  name: List Document Submission Requests (College Admin)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/college-admin/documents/submission-requests
  body: none
  auth: none
}

query {
  ~status: under_review
  ~student_id: {{studentId}}
  page: 1
  limit: 20
}

headers {
  Authorization: Bearer {{staffToken}}
}

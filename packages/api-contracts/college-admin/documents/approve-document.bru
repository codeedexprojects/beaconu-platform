meta {
  name: Approve Document Request (College Admin)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/documents/requests/{{documentRequestId}}/approve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{staffToken}}
}

body:json {
  {}
}

docs {
  Accepts a "submitted" document request, moving it straight to "approved".
  The intermediate "processing"/"awaiting_approval" steps no longer exist —
  it's a direct submitted -> accept/reject decision. Only once approved can
  the document be issued (uploading a file via the issue endpoint moves it
  straight to "issued").
}

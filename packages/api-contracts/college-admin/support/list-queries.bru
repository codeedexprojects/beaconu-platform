meta {
  name: List Queries (College)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/college-admin/support?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  status:
  search:
}

auth:bearer {
  token: {{staffToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.tickets && data.data.tickets[0]) {
      bru.setEnvVar("ticketId", data.data.tickets[0].id);
    }
  }
}

docs {
  Paginated list of every query submitted by students at this college,
  newest-updated first — each row includes studentName/studentEmail.
  Optional filters: status, search (subject/ticketNumber/student name).
}

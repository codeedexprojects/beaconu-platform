meta {
  name: List Seat Pools
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/college-admin/application-forms/{{admissionCycleId}}/seat-pools
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{staffToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0] && data.data[0].id) {
      bru.setEnvVar("seatPoolId", data.data[0].id);
    }
  }
}

docs {
  Lists seat pools for this application form. Each pool is a quota's
  total/open seats for this cycle, shared across the courses listed in
  `courses`. A quota may have multiple independent pools in the same cycle
  as long as their course sets don't overlap. Includes soft-deactivated
  pools (isActive: false) — the college-admin UI filters those out.
}

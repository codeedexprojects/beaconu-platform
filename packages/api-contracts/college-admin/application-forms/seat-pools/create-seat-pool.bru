meta {
  name: Create Seat Pool
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/college-admin/application-forms/{{admissionCycleId}}/seat-pools
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "college_quota_id": "{{quotaId}}",
    "total_seats": 50,
    "course_ids": ["{{courseId}}"]
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("seatPoolId", data.data.id);
    }
  }
}

docs {
  Creates a pooled seat allocation for a quota within this application form.
  `course_ids` must each be actively attached to this application form
  (see application-forms/courses) — otherwise 400. `open_seats` is
  initialized equal to `total_seats`.

  A quota can have multiple independent pools in the same cycle, as long as
  their course sets don't overlap — if any course_id already has active
  seats configured for this quota (exclusively or in another pool), this
  returns 409 listing which courses conflict.
}

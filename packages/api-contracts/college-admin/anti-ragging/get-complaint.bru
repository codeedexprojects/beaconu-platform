meta {
  name: Get Report Detail (College Admin)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/college-admin/anti-ragging-complaints/{{antiRaggingComplaintId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Includes student contact info (email/phone) for "contact student", full
  evidence attachments, individuals involved, and the full status timeline.
}

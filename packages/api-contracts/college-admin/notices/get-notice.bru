meta {
  name: Get Notice Detail
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/college-admin/notices/{{noticeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Full notice detail including requiredDocuments[] and attachments[] (the
  list endpoint omits these two fields to keep list rows lean).
}

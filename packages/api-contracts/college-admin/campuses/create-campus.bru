meta {
  name: Create Campus
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/college-admin/campuses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "name": "Main Campus",
    "address": "123 Campus Lane",
    "city": "Noida",
    "state": "Uttar Pradesh",
    "pinCode": "201301",
    "isMainCampus": true
  }
}

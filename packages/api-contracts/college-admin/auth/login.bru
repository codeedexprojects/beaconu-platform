meta {
  name: Staff Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/college-admin/auth/login
  body: json
  auth: none
}

body:json {
  {
    "collegeSlug": "{{collegeSlug}}",
    "email": "admin@vydehi.edu.in",
    "password": "Admin@123"
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.tokens && data.data.tokens.accessToken) {
      bru.setEnvVar("staffToken", data.data.tokens.accessToken);
    }
    if (data.data && data.data.user && data.data.user.collegeId) {
      bru.setEnvVar("collegeId", data.data.user.collegeId);
    }
  }
}

docs {
  Resolves the college purely from `collegeSlug` in the body — the API
  never reads a subdomain/Host header for this, so `baseUrl` should stay
  plain (e.g. http://localhost:4000), not a subdomain form. The
  email/password here must belong to a staff member seeded under that
  exact `collegeSlug` (packages/db/src/seed.ts collegeAdmins array) or
  login 401s. Sets `staffToken` + `collegeId` on success — every
  college-admin request in this collection authenticates with
  {{staffToken}}.
}

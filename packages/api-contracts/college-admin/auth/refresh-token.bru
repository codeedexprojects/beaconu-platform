meta {
  name: Refresh Token
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/college-admin/auth/refresh-token
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{staffRefreshToken}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("staffToken", data.data.accessToken);
    }
  }
}

docs {
  Refreshes the college-admin access token using a refresh token.
  Returns a new accessToken. Updates staffToken in env.
}

meta {
  name: Staff Forgot Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/college-admin/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "collegeSlug": "{{collegeSlug}}",
    "email": "admin@vydehi.edu.in"
  }
}

docs {
  Always returns 200 with the same message whether or not the account
  exists (no user enumeration). One reset email per account per 60s. The
  emailed link points at /{slug}/reset-password?token=... on the college
  admin portal and expires in 1 hour.
}

meta {
  name: Staff Reset Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/college-admin/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{passwordResetToken}}",
    "password": "NewPassword@123"
  }
}

docs {
  Consumes the single-use token from the reset (or staff-invite) email and
  signs the account out of all sessions. Paste the token from the email
  link into the `passwordResetToken` env var.
}

meta {
  name: Update Campus Ambassador
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/ambassadors/{{ambassadorId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

headers {
  Content-Type: application/json
}


meta {
  name: Create Community
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/college-admin/communities
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Campus Startup Circle",
    "description": "For students discussing startup ideas and events"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("communityId", data.data.id);
    }
  }
}

docs {
  Creates a community as the logged-in staff user.
  Requires college-admin login token (staffToken).
}

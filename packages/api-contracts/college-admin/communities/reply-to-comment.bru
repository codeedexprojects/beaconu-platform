meta {
  name: Reply To Comment
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/college-admin/communities/{{communityId}}/posts/{{communityPostId}}/comments/{{communityCommentId}}/replies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "content": "Thanks for your comment. Here is a follow-up."
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("communityReplyCommentId", data.data.id);
    }
  }
}

docs {
  Adds a reply to an existing comment.
  Set communityId, communityPostId, and communityCommentId env vars before calling.
}

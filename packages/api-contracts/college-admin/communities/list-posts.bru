meta {
  name: List Posts
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/college-admin/communities/{{communityId}}/posts?page=1&limit=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

headers {
  Content-Type: application/json
}

docs {
  Lists active posts of a community with pagination.
  Set communityId env var before calling.
}

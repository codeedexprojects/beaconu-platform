meta {
  name: Like Post
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/college-admin/communities/{{communityId}}/posts/{{communityPostId}}/like
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

headers {
  Content-Type: application/json
}

docs {
  Adds an upvote to a community post for the current user.
  Set communityId and communityPostId env vars before calling.
}

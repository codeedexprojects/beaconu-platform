meta {
  name: Attach Quota to Course
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/quotas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "collegeQuotaId": "{{quotaId}}",
    "appFeeReductionType": "flat",
    "appFeeReductionValue": 300,
    "tuitionFeeOverride": null
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("courseQuotaId", data.data.id);
    }
  }
}

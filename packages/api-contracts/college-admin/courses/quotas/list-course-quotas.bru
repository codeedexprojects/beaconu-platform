meta {
  name: List Course Quotas
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/quotas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0] && data.data[0].id) {
      bru.setEnvVar("courseQuotaId", data.data[0].id);
    }
  }
}

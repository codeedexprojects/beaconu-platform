meta {
  name: Lookup Program Types
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/college-admin/lookups/program-types
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Returns program types available for course creation.
  Used to populate program type dropdown during course setup.

  Requires: staff access token.
  Saves `programTypeId` from first result to env.
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data[0] && data.data[0].id) {
      bru.setEnvVar("programTypeId", data.data[0].id);
    }
  }
}

meta {
  name: Update Course
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "name": "Updated Course Name",
    "intakeCapacity": 150
  }
}

docs {
  Updates a course.
  Supports partial updates — only include fields to change.

  Requires: staff access token.
}

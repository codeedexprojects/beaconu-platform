meta {
  name: Tab - Exam Policy
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/tabs/exam_policy
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Fetches the `exam_policy` tab for a specific course.

  To update this tab, use:
  `tabs/tab-exam-policy-update.bru`
}

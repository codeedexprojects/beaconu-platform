meta {
  name: Tab - Fees
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/tabs/fees
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Fetches the `fees` tab for a specific course.

  To update this tab, use:
  `tabs/tab-fees-update.bru`
}

meta {
  name: Tab - Exam Policy (Update)
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/tabs/exam_policy
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}


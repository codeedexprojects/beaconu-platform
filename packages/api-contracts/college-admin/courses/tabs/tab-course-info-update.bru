meta {
  name: Tab - Course Info (Update)
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/tabs/course_info
  body: json
  auth: bearer
}

auth:bearer {

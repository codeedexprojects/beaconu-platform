meta {
  name: Tab - Library (Update)
  type: http
  seq: 22
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/tabs/library
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "data": {
      "libraryIds": ["{{libraryId}}"]
    }
  }
}

docs {
  Links the college's libraries to this course. Libraries are managed
  separately (see College Admin > Libraries CRUD) and are not embedded
  here — this tab just stores which library IDs apply to this course.
  The public Get Course Tab response resolves these IDs into full library
  objects at read time.
}

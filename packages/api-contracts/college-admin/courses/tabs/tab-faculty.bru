meta {
  name: Tab - Faculty
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/tabs/faculty
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Returns raw stored faculty data for a course (admin view).
  Stored as { list: [...] } — the public endpoint strips the wrapper and
  returns the array directly.

  To update, use: tab-faculty-update.bru
}

meta {
  name: Tab - Faculty (Update)
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/tabs/faculty
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}


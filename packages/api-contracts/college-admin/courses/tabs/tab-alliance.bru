meta {
  name: Tab - Alliance
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/tabs/alliance
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Fetches the `alliance` tab for a specific course.

  To update this tab, use:
  `tabs/tab-alliance-update.bru`
}

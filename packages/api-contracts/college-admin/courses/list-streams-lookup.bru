meta {
  name: Lookup Streams
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/college-admin/lookups/streams
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Returns streams available for course creation.
  Used to populate stream dropdown during course setup.

  Requires: staff access token.
  Saves `disciplineId` from the first stream discipline (if present).
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    const firstDiscipline =
      data?.data?.[0]?.disciplines?.[0] && data.data[0].disciplines[0].id
        ? data.data[0].disciplines[0].id
        : null;

    if (firstDiscipline) {
      bru.setEnvVar("disciplineId", firstDiscipline);
    }
  }
}

meta {
  name: Get Course Tab
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/college-admin/courses/{{courseId}}/tabs/{{courseTabName}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Returns a single tab's data for a course (admin view).

  Requires: staff access token with academics.view or academics.manage.

  Create-course assigns setup tabs under `tabs`:
    course_info, admission_policy, placements, fees, financial_aid,
    student_housing, exam_policy, faculty, review, library,
    clubs_associations, alliance, other_courses_offered, demo_graphics

  College-only static tabs remain under college profile sections:
    college_overview, student_code_of_conduct, happenings,
    institutions_across_world, commute

  Valid tab names for this endpoint:
  course_info, admission_policy, placements, fees, financial_aid,
  student_housing, exam_policy, faculty, review, library,
  clubs_associations, alliance, other_courses_offered, demo_graphics

  Response shape:
  {
    "tabName": "course_info",
    "data": { ... }
  }
}

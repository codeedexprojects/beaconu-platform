meta {
  name: Add Campus
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/college-admin/campuses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{collegeAdminToken}}
}

body:json {
  {
    "name": "Main Campus",
    "address": "123 Tech Campus Road",
    "city": "Bangalore",
    "state": "Karnataka",
    "pinCode": "560001",
    "isMainCampus": true
  }
}

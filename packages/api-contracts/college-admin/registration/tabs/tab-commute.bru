meta {
  name: Tab - Commute
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/college-admin/profile/sections/commute
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Fetches only the `commute` section.

  Read-only: built live from the Commute page data (commute_routes,
  commute_route_stops, commute_buses). The Profile page no longer edits
  commute, and any stored profile_sections.commute is ignored. Returns 404
  when the college has no active routes.

  Same `data` shape as Public > Colleges > Get College Section (commute).
}

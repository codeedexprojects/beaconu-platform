meta {
  name: Tab - Commute (Save)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}


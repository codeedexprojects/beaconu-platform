meta {
  name: Tab - College Overview (Save)
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}


meta {
  name: Tab - Student Code Of Conduct
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/college-admin/profile/sections/student_code_of_conduct
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Fetches only the `student_code_of_conduct` section.

  Response shape:
  {
    "sectionName": "student_code_of_conduct",
    "sectionId": "student_code_of_conduct",
    "sectionKey": "student_code_of_conduct",
    "data": {
      "id": "student_code_of_conduct",
      "tab": "student_code_of_conduct",
      "section_title": "General Rules of Discipline",
      "enabled": true,
      "rules": [
        {
          "number": 1,
          "rule": "Always carry the Identity Card with you while in college or the hospital."
        }
      ]
    }
  }
}

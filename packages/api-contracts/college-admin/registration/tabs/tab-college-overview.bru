meta {
  name: Tab - College Overview
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/college-admin/profile/sections/college_overview
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Fetches only the `college_overview` section.

  Response shape:
  {
    "sectionName": "college_overview",
    "sectionId": "college_overview",
    "sectionKey": "college_overview",
    "data": {
      "id": "college_overview",
      "name": "University of Hyderabad",
      "type": "Public",
      "about": "...",
      "enabled": true,
      "accolades": [],
      "university_details": [],
      "amenities": [],
      "inside_campus_facilities": [],
      "location": {
        "address": "",
        "latitude": null,
        "longitude": null,
        "map_link": ""
      },
      "nearby_access": [],
      "campus_ambassadors": [],
      "social": [],
      "campus_reels": [],
      "navigation_tabs": []
    }
  }
}

meta {
  name: Tab - Happenings (Save)
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/college-admin/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "profileSections": {
      "happenings": {
        "id": "happenings",
        "enabled": true,
        "title": "Happenings",
        "filters": {
          "title": "Filter Happenings",
          "subtitle": "Select categories to display",
          "categories": [
            "Certification",
            "Workshop",
            "Seminar",
            "Sports"
          ]
        },
        "happenings": [
          {
            "id": "happening_001",
            "category": "Certification",
            "date": "Oct 12, 2023",
            "title": "Professor Ratna awarded international certification in Quantum Research",
            "description": "The University of Cambridge has formally recognized Dr. Ratna's groundbreaking work.",
            "image": "",
            "link": "",
            "share_enabled": true
          },
          {
            "id": "happening_002",
            "category": "Workshop",
            "date": "Nov 04, 2023",
            "title": "Design Thinking bootcamp by industry mentors",
            "description": "A two-day hands-on workshop on innovation methods and rapid prototyping.",
            "image": "",
            "link": "https://example.edu/workshops/design-thinking",
            "share_enabled": true
          },
          {
            "id": "happening_003",
            "category": "Seminar",
            "date": "Dec 18, 2023",
            "title": "National seminar on AI in healthcare",
            "description": "Experts from academia and hospitals discussed real-world AI deployment in diagnostics.",
            "image": "",
            "link": "https://example.edu/events/ai-healthcare",
            "share_enabled": true
          },
          {
            "id": "happening_004",
            "category": "Sports",
            "date": "Jan 11, 2024",
            "title": "Inter-college athletics meet winners announced",
            "description": "The college won 6 medals including gold in 400m relay and long jump.",
            "image": "",
            "link": "",
            "share_enabled": false
          }
        ]
      }
    }
  }
}

docs {
  Saves happenings tab payload using PATCH /api/v1/college-admin/profile.

  Important:
  - This request writes `profileSections` as provided.
  - If your college already has other section data, merge current `profileSections`
    from GET /api/v1/college-admin/profile first, then replace only `happenings`.
}
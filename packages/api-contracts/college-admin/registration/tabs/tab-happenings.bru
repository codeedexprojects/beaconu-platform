meta {
  name: Tab - Happenings
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/college-admin/profile/sections/happenings?page=1&limit=10&search=certification&category=Certification
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

docs {
  Fetches only the `happenings` section.

  Query params:
  - page: 1-based page number, defaults to 1
  - limit: items per page, defaults to 10, max 100
  - search: case-insensitive search against title, description, category, and date
  - category: filter to a single category
  - categories: optional comma-separated or repeated category filter

  Response shape:
  {
    "sectionName": "happenings",
    "sectionId": "happenings",
    "sectionKey": "happenings",
    "data": {
      "id": "happenings",
      "title": "Happenings",
      "enabled": true,
      "filters": {
        "title": "Filter Happenings",
        "subtitle": "Select categories to display",
        "categories": [
          {
            "label": "Certification",
            "value": "certification",
            "selected": true
          }
        ]
      },
      "happenings": [
        {
          "id": "happening_001",
          "date": "2023-10-12",
          "link": "",
          "image": "",
          "title": "Professor Ratna awarded international certification in Quantum Research",
          "category": "Certification",
          "description": "...",
          "share_enabled": true
        }
      ],
      "pagination": {
        "current_page": 1,
        "per_page": 10,
        "total_items": 1,
        "total_pages": 1,
        "has_next_page": false,
        "has_previous_page": false
      }
    }
  }
}

meta {
  name: Add Course
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/college-admin/courses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{collegeAdminToken}}
}

body:json {
  {
    "name": "Bachelor of Technology in Computer Science",
    "code": "BTECH-CS",
    "disciplineId": "REPLACE_WITH_DISCIPLINE_UUID",
    "studyLevelId": "REPLACE_WITH_STUDY_LEVEL_UUID",
    "programTypeId": "REPLACE_WITH_PROGRAM_TYPE_UUID",
    "studyMode": "full_time",
    "intakeCapacity": 120,
    "duration": "4 Years",
    "eligibility": "10+2 with Physics, Chemistry, and Math"
  }
}

meta {
  name: Submit Registration
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/college-admin/profile/submit
  body: none
  auth: bearer
}

auth:bearer {
  token: {{collegeAdminToken}}
}

docs {
  Finalizes college registration after profile update.

  Expected registration setup before submit:
  - College details updated in profile (name, address, city, state, district, pinCode)
  - Registration tabs configured in profile:
    student_code_of_conduct, happenings, institutions_across_world, commute, college_overview

  Campus creation and course creation are managed in dedicated folders:
  - college-admin/campuses
  - college-admin/courses
}

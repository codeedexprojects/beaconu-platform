meta {
  name: Create Role
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/platform-admin/roles
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Admissions Auditor",
    "slug": "admissions_auditor",
    "permissions": [
      "platform:profiles:view",
      "platform:leads:view"
    ],
    "is_system_role": false
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("platformRoleId", data.data.id);
    }
  }
}

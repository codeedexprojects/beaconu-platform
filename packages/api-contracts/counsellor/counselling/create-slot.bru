meta {
  name: Create Slot
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/counsellor/availability/slots
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "available_date": "2026-06-14",
    "start_time": "10:00",
    "end_time": "10:45",
    "session_duration_mins": 45,
    "session_fee": 499
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    // Response is grouped by date: data.data[0].time_slots[0].id
    if (Array.isArray(data.data) && data.data.length > 0) {
      const firstDate = data.data[0];
      if (firstDate.time_slots && firstDate.time_slots.length > 0) {
        bru.setEnvVar("availabilityId", firstDate.time_slots[0].id);
      }
    }
  }
}

docs {
  Creates one or more availability slots for the logged-in counsellor.
  Requires: counsellor access token.
  
  ## Single slot
  {
    "available_date": "2026-06-12",
    "start_time": "10:00",
    "end_time": "10:45",
    "session_duration_mins": 45,
    "session_fee": 499
  }
  
  ## Bulk — multiple dates × multiple times
  {
    "available_dates": ["2026-06-12", "2026-06-13"],
    "time_slots": [
      { "start_time": "10:00", "end_time": "10:45" },
      { "start_time": "11:00", "end_time": "11:45" }
    ],
    "session_duration_mins": 45,
    "session_fee": 499
  }
  
  ## Response (always grouped by date)
  session_fee is the per-slot fee. Falls back to counsellor's default if omitted.

  ## Google Meet
  Slots do NOT get a Meet link at creation time (time_slots[].meeting_url /
  meeting_id are always null here). The Calendar event + Meet link is
  created when a student books this slot for a video_call session
  (counsellor + student added as attendees) — see Book Session.

  ## Validation
  - start_time must be before end_time (per slot)
  - available_date/available_dates + start_time must not be in the past
    (IST wall-clock) — 400 "Cannot create a slot in the past: <date> <time>"
    for any slot in the request, including bulk date × time combinations
  - duplicate (counsellor, date, time) slot — 409 "A slot with this date and
    time already exists"
}

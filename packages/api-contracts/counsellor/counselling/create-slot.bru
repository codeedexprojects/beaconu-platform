meta {
  name: Create Slot
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/counsellor/availability/slots
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "available_date": "2026-06-12",
    "start_time": "10:00",
    "end_time": "10:45",
    "session_duration_mins": 45,
    "session_fee": 499
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    // Response is grouped by date: data.data[0].time_slots[0].id
    if (Array.isArray(data.data) && data.data.length > 0) {
      const firstDate = data.data[0];
      if (firstDate.time_slots && firstDate.time_slots.length > 0) {
        bru.setEnvVar("availabilityId", firstDate.time_slots[0].id);
      }
    }
  }
}

docs {
  Creates one or more availability slots for the logged-in counsellor.
  Requires: counsellor access token.

  ## Single slot
  {
    "available_date": "2026-06-12",
    "start_time": "10:00",
    "end_time": "10:45",
    "session_duration_mins": 45,
    "session_fee": 499
  }

  ## Bulk — multiple dates × multiple times
  {
    "available_dates": ["2026-06-12", "2026-06-13"],
    "time_slots": [
      { "start_time": "10:00", "end_time": "10:45" },
      { "start_time": "11:00", "end_time": "11:45" }
    ],
    "session_duration_mins": 45,
    "session_fee": 499
  }

  ## Response (always grouped by date)
  session_fee is the per-slot fee. Falls back to counsellor's default if omitted.

  ## Google Meet
  If Google Meet is configured on the server
  (GOOGLE_MEET_SERVICE_ACCOUNT_EMAIL / _PRIVATE_KEY / GOOGLE_MEET_CALENDAR_ID),
  each created slot gets its own Google Calendar event with an
  auto-generated Meet link (counsellor added as attendee). The link is
  returned as time_slots[].meeting_url / meeting_id.

  When a student books this slot for a video_call session, they are added
  as an attendee to this same Calendar event — no new event is created.

  If Meet is not configured or the Calendar API call fails, the slot is
  still created with meeting_url/meeting_id as null.
}
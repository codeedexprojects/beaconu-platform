meta {
  name: Create Slot
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/counsellor/availability/slots
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "available_date": "2026-06-10",
    "start_time": "10:00",
    "end_time": "10:45",
    "session_duration_mins": 45
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("availabilityId", data.data.id);
    }
  }
}

docs {
  Creates a counselling availability slot for the logged-in counsellor.
  Requires: counsellor access token.
}
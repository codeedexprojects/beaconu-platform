meta {
  name: Cancel Session
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/counsellor/sessions/{{sessionId}}/cancel
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "cancellation_reason": "Unexpected emergency"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("sessionId");
  if (!sessionId) {
    throw new Error("sessionId is not set. Run List Sessions first.");
  }
}

docs {
  Cancels a counsellor-owned session.
  Requires: counsellor access token.

  Validation: must be cancelled at least 30 minutes before the session's
  scheduled start time (scheduled_date + start_time, IST). Returns 400
  "Sessions can only be cancelled at least 30 minutes before the scheduled
  start time" if attempted within that window or after the session has
  started.
}

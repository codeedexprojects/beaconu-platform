meta {
  name: List Sessions
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/counsellor/sessions
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (Array.isArray(data.data) && data.data.length > 0 && data.data[0].id) {
      bru.setEnvVar("sessionId", data.data[0].id);
    }
  }
}

docs {
  Lists counselling sessions for logged-in counsellor.
  Requires: counsellor access token.
}

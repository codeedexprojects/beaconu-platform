meta {
  name: List Sessions
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/counsellor/sessions?page=1&limit=20&date=&from_date=&to_date=&status=&search=
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
  date:
  from_date:
  to_date:
  status:
  search:
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (Array.isArray(data.data) && data.data.length > 0 && data.data[0].id) {
      bru.setEnvVar("sessionId", data.data[0].id);
    }
  }
}

docs {
  Lists counselling sessions for logged-in counsellor.
  Requires: counsellor access token.

  Query params:
  - page, limit: pagination (response includes `meta` with page, limit, total, totalPages, hasNextPage, hasPreviousPage)
  - date: filter sessions on a single date (YYYY-MM-DD)
  - from_date / to_date: filter sessions within a date range (YYYY-MM-DD)
  - status: booked | completed | cancelled
  - search: free-text search across booking reason, type, mode, status, student name/email
}

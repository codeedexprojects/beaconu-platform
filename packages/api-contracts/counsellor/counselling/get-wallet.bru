meta {
  name: Get Wallet
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/counsellor/wallet
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns counsellor wallet summary and recent transactions.
  Requires: counsellor access token.

  ## Response keys are snake_case
  - counsellor_id, total_earned, total_withdrawn, created_at, updated_at
  - transactions[].wallet_id, session_id, withdrawal_status, balance_after
}

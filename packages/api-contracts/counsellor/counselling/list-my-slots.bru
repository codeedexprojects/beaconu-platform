meta {
  name: List My Slots
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/counsellor/availability/slots
  body: none
  auth: none
}

params:query {
  from_date: 2026-06-01
  page: 1
  limit: 20
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Lists availability slots for logged-in counsellor.
  Requires: counsellor access token.
}

meta {
  name: Update Meeting
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/counsellor/sessions/{{sessionId}}/meeting
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "meeting_url": "https://meet.google.com/test-beaconu-room",
    "meeting_id": "test-beaconu-room"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("sessionId");
  if (!sessionId) {
    throw new Error("sessionId is not set. Run List Sessions first.");
  }
}

docs {
  Updates online meeting details for a counsellor session.
  Requires: counsellor access token.
}

meta {
  name: Get Profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/counsellor/profile
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.id) {
      bru.setEnvVar("counsellorId", data.data.id);
    }
  }
}

docs {
  Returns the profile of the currently authenticated counsellor.
  Requires: counsellor access token.

  Also saves counsellorId to env for use in super-admin counselling endpoints.
  Table: counsellors
}

meta {
  name: Forgot Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/counsellor/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "meera+1@counsellor.com"
  }
}

docs {
  Emails a 6-digit reset code to an active counsellor. No authentication.

  Always returns 200 with the same message whether or not the account
  exists (no user enumeration). One code per account per 60s. The code
  expires in 10 minutes; requesting a new one invalidates the old one.

  Table: counsellors
}

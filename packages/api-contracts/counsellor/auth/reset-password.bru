meta {
  name: Reset Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/counsellor/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "meera+1@counsellor.com",
    "otp": "123456",
    "password": "NewPassword@123",
    "confirm_password": "NewPassword@123"
  }
}

docs {
  Verifies the 6-digit code from the reset email and sets a new password.
  No authentication.

  The code is single-use, and 5 wrong guesses invalidate it (request a new
  one). On success every existing session for the counsellor is signed out.
  Returns 400 "Invalid or expired code" for a wrong/expired code or an
  unknown account.

  Table: counsellors
}

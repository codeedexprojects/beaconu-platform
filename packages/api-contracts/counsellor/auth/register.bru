meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/counsellor/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "Dr. Meera Kapoor",
    "email": "meera+1@counsellor.com",
    "password": "Password@123",
    "confirm_password": "Password@123",
    "phone_number": "+919990001111",
    "counsellor_type": "academic"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.user && data.data.user.id) {
      bru.setEnvVar("counsellorId", data.data.user.id);
    }
  }
}

docs {
  Registers a new counsellor account in pending verification state.
  No authentication required.
  
  counsellor_type: academic | mindcare
  Super admin must verify/activate the account before counsellor login.
  Register endpoint does not return access/refresh tokens.
  Saves counsellorId to env for use in super-admin counselling endpoints.
  
  Table: counsellors (separate from blink_users)
}

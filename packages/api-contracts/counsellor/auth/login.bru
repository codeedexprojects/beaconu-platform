meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/counsellor/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "meera+1@counsellor.com",
    "password": "Password@123",
    "counsellor_type": "academic",
    "fcm_token": ""
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("accessToken", data.data.accessToken);
    }
    if (data.data && data.data.user && data.data.user.id) {
      bru.setEnvVar("counsellorId", data.data.user.id);
    }
  }
}

docs {
  Authenticates a counsellor.
  No authentication required.
  
  Returns an access token (15 min) and sets a refreshToken cookie (90 days).
  JWT userType: counsellor

  Required `counsellor_type`: must be "academic" or "mindcare" and must
  match the counsellor's registered type. A mindcare counsellor cannot
  log in via the academic login and vice versa — returns 403 if mismatch.

  Optional `fcm_token`: if provided, stored on the new session's
  deviceInfo.fcmToken so push notifications (e.g. "New session booked")
  can be delivered to this device.

  Table: counsellors
}

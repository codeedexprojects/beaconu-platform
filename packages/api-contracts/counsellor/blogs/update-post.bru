meta {
  name: Update Post
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/counsellor/blogs/:id
  body: json
  auth: none
}

params:path {
  id: {{blogId}}
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "title": "Updated Title",
    "content": "Updated content..."
  }
}

docs {
  Update a pending post. Only posts with status "pending" can be edited.
  Counsellors can only edit their own posts.
}

meta {
  name: Get Own Post
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/counsellor/blogs/:id
  body: none
  auth: none
}

params:path {
  id: {{blogId}}
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

docs {
  Get a specific post by ID. Counsellors can only view their own posts.
  Returns full content including rejection reason if rejected.
}

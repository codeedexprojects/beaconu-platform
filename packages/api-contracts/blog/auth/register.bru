meta {
  name: Register Blog Author
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/blog/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "Riya Sharma",
    "email": "riya@example.com",
    "password": "password123",
    "confirm_password": "password123",
    "bio": "Tech writer and college experience blogger."
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("accessToken", data.data.accessToken);
    }
    if (data.data && data.data.user && data.data.user.id) {
      bru.setEnvVar("blogAuthorId", data.data.user.id);
    }
  }
}

docs {
  Register a new blog author account. No prior account needed.
  Returns accessToken + sets refreshToken cookie.

  Fields:
  - full_name: Display name (required)
  - email: Unique email (required)
  - password: Min 6 characters (required)
  - confirm_password: Must match password (required)
  - bio: Short author bio (optional, max 1000 chars)
}

meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/blog/auth/refresh
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("accessToken", data.data.accessToken);
    }
  }
}

docs {
  Refresh the blog author access token using the refreshToken cookie.
  Returns a new accessToken and rotates the refreshToken cookie.
}

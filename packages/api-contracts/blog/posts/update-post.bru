meta {
  name: Update Post
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/blog/posts/:id
  body: json
  auth: none
}

params:path {
  id: {{blogId}}
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "title": "Updated Title",
    "content": "Updated content..."
  }
}

vars:pre-request {
  blogId: 7489059b-0e14-4903-969c-e39c4a6da3ae
}

docs {
  Update a pending post. Only posts with status "pending" can be edited.
  Authors can only edit their own posts.
}

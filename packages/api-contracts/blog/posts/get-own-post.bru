meta {
  name: Get Own Post
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/blog/posts/:id
  body: none
  auth: none
}

params:path {
  id: {{blogId}}
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

vars:pre-request {
  blogId: 7489059b-0e14-4903-969c-e39c4a6da3ae
}

docs {
  Get a specific post by ID. Authors can only view their own posts.
  Returns full content including rejection reason if rejected.
}

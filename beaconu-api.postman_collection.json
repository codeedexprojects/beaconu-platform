                  ],
                  "path": [
                    "api",
                    "v1",
                    "blink",
                    "auth",
                    "register"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"agency_reg_number\": \"REG-12345\",\n  \"agency_name\": \"Global Education Agency\",\n  \"agency_email\": \"agency@example.com\",\n  \"agency_phone_no\": \"+919876543210\",\n  \"country\": \"India\",\n  \"password\": \"Password@123\",\n  \"confirm_password\": \"Password@123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "var res = pm.response.json();",
                      "if (res && res.data && res.data.accessToken) {",
                      "    pm.environment.set(\"accessToken\", res.data.accessToken);",
                      "}"
                    ]
                  }
                }
              ]
            },

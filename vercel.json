{
  "version": 2,
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "apps/api/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "apps/api/api/index.ts"
    },
    {
      "source": "/",
      "destination": "apps/web"
    },
    {
      "source": "/(.*)",
      "destination": "apps/web/$1"
    }
  ]
}

{
  "name": "beaconu-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@beaconu/api",
    "dev:web": "turbo dev --filter=@beaconu/web",
    "dev:college-web": "turbo dev --filter=@beaconu/college-web",
    "dev:college-admin": "turbo dev --filter=@beaconu/college-admin",
    "build": "turbo build",
    "build:api": "turbo build --filter=@beaconu/api",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @beaconu/db generate",
    "db:migrate": "pnpm --filter @beaconu/db migrate",
    "db:migrate:dev": "dotenv -e .env -- pnpm --filter @beaconu/db migrate:dev",
    "db:seed": "dotenv -e .env -- pnpm --filter @beaconu/db seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @beaconu/db studio",
    "db:push": "dotenv -e .env -- pnpm --filter @beaconu/db push"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

{
  "name": "beaconu-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@beaconu/api",
    "dev:web": "turbo dev --filter=@beaconu/web",
    "dev:college-web": "turbo dev --filter=@beaconu/college-web",
    "dev:college-admin": "turbo dev --filter=@beaconu/college-admin",
    "dev:super-admin": "turbo dev --filter=@beaconu/super-admin",
    "build": "turbo build",
    "build:api": "turbo build --filter=@beaconu/api",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @beaconu/db generate",
    "db:migrate": "pnpm --filter @beaconu/db migrate",
    "db:migrate:dev": "pnpm --filter @beaconu/db migrate:dev",
    "db:seed": "dotenv -e .env -- pnpm --filter @beaconu/db seed",
    "db:studio": "pnpm --filter @beaconu/db studio",
    "db:push": "pnpm --filter @beaconu/db push",
    "db:admin": "dotenv -e .env -- pnpm --filter @beaconu/api exec tsx ../../scripts/create-super-admin.ts",
    "prepare": "husky",
    "postinstall": "pnpm db:generate"
  },

  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^25.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "turbo": "^2.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
